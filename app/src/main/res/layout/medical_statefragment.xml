<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:animateLayoutChanges="true"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    tools:context=".fragment.navstrepercontent.MedicalStateFragment">

    <androidx.core.widget.NestedScrollView
        android:id="@+id/layout"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toTopOf="@+id/layout_btn"
        >

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:padding="3dp">
            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/textinput_Hight"
                style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                android:layout_width="match_parent"
                android:layout_height="60dp"
                android:layout_margin="15dp"
                android:background="@drawable/bg_edittext"
                android:elevation="1dp"
                android:hint="@string/hight"
                android:paddingTop="2dp"
                app:boxBackgroundMode="none"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/et_Hight"
                    android:layout_width="match_parent"
                    android:layout_height="55dp"
                    android:layout_gravity="center_horizontal"
                    android:fontFamily="@font/avenirltstd_roman"
                    android:gravity="start"
                    android:imeOptions="actionNext"
                    android:importantForAutofill="no"
                    android:inputType="number"
                    android:textColor="@color/black"
                    android:textSize="12sp" />

            </com.google.android.material.textfield.TextInputLayout>
            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/textinput_Weight"
                style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                android:layout_width="match_parent"
                android:layout_height="60dp"
                android:layout_margin="15dp"
                android:background="@drawable/bg_edittext"
                android:elevation="1dp"
                android:hint="@string/weight"
                android:paddingTop="2dp"
                app:boxBackgroundMode="none"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/textinput_Hight">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/et_Weight"
                    android:layout_width="match_parent"
                    android:layout_height="55dp"
                    android:layout_gravity="center_horizontal"
                    android:fontFamily="@font/avenirltstd_roman"
                    android:gravity="start"
                    android:imeOptions="actionNext"
                    android:importantForAutofill="no"
                    android:inputType="number"
                    android:textColor="@color/black"
                    android:textSize="12sp" />

            </com.google.android.material.textfield.TextInputLayout>
            <androidx.appcompat.widget.AppCompatButton
                    android:id="@+id/btn_layout_BloodGroup"
                    android:layout_width="0dp"
                    android:layout_height="0dp"
                    android:background="@android:color/transparent"
                    app:layout_constraintEnd_toEndOf="@+id/layout_BloodGroup"
                    app:layout_constraintStart_toStartOf="@+id/layout_BloodGroup"
                    app:layout_constraintTop_toTopOf="@+id/layout_BloodGroup"
                    app:layout_constraintBottom_toBottomOf="@+id/layout_BloodGroup"
            />
            <androidx.appcompat.widget.AppCompatButton
                    android:id="@+id/btn_layout_MedicalAllergies"
                    android:layout_width="0dp"
                    android:layout_height="0dp"
                    android:background="@android:color/transparent"
                    app:layout_constraintEnd_toEndOf="@+id/layout_MedicalAllergies"
                    app:layout_constraintStart_toStartOf="@+id/layout_MedicalAllergies"
                    app:layout_constraintTop_toTopOf="@+id/layout_MedicalAllergies"
                    app:layout_constraintBottom_toBottomOf="@+id/layout_MedicalAllergies"
            />

            <androidx.appcompat.widget.AppCompatButton
                    android:id="@+id/btn_layout_FoodAllergies"
                    android:layout_width="0dp"
                    android:layout_height="0dp"
                    android:background="@android:color/transparent"
                    app:layout_constraintEnd_toEndOf="@+id/layout_FoodAllergies"
                    app:layout_constraintStart_toStartOf="@+id/layout_FoodAllergies"
                    app:layout_constraintTop_toTopOf="@+id/layout_FoodAllergies"
                    app:layout_constraintBottom_toBottomOf="@+id/layout_FoodAllergies"
            />

            <androidx.constraintlayout.widget.ConstraintLayout
                android:id="@+id/layout_BloodGroup"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="15dp"
                android:layout_marginTop="12dp"
                android:layout_marginEnd="15dp"
                android:layout_marginBottom="10dp"
                android:background="@drawable/bg_edittext"
                android:elevation="1dp"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/textinput_Weight">

                <androidx.appcompat.widget.AppCompatImageView
                    android:id="@+id/iv_arrowdownArea"
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:layout_gravity="center_horizontal"
                    android:layout_marginEnd="12dp"
                    android:layout_marginBottom="12dp"
                    android:gravity="start"
                    android:src="@drawable/ic_arrowdwon"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintEnd_toEndOf="parent" />

                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/textinput_BloodGroup"
                    style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                    android:layout_width="match_parent"
                    android:layout_height="55dp"
                    android:layout_marginEnd="25dp"
                    android:layout_marginBottom="5dp"
                    android:hint="@string/blood_group"
                    android:paddingTop="2dp"
                    app:boxBackgroundColor="@color/white"
                    app:boxBackgroundMode="none"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/et_BloodGroup"
                        android:layout_width="match_parent"
                        android:layout_height="55dp"
                        android:layout_gravity="center_horizontal"
                        android:fontFamily="@font/avenirltstd_roman"
                        android:padding="5dp"
                        android:inputType="text"
                        android:importantForAutofill="no"
                        android:imeOptions="actionNext"
                        android:enabled="false"
                        android:textColor="@color/black"
                        android:textSize="12sp" />

                </com.google.android.material.textfield.TextInputLayout>

            </androidx.constraintlayout.widget.ConstraintLayout>
            <androidx.constraintlayout.widget.ConstraintLayout
                android:id="@+id/layout_MedicalAllergies"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="15dp"
                android:layout_marginTop="12dp"
                android:layout_marginEnd="15dp"
                android:layout_marginBottom="10dp"
                android:background="@drawable/bg_edittext"
                android:elevation="1dp"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/layout_BloodGroup">

                <androidx.appcompat.widget.AppCompatImageView
                    android:id="@+id/iv_arrowdownMedicalAllergies"
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:layout_gravity="center_horizontal"
                    android:layout_marginEnd="12dp"
                    android:layout_marginBottom="12dp"
                    android:gravity="start"
                    android:src="@drawable/ic_arrowdwon"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintEnd_toEndOf="parent" />

                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/textinput_MedicalAllergies"
                    style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                    android:layout_width="match_parent"
                    android:layout_height="55dp"
                    android:layout_marginEnd="25dp"
                    android:layout_marginBottom="5dp"
                    android:hint="@string/medical_allergies"
                    android:paddingTop="2dp"
                    app:boxBackgroundColor="@color/white"
                    app:boxBackgroundMode="none"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/et_MedicalAllergies"
                        android:layout_width="match_parent"
                        android:layout_height="55dp"
                        android:layout_gravity="center_horizontal"
                        android:fontFamily="@font/avenirltstd_roman"
                        android:padding="5dp"
                        android:inputType="text"
                        android:importantForAutofill="no"
                        android:imeOptions="actionNext"
                        android:enabled="false"
                        android:textColor="@color/black"
                        android:textSize="12sp" />

                </com.google.android.material.textfield.TextInputLayout>

            </androidx.constraintlayout.widget.ConstraintLayout>
            <androidx.constraintlayout.widget.ConstraintLayout
                android:id="@+id/layout_FoodAllergies"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="15dp"
                android:layout_marginTop="12dp"
                android:layout_marginEnd="15dp"
                android:layout_marginBottom="10dp"
                android:background="@drawable/bg_edittext"
                android:elevation="1dp"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/layout_MedicalAllergies">

                <androidx.appcompat.widget.AppCompatImageView
                    android:id="@+id/iv_arrowdownFoodAllergies"
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:layout_gravity="center_horizontal"
                    android:layout_marginEnd="12dp"
                    android:layout_marginBottom="12dp"
                    android:gravity="start"
                    android:src="@drawable/ic_arrowdwon"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintEnd_toEndOf="parent" />

                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/textinput_FoodAllergies"
                    style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                    android:layout_width="match_parent"
                    android:layout_height="55dp"
                    android:layout_marginEnd="25dp"
                    android:layout_marginBottom="5dp"
                    android:hint="@string/food_allergies"
                    android:paddingTop="2dp"
                    app:boxBackgroundColor="@color/white"
                    app:boxBackgroundMode="none"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/et_FoodAllergies"
                        android:layout_width="match_parent"
                        android:layout_height="55dp"
                        android:layout_gravity="center_horizontal"
                        android:fontFamily="@font/avenirltstd_roman"
                        android:padding="5dp"
                        android:inputType="text"
                        android:importantForAutofill="no"
                        android:imeOptions="actionNext"
                        android:enabled="false"
                        android:textColor="@color/black"
                        android:textSize="12sp" />

                </com.google.android.material.textfield.TextInputLayout>

            </androidx.constraintlayout.widget.ConstraintLayout>
            <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/textinput_OtherAllergies"
                    style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                    android:layout_width="match_parent"
                    android:layout_height="60dp"
                    android:layout_margin="15dp"
                    android:background="@drawable/bg_edittext"
                    android:elevation="1dp"
                    android:hint="@string/other_allergies"
                    android:paddingTop="2dp"
                    app:boxBackgroundMode="none"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@+id/layout_FoodAllergies">

                <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/et_OtherAllergies"
                        android:layout_width="match_parent"
                        android:layout_height="60dp"
                        android:layout_gravity="center_horizontal"
                        android:fontFamily="@font/avenirltstd_roman"
                        android:gravity="start"
                        android:padding="5dp"
                        android:imeOptions="actionNext"
                        android:importantForAutofill="no"
                        android:inputType="text"
                        android:textColor="@color/black"
                        android:textSize="12sp" />

            </com.google.android.material.textfield.TextInputLayout>

            <TextView
                    android:id="@+id/PressureMMGG_tv"
                    android:layout_width="wrap_content"
                    android:layout_height="match_parent"
                    app:layout_constraintStart_toStartOf="parent"
                    android:layout_marginStart="15dp"
                    android:layout_marginTop="@dimen/_10sdp"
                    app:layout_constraintTop_toBottomOf="@+id/textinput_OtherAllergies"
                    android:textSize="15sp"
                    android:text="@string/pressure_mm_gg"/>

            <androidx.constraintlayout.widget.ConstraintLayout
                    android:id="@+id/layout_textinput_PressureMMGG"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:background="@drawable/bg_edittext"
                    android:layout_marginStart="15dp"
                    android:layout_marginEnd="15dp"
                    android:layout_marginTop="@dimen/_3sdp"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@+id/PressureMMGG_tv"
                >
                <com.google.android.material.textfield.TextInputLayout
                        android:id="@+id/textinput_PressureMMGG"
                        style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                        android:layout_width="@dimen/_100sdp"
                        android:layout_height="60dp"
                        android:elevation="1dp"
                        android:paddingTop="2dp"
                        android:hint="90"
                        android:visibility="visible"
                        app:boxBackgroundMode="none"
                        app:layout_constraintEnd_toEndOf="parent"
                       app:layout_constraintTop_toTopOf="parent">

                    <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/et_PressureMMGG"
                            android:layout_width="match_parent"
                            android:layout_height="55dp"
                            android:layout_gravity="center_horizontal"
                            android:fontFamily="@font/avenirltstd_roman"
                            android:gravity="center"
                            android:maxLength="3"
                            android:imeOptions="actionDone"
                            android:importantForAutofill="no"
                            android:inputType="number"
                            android:textColor="@color/black"
                            android:textSize="12sp" />

                </com.google.android.material.textfield.TextInputLayout>
                <ImageView
                        android:id="@+id/im_pressgure"
                        android:layout_width="35dp"
                        android:layout_height="35dp"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintTop_toTopOf="parent"
                        app:layout_constraintBottom_toBottomOf="parent"
                        android:visibility="visible"
                        app:tint="@color/dark_gray"
                        android:src="@drawable/slash"
                        />
                <com.google.android.material.textfield.TextInputLayout
                        android:id="@+id/last_textinput_PressureMMGG"
                        style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                        android:layout_width="@dimen/_100sdp"
                        android:layout_height="60dp"
                        android:elevation="1dp"
                        android:hint="120"
                        android:visibility="visible"
                        android:paddingTop="2dp"
                        app:boxBackgroundMode="none"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toTopOf="parent">

                    <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/last_et_PressureMMGG"
                            android:layout_width="match_parent"
                            android:layout_height="55dp"
                            android:layout_gravity="center_horizontal"
                            android:fontFamily="@font/avenirltstd_roman"
                            android:gravity="center"
                            android:maxLength="3"
                            android:imeOptions="actionDone"
                            android:importantForAutofill="no"
                            android:inputType="number"
                            android:textColor="@color/black"
                            android:textSize="12sp" />

                </com.google.android.material.textfield.TextInputLayout>
                <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/et_pressure"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:hint="120/080"
                        android:inputType="text"
                        android:visibility="gone"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintTop_toTopOf="parent"
                        app:layout_constraintStart_toStartOf="parent"
                        style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                        android:maxLength="7"
                        android:textSize="16sp" />


            </androidx.constraintlayout.widget.ConstraintLayout>
            <TextView
                    android:id="@+id/SugarLevelMGDL_tv"
                    android:layout_width="wrap_content"
                    android:layout_height="match_parent"
                    app:layout_constraintStart_toStartOf="parent"
                    android:layout_marginStart="15dp"
                    android:layout_marginTop="@dimen/_10sdp"
                    app:layout_constraintTop_toBottomOf="@+id/layout_textinput_PressureMMGG"
                    android:textSize="15sp"
                    android:text="@string/sugar_level_mg_dl"/>

            <androidx.constraintlayout.widget.ConstraintLayout
                    android:id="@+id/layout_textinput_SugarLevelMGDL"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:background="@drawable/bg_edittext"
                    android:layout_marginStart="15dp"
                    android:layout_marginEnd="15dp"
                    android:layout_marginTop="@dimen/_3sdp"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@+id/SugarLevelMGDL_tv"
                    >
                <com.google.android.material.textfield.TextInputLayout
                        android:id="@+id/first_textinput_SugarLevelMGDL"
                        style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                        android:layout_width="@dimen/_100sdp"
                        android:layout_height="60dp"
                        android:elevation="1dp"
                        android:hint="100"
                        android:paddingTop="2dp"
                        app:boxBackgroundMode="none"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toTopOf="parent">

                    <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/et_SugarLevelMGDL"
                            android:layout_width="match_parent"
                            android:layout_height="60dp"
                            android:layout_gravity="center_horizontal"
                            android:fontFamily="@font/avenirltstd_roman"
                            android:gravity="center"
                            android:maxLength="3"
                            android:importantForAutofill="no"
                            android:imeOptions="actionDone"
                            android:inputType="text"
                            android:textColor="@color/black"
                            android:textSize="12sp" />

                </com.google.android.material.textfield.TextInputLayout>
                <ImageView
                        android:id="@+id/im_suggar"
                        android:layout_width="35dp"
                        android:layout_height="35dp"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintTop_toTopOf="parent"
                        app:layout_constraintBottom_toBottomOf="parent"
                        android:visibility="visible"
                        app:tint="@color/dark_gray"
                        android:src="@drawable/slash"
                        />

                <com.google.android.material.textfield.TextInputLayout
                        android:id="@+id/textinput_SugarLevelMGDL"
                        style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                        android:layout_width="@dimen/_100sdp"
                        android:layout_height="60dp"
                        android:elevation="1dp"
                        android:hint="80"
                        android:paddingTop="2dp"
                        app:boxBackgroundMode="none"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintTop_toTopOf="parent">

                    <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/last_et_SugarLevelMGDL"
                            android:layout_width="match_parent"
                            android:layout_height="60dp"
                            android:layout_gravity="center_horizontal"
                            android:fontFamily="@font/avenirltstd_roman"
                            android:gravity="center"
                            android:maxLength="3"
                            android:importantForAutofill="no"
                            android:imeOptions="actionDone"
                            android:inputType="text"
                            android:textColor="@color/black"
                            android:textSize="12sp" />

                </com.google.android.material.textfield.TextInputLayout>
            </androidx.constraintlayout.widget.ConstraintLayout>


            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/textinput_Prescriptions"
                style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                android:layout_width="match_parent"
                android:layout_height="60dp"
                android:layout_margin="15dp"
                android:background="@drawable/bg_edittext"
                android:elevation="1dp"
                android:hint="@string/prescriptions"
                android:paddingTop="2dp"
                app:boxBackgroundMode="none"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/layout_textinput_SugarLevelMGDL">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/et_Prescriptions"
                    android:layout_width="match_parent"
                    android:layout_height="60dp"
                    android:layout_gravity="center_horizontal"
                    android:fontFamily="@font/avenirltstd_roman"
                    android:gravity="start"
                    android:padding="5dp"
                    android:importantForAutofill="no"
                    android:imeOptions="actionNext"
                    android:inputType="text"
                    android:textColor="@color/black"
                    android:textSize="12sp" />

            </com.google.android.material.textfield.TextInputLayout>
            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/textinput_CurrentMedication"
                style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                android:layout_width="match_parent"
                android:layout_height="60dp"
                android:layout_margin="15dp"
                android:background="@drawable/bg_edittext"
                android:elevation="1dp"
                android:hint="@string/current_medication"
                android:paddingTop="2dp"
                app:boxBackgroundMode="none"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/textinput_Prescriptions">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/et_CurrentMedication"
                    android:layout_width="match_parent"
                    android:layout_height="60dp"
                    android:layout_gravity="center_horizontal"
                    android:fontFamily="@font/avenirltstd_roman"
                    android:gravity="start"
                    android:inputType="text"
                    android:padding="5dp"
                    android:imeOptions="actionNext"
                    android:importantForAutofill="no"
                    android:textColor="@color/black"
                    android:textSize="12sp" />

            </com.google.android.material.textfield.TextInputLayout>
            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/textinput_PastMedication"
                style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                android:layout_width="match_parent"
                android:layout_height="60dp"
                android:layout_margin="15dp"
                android:background="@drawable/bg_edittext"
                android:elevation="1dp"
                android:hint="@string/past_medication"
                android:paddingTop="2dp"
                app:boxBackgroundMode="none"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/textinput_CurrentMedication">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/et_PastMedication"
                    android:layout_width="match_parent"
                    android:layout_height="60dp"
                    android:layout_gravity="center_horizontal"
                    android:fontFamily="@font/avenirltstd_roman"
                    android:gravity="start"
                    android:inputType="text"
                    android:padding="5dp"
                    android:importantForAutofill="no"
                    android:imeOptions="actionNext"
                    android:textColor="@color/black"
                    android:textSize="12sp" />

            </com.google.android.material.textfield.TextInputLayout>
            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/textinput_Injuries"
                style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                android:layout_width="match_parent"
                android:layout_height="60dp"
                android:layout_margin="15dp"
                android:background="@drawable/bg_edittext"
                android:elevation="1dp"
                android:hint="@string/injuries"
                android:paddingTop="2dp"
                app:boxBackgroundMode="none"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
