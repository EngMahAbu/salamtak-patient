                app:layout_constraintTop_toBottomOf="@+id/tv_BookingDetails">

            <androidx.constraintlayout.widget.ConstraintLayout
                    android:id="@+id/layout_Subspecialization"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:padding="2dp"
                    app:layout_constraintTop_toTopOf="parent">

                <androidx.constraintlayout.widget.ConstraintLayout
                        android:id="@+id/layout_BookingDateTime"
                        android:layout_width="37dp"
                        android:layout_height="37dp"
                        android:layout_marginTop="10dp"
                        android:layout_marginStart="10dp"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toBottomOf="@+id/layout_Service">

                    <com.google.android.material.imageview.ShapeableImageView
                            android:id="@+id/iv_sub_specialization"
                            android:layout_width="21dp"
                            android:layout_height="21dp"
                            android:adjustViewBounds="true"
                            android:src="@drawable/new_calendar"
                            app:layout_constraintBottom_toBottomOf="parent"
                            app:layout_constraintEnd_toEndOf="parent"
                            app:layout_constraintStart_toStartOf="parent"
                            app:layout_constraintTop_toTopOf="parent" />
                </androidx.constraintlayout.widget.ConstraintLayout>

                <androidx.appcompat.widget.AppCompatTextView
                        android:id="@+id/tv_BookingDateTime"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="5dp"
                        android:fontFamily="@font/avenirltstd_roman"
                        android:gravity="start"
                        android:padding="2dp"
                        android:visibility="gone"
                        android:text="@string/booking_date_time"
                        android:textColor="@color/gray"
                        android:textSize="15sp"
                        app:layout_constraintStart_toEndOf="@+id/layout_BookingDateTime"
                        app:layout_constraintTop_toTopOf="@+id/layout_BookingDateTime" />

                <androidx.appcompat.widget.AppCompatTextView
                        android:id="@+id/tv_date"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="5dp"
                        android:fontFamily="@font/avenirltstd_black"
                        android:gravity="start"
                        android:padding="2dp"
                        android:textColor="@color/black"
                        android:textSize="12sp"
                        app:layout_constraintStart_toEndOf="@+id/layout_BookingDateTime"
                        app:layout_constraintBottom_toBottomOf="@+id/layout_BookingDateTime"
                        app:layout_constraintTop_toBottomOf="@+id/tv_BookingDateTime" />

                <androidx.constraintlayout.widget.ConstraintLayout
                        android:id="@+id/layout_Service"
                        android:layout_width="37dp"
                        android:layout_height="37dp"
                        android:layout_marginTop="10dp"
                        android:layout_marginStart="10dp"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toTopOf="parent">

                    <com.google.android.material.imageview.ShapeableImageView
                            android:id="@+id/iv_Service"
                            android:layout_width="21dp"
                            android:layout_height="21dp"
                            android:adjustViewBounds="true"
                            android:src="@drawable/ic_watingtime"
                            android:tint="@color/text_doctor_card_color"
                            app:layout_constraintBottom_toBottomOf="parent"
                            app:layout_constraintEnd_toEndOf="parent"
                            app:layout_constraintStart_toStartOf="parent"
                            app:layout_constraintTop_toTopOf="parent" />
                </androidx.constraintlayout.widget.ConstraintLayout>

                <androidx.appcompat.widget.AppCompatTextView
                        android:id="@+id/tv_Service"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="5dp"
                        android:fontFamily="@font/avenirltstd_roman"
                        android:gravity="start"
                        android:padding="2dp"
                        android:visibility="gone"
                        android:text="@string/service"
                        android:textColor="@color/gray"
                        android:textSize="15sp"
                        app:layout_constraintStart_toEndOf="@+id/layout_Service"
                        app:layout_constraintTop_toTopOf="@+id/layout_Service" />

                <androidx.appcompat.widget.AppCompatTextView
                        android:id="@+id/Service"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="5dp"
                        android:fontFamily="@font/avenirltstd_black"
                        android:gravity="start"
                        android:padding="2dp"
                        android:textColor="@color/black"
                        android:textSize="12sp"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintStart_toEndOf="@+id/layout_Service"
                        app:layout_constraintBottom_toBottomOf="@+id/layout_Service"
                        app:layout_constraintTop_toBottomOf="@+id/tv_Service" />


                <androidx.constraintlayout.widget.ConstraintLayout
                        android:id="@+id/layout_Location"
                        android:layout_width="37dp"
                        android:layout_height="37dp"
                        android:layout_marginTop="10dp"
                        android:layout_marginStart="10dp"
                        android:visibility="gone"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toBottomOf="@+id/layout_BookingDateTime">

                    <com.google.android.material.imageview.ShapeableImageView
                            android:id="@+id/iv_Location"
                            android:layout_width="21dp"
                            android:layout_height="21dp"
                            android:adjustViewBounds="true"
                            android:src="@drawable/svg_location"
                            app:layout_constraintBottom_toBottomOf="parent"
                            app:layout_constraintEnd_toEndOf="parent"
                            app:layout_constraintStart_toStartOf="parent"
                            app:layout_constraintTop_toTopOf="parent" />
                </androidx.constraintlayout.widget.ConstraintLayout>

                <androidx.appcompat.widget.AppCompatTextView
                        android:id="@+id/tv_Location"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="5dp"
                        android:fontFamily="@font/avenirltstd_black"
                        android:gravity="start"
                        android:padding="2dp"
                        android:textColor="@color/black"
                        android:textSize="12sp"
                        app:layout_constraintStart_toEndOf="@+id/layout_Location"
                        app:layout_constraintBottom_toBottomOf="@+id/layout_Location"
                        app:layout_constraintTop_toBottomOf="@+id/layout_BookingDateTime" />


                <androidx.constraintlayout.widget.ConstraintLayout
                        android:id="@+id/layout_fees"
                        android:layout_width="37dp"
                        android:layout_height="37dp"
                        android:layout_marginTop="10dp"
                        android:layout_marginStart="10dp"
                        android:visibility="gone"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toBottomOf="@+id/layout_Location">

                    <com.google.android.material.imageview.ShapeableImageView
                            android:id="@+id/iv_Fees"
                            android:layout_width="21dp"
                            android:layout_height="21dp"
                            android:adjustViewBounds="true"
                            android:src="@drawable/svg_money"
                            app:layout_constraintBottom_toBottomOf="parent"
                            app:layout_constraintEnd_toEndOf="parent"
                            app:layout_constraintStart_toStartOf="parent"
                            app:layout_constraintTop_toTopOf="parent" />
                </androidx.constraintlayout.widget.ConstraintLayout>

                <androidx.appcompat.widget.AppCompatTextView
                        android:id="@+id/tv_fees"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="5dp"
                        android:fontFamily="@font/avenirltstd_black"
                        android:gravity="start"
                        android:layout_marginTop="@dimen/_8sdp"
                        android:padding="2dp"
                        android:textColor="@color/black"
                        android:textSize="12sp"
                        app:layout_constraintStart_toEndOf="@+id/layout_fees"
                        app:layout_constraintBottom_toBottomOf="@+id/layout_fees"
                        app:layout_constraintTop_toBottomOf="@+id/layout_Location" />


            </androidx.constraintlayout.widget.ConstraintLayout>


        </androidx.constraintlayout.widget.ConstraintLayout>





    <androidx.appcompat.widget.AppCompatEditText
            android:id="@+id/textinput_Age"
            android:padding="8dp"
            android:scrollbars="vertical"
            android:background="@drawable/bg_edittext"
            android:layout_width="0dp"
            android:layout_height="50dp"
            android:layout_margin="15dp"
            android:autofillHints=""
            android:maxLength="3"
            android:elevation="1dp"
            android:textSize="16sp"
            android:importantForAutofill="no"
            android:imeOptions="actionNext"
            android:hint="@string/ages"
            android:gravity="start|center_vertical"
            android:inputType="number"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/layout_details"
            />
        <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/btn_layout_Choose_Specialization"
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:background="@android:color/transparent"
                app:layout_constraintEnd_toEndOf="@+id/layout_Choose_Specialization"
                app:layout_constraintStart_toStartOf="@+id/layout_Choose_Specialization"
                app:layout_constraintTop_toTopOf="@+id/layout_Choose_Specialization"
                app:layout_constraintBottom_toBottomOf="@+id/layout_Choose_Specialization"
                />
    <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/layout_Choose_Specialization"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="15dp"
            android:layout_marginTop="12dp"
            android:layout_marginEnd="15dp"
            android:background="@drawable/bg_edittext"
            android:elevation="1dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/textinput_Age"
            >

        <androidx.appcompat.widget.AppCompatImageView
                android:id="@+id/iv_arrowdown"
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:layout_gravity="center_horizontal"
                android:layout_marginEnd="12dp"
                android:layout_marginBottom="12dp"
                android:gravity="start"
                android:src="@drawable/ic_arrowdwon"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"/>

        <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/textinput_Specialization"
                style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                android:layout_width="match_parent"
                android:layout_height="55dp"
                android:layout_marginEnd="25dp"
                android:layout_marginBottom="5dp"
                android:hint="@string/choose_symptoms"
                android:paddingTop="2dp"
                app:boxBackgroundColor="@color/white"
                app:boxBackgroundMode="none"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent">

            <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/et_Specialization"
                    android:layout_width="match_parent"
                    android:layout_height="55dp"
                    android:layout_gravity="center_horizontal"
                    android:fontFamily="@font/avenirltstd_roman"
                    android:inputType="text"
                    android:enabled="false"
                    android:textColor="@color/black"
                    android:textSize="16sp"/>

        </com.google.android.material.textfield.TextInputLayout>


    </androidx.constraintlayout.widget.ConstraintLayout>
        <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/textinput_PressureMMGG"
                style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                android:layout_width="match_parent"
