<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout
        xmlns:android="http://schemas.android.com/apk/res/android"
        xmlns:tools="http://schemas.android.com/tools"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/bg_color_gray"
        xmlns:app="http://schemas.android.com/apk/res-auto"
        tools:context=".fragment.booking.ConfirmedFragment">

    <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent">

        <androidx.core.widget.NestedScrollView
                android:id="@+id/layout"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:fillViewport="true"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintBottom_toTopOf="@+id/btn_my_schedule">

            <androidx.constraintlayout.widget.ConstraintLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:paddingBottom="24dp">

                <!-- Top Confirmation Card -->
                <androidx.constraintlayout.widget.ConstraintLayout
                        android:id="@+id/layout_Booking"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="15dp"
                        android:layout_marginEnd="15dp"
                        android:layout_marginTop="20dp"
                        android:padding="20dp"
                        android:background="@drawable/more_cards_background"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintTop_toTopOf="parent">

                    <ImageView
                            android:id="@+id/layout_sucess"
                            android:layout_width="90dp"
                            android:layout_height="90dp"
                            android:src="@drawable/sucess"
                            app:layout_constraintTop_toTopOf="parent"
                            app:layout_constraintStart_toStartOf="parent"
                            app:layout_constraintEnd_toEndOf="parent" />

                    <androidx.appcompat.widget.AppCompatTextView
                            android:id="@+id/tv_confirm"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:fontFamily="@font/sf_pro_display_semibold"
                            android:gravity="center"
                            android:layout_marginTop="16dp"
                            android:text="@string/thank_you"
                            android:textColor="@color/black"
                            android:textSize="20sp"
                            app:layout_constraintStart_toStartOf="parent"
                            app:layout_constraintEnd_toEndOf="parent"
                            app:layout_constraintTop_toBottomOf="@+id/layout_sucess"/>

                    <androidx.appcompat.widget.AppCompatTextView
                            android:id="@+id/tv_thanks"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:fontFamily="@font/sf_pro_display_semibold"
                            android:gravity="center"
                            android:layout_marginTop="8dp"
                            android:text="@string/booking_successful"
                            android:textColor="@color/text_doctor_card_color"
                            android:textSize="15sp"
                            app:layout_constraintWidth_percent=".85"
                            app:layout_constraintStart_toStartOf="parent"
                            app:layout_constraintEnd_toEndOf="parent"
                            app:layout_constraintTop_toBottomOf="@+id/tv_confirm"/>

                </androidx.constraintlayout.widget.ConstraintLayout>

                <!-- Booking Details Card -->
                <androidx.constraintlayout.widget.ConstraintLayout
                        android:id="@+id/layout_details"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="15dp"
                        android:layout_marginEnd="15dp"
                        android:layout_marginTop="16dp"
                        android:background="@drawable/more_cards_background"
                        android:padding="16dp"
                        app:layout_constraintTop_toBottomOf="@+id/layout_Booking"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintEnd_toEndOf="parent">

                    <androidx.appcompat.widget.AppCompatTextView
                            android:id="@+id/tv_BookingDetails"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:fontFamily="@font/sf_pro_display_semibold"
                            android:text="@string/BookingDetails"
                            android:textColor="@color/black"
                            android:textSize="18sp"
                            app:layout_constraintStart_toStartOf="parent"
                            app:layout_constraintTop_toTopOf="parent" />

                    <!-- Service / Examination Type -->
                    <com.google.android.material.imageview.ShapeableImageView
                            android:id="@+id/iv_Service"
                            android:layout_width="21dp"
                            android:layout_height="21dp"
                            android:layout_marginTop="16dp"
                            android:adjustViewBounds="true"
                            android:src="@drawable/ic_inclink_book"
                            app:layout_constraintStart_toStartOf="parent"
                            app:layout_constraintTop_toBottomOf="@+id/tv_BookingDetails" />

                    <androidx.appcompat.widget.AppCompatTextView
                            android:id="@+id/Service"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="12dp"
                            android:fontFamily="@font/avenirltstd_roman"
                            android:gravity="start"
                            android:textColor="#8088A4"
                            android:textSize="14sp"
                            tools:text="In-Clinic Booking"
                            app:layout_constraintBottom_toBottomOf="@+id/iv_Service"
                            app:layout_constraintEnd_toEndOf="parent"
                            app:layout_constraintStart_toEndOf="@+id/iv_Service"
                            app:layout_constraintTop_toTopOf="@+id/iv_Service" />

                    <!-- Date and Time -->
                    <com.google.android.material.imageview.ShapeableImageView
                            android:id="@+id/iv_sub_specialization"
                            android:layout_width="21dp"
                            android:layout_height="21dp"
                            android:layout_marginTop="16dp"
                            android:adjustViewBounds="true"
                            android:src="@drawable/new_calendar"
                            app:layout_constraintStart_toStartOf="parent"
                            app:layout_constraintTop_toBottomOf="@+id/iv_Service" />

                    <androidx.appcompat.widget.AppCompatTextView
                            android:id="@+id/tv_date"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="12dp"
                            android:fontFamily="@font/avenirltstd_roman"
                            android:gravity="start"
                            android:textColor="#8088A4"
                            android:textSize="14sp"
                            tools:text="01 Nov, 2026 - 9:30 AM"
                            app:layout_constraintBottom_toBottomOf="@+id/iv_sub_specialization"
                            app:layout_constraintEnd_toEndOf="parent"
                            app:layout_constraintStart_toEndOf="@+id/iv_sub_specialization"
                            app:layout_constraintTop_toTopOf="@+id/iv_sub_specialization" />

                    <!-- Fees -->
                    <com.google.android.material.imageview.ShapeableImageView
                            android:id="@+id/iv_Fees"
                            android:layout_width="21dp"
                            android:layout_height="21dp"
                            android:layout_marginTop="16dp"
                            android:adjustViewBounds="true"
                            android:src="@drawable/money"
                            app:layout_constraintStart_toStartOf="parent"
                            app:layout_constraintTop_toBottomOf="@+id/iv_sub_specialization" />

                    <androidx.appcompat.widget.AppCompatTextView
                            android:id="@+id/tv_fees"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="12dp"
                            android:fontFamily="@font/avenirltstd_roman"
                            android:gravity="start"
                            android:textColor="#8088A4"
                            android:textSize="14sp"
                            tools:text="444 EGP"
                            app:layout_constraintBottom_toBottomOf="@+id/iv_Fees"
                            app:layout_constraintEnd_toEndOf="parent"
                            app:layout_constraintStart_toEndOf="@+id/iv_Fees"
                            app:layout_constraintTop_toTopOf="@+id/iv_Fees" />

                    <!-- Location -->
                    <com.google.android.material.imageview.ShapeableImageView
                            android:id="@+id/iv_Location"
                            android:layout_width="21dp"
                            android:layout_height="21dp"
                            android:layout_marginTop="16dp"
                            android:adjustViewBounds="true"
                            android:src="@drawable/svg_location"
                            app:layout_constraintStart_toStartOf="parent"
                            app:layout_constraintTop_toBottomOf="@+id/iv_Fees" />

                    <androidx.appcompat.widget.AppCompatTextView
                            android:id="@+id/tv_Location"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="12dp"
                            android:fontFamily="@font/avenirltstd_roman"
                            android:gravity="start"
                            android:textColor="#8088A4"
                            android:textSize="14sp"
                            tools:text="/, Apartment Appartment No"
                            app:layout_constraintBottom_toBottomOf="@+id/iv_Location"
                            app:layout_constraintEnd_toEndOf="parent"
                            app:layout_constraintStart_toEndOf="@+id/iv_Location"
                            app:layout_constraintTop_toTopOf="@+id/iv_Location" />

                    <!-- Queue Tracking Row -->
                    <androidx.constraintlayout.widget.ConstraintLayout
                            android:id="@+id/layout_QueueTracking"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="16dp"
                            android:background="?attr/selectableItemBackground"
                            android:clickable="true"
                            android:focusable="true"
                            android:paddingTop="6dp"
                            android:paddingBottom="6dp"
                            app:layout_constraintTop_toBottomOf="@+id/iv_Location"
                            app:layout_constraintStart_toStartOf="parent"
                            app:layout_constraintEnd_toEndOf="parent">

                        <FrameLayout
                                android:id="@+id/fl_clock_bg"
                                android:layout_width="28dp"
                                android:layout_height="28dp"
                                android:background="@drawable/bg_segment_container"
                                app:layout_constraintStart_toStartOf="parent"
                                app:layout_constraintTop_toTopOf="parent"
                                app:layout_constraintBottom_toBottomOf="parent">

                            <ImageView
                                    android:id="@+id/iv_QueueClock"
                                    android:layout_width="16dp"
                                    android:layout_height="16dp"
                                    android:layout_gravity="center"
                                    android:src="@drawable/ic_clock_grey" />
                        </FrameLayout>

                        <androidx.appcompat.widget.AppCompatTextView
                                android:id="@+id/tv_QueueTracking"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="12dp"
                                android:fontFamily="@font/sf_pro_display_semibold"
                                android:gravity="start"
                                android:text="@string/queue_tracking"
                                android:textColor="#8088A4"
                                android:textSize="15sp"
                                app:layout_constraintBottom_toBottomOf="parent"
                                app:layout_constraintEnd_toStartOf="@+id/iv_queue_arrow"
                                app:layout_constraintStart_toEndOf="@+id/fl_clock_bg"
                                app:layout_constraintTop_toTopOf="parent" />

                        <ImageView
                                android:id="@+id/iv_queue_arrow"
                                android:layout_width="18dp"
                                android:layout_height="18dp"
                                android:src="@drawable/svg_arrow_right"
                                app:layout_constraintBottom_toBottomOf="parent"
                                app:layout_constraintEnd_toEndOf="parent"
                                app:layout_constraintTop_toTopOf="parent" />

                    </androidx.constraintlayout.widget.ConstraintLayout>

                </androidx.constraintlayout.widget.ConstraintLayout>

                <!-- Information Section Title -->
                <androidx.appcompat.widget.AppCompatTextView
                        android:id="@+id/tv_fill_info"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="15dp"
                        android:layout_marginTop="22dp"
                        android:fontFamily="@font/sf_pro_display_semibold"
                        android:text="@string/please_fill_information"
                        android:textColor="@color/black"
                        android:textSize="16sp"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toBottomOf="@+id/layout_details" />

                <!-- Age Input -->
                <androidx.appcompat.widget.AppCompatEditText
                        android:id="@+id/textinput_Age"
                        android:layout_width="0dp"
                        android:layout_height="50dp"
                        android:layout_marginStart="15dp"
                        android:layout_marginTop="14dp"
                        android:layout_marginEnd="15dp"
                        android:background="@drawable/bg_edittext"
                        android:elevation="1dp"
                        android:gravity="start|center_vertical"
                        android:hint="@string/ages"
                        android:imeOptions="actionNext"
                        android:inputType="number"
                        android:maxLength="3"
                        android:padding="8dp"
                        android:textSize="16sp"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toBottomOf="@+id/tv_fill_info" />

                <!-- Describe Symptoms Dropdown -->
                <androidx.constraintlayout.widget.ConstraintLayout
                        android:id="@+id/layout_Choose_Specialization"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="15dp"
                        android:layout_marginTop="14dp"
                        android:layout_marginEnd="15dp"
                        android:background="@drawable/bg_edittext"
                        android:elevation="1dp"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toBottomOf="@+id/textinput_Age">

                    <androidx.appcompat.widget.AppCompatImageView
                            android:id="@+id/iv_arrowdown"
                            android:layout_width="20dp"
                            android:layout_height="20dp"
                            android:layout_marginEnd="12dp"
                            android:src="@drawable/ic_arrowdwon"
                            app:layout_constraintBottom_toBottomOf="parent"
                            app:layout_constraintEnd_toEndOf="parent"
                            app:layout_constraintTop_toTopOf="parent" />

                    <com.google.android.material.textfield.TextInputLayout
                            android:id="@+id/textinput_Specialization"
                            style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                            android:layout_width="match_parent"
                            android:layout_height="55dp"
                            android:layout_marginEnd="25dp"
                            android:hint="@string/choose_symptoms"
                            app:boxBackgroundColor="@color/white"
                            app:boxBackgroundMode="none"
                            app:layout_constraintBottom_toBottomOf="parent"
                            app:layout_constraintEnd_toEndOf="parent"
                            app:layout_constraintStart_toStartOf="parent"
                            app:layout_constraintTop_toTopOf="parent">

                        <com.google.android.material.textfield.TextInputEditText
                                android:id="@+id/et_Specialization"
                                android:layout_width="match_parent"
                                android:layout_height="55dp"
                                android:enabled="false"
                                android:fontFamily="@font/avenirltstd_roman"
                                android:inputType="text"
                                android:textColor="@color/black"
                                android:textSize="16sp" />

                    </com.google.android.material.textfield.TextInputLayout>

                </androidx.constraintlayout.widget.ConstraintLayout>

                <androidx.appcompat.widget.AppCompatButton
                        android:id="@+id/btn_layout_Choose_Specialization"
                        android:layout_width="0dp"
                        android:layout_height="0dp"
                        android:background="@android:color/transparent"
                        app:layout_constraintBottom_toBottomOf="@+id/layout_Choose_Specialization"
                        app:layout_constraintEnd_toEndOf="@+id/layout_Choose_Specialization"
                        app:layout_constraintStart_toStartOf="@+id/layout_Choose_Specialization"
                        app:layout_constraintTop_toTopOf="@+id/layout_Choose_Specialization" />

                <!-- Chronic Diseases Section -->
                <androidx.appcompat.widget.AppCompatTextView
                        android:id="@+id/tv_chronic_diseases_title"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="15dp"
                        android:layout_marginTop="16dp"
                        android:fontFamily="@font/sf_pro_display_semibold"
                        android:text="@string/chronic_diseases"
                        android:textColor="@color/black"
                        android:textSize="15sp"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toBottomOf="@+id/layout_Choose_Specialization" />

                <LinearLayout
                        android:id="@+id/layout_segment_chronic"
                        android:layout_width="match_parent"
                        android:layout_height="44dp"
                        android:layout_marginStart="15dp"
                        android:layout_marginTop="8dp"
                        android:layout_marginEnd="15dp"
                        android:background="@drawable/bg_segment_container"
                        android:orientation="horizontal"
                        android:padding="2dp"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toBottomOf="@+id/tv_chronic_diseases_title">

                    <TextView
                            android:id="@+id/tv_chronic_no"
                            android:layout_width="0dp"
                            android:layout_height="match_parent"
                            android:layout_weight="1"
                            android:background="@drawable/bg_segment_selected"
                            android:fontFamily="@font/sf_pro_display_semibold"
                            android:gravity="center"
                            android:text="@string/no"
                            android:textColor="@color/black" />

                    <TextView
                            android:id="@+id/tv_chronic_yes"
                            android:layout_width="0dp"
                            android:layout_height="match_parent"
                            android:layout_weight="1"
                            android:background="@android:color/transparent"
                            android:fontFamily="@font/sf_pro_display_semibold"
                            android:gravity="center"
                            android:text="@string/yes"
                            android:textColor="@color/gray" />
                </LinearLayout>

                <com.google.android.material.textfield.TextInputLayout
                        android:id="@+id/textinput_chronic_diseases"
                        style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                        android:layout_width="match_parent"
                        android:layout_height="60dp"
                        android:layout_marginStart="15dp"
                        android:layout_marginTop="10dp"
                        android:layout_marginEnd="15dp"
                        android:background="@drawable/bg_edittext"
                        android:elevation="1dp"
                        android:hint="@string/please_specify"
                        android:paddingTop="2dp"
                        android:visibility="gone"
                        app:boxBackgroundMode="none"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toBottomOf="@+id/layout_segment_chronic">

                    <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/et_Question"
                            android:layout_width="match_parent"
                            android:layout_height="60dp"
                            android:fontFamily="@font/avenirltstd_roman"
                            android:gravity="start|center_vertical"
                            android:imeOptions="actionNext"
                            android:inputType="text"
                            android:textColor="@color/black"
                            android:textSize="15sp" />

                </com.google.android.material.textfield.TextInputLayout>

                <!-- Previous Surgery Section -->
                <androidx.appcompat.widget.AppCompatTextView
                        android:id="@+id/tv_prev_surgery_title"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="15dp"
                        android:layout_marginTop="16dp"
                        android:fontFamily="@font/sf_pro_display_semibold"
                        android:text="@string/prevSurgery"
                        android:textColor="@color/black"
                        android:textSize="15sp"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toBottomOf="@+id/textinput_chronic_diseases" />

                <LinearLayout
                        android:id="@+id/layout_segment_surgery"
                        android:layout_width="match_parent"
                        android:layout_height="44dp"
                        android:layout_marginStart="15dp"
                        android:layout_marginTop="8dp"
                        android:layout_marginEnd="15dp"
                        android:background="@drawable/bg_segment_container"
                        android:orientation="horizontal"
                        android:padding="2dp"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toBottomOf="@+id/tv_prev_surgery_title">

                    <TextView
                            android:id="@+id/tv_surgery_no"
                            android:layout_width="0dp"
                            android:layout_height="match_parent"
                            android:layout_weight="1"
                            android:background="@drawable/bg_segment_selected"
                            android:fontFamily="@font/sf_pro_display_semibold"
                            android:gravity="center"
                            android:text="@string/no"
                            android:textColor="@color/black" />

                    <TextView
                            android:id="@+id/tv_surgery_yes"
                            android:layout_width="0dp"
                            android:layout_height="match_parent"
                            android:layout_weight="1"
                            android:background="@android:color/transparent"
                            android:fontFamily="@font/sf_pro_display_semibold"
                            android:gravity="center"
                            android:text="@string/yes"
                            android:textColor="@color/gray" />
                </LinearLayout>

                <com.google.android.material.textfield.TextInputLayout
                        android:id="@+id/textinput_prevSurgery"
                        style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                        android:layout_width="match_parent"
                        android:layout_height="60dp"
                        android:layout_marginStart="15dp"
                        android:layout_marginTop="10dp"
                        android:layout_marginEnd="15dp"
                        android:background="@drawable/bg_edittext"
                        android:elevation="1dp"
                        android:hint="@string/please_specify"
                        android:paddingTop="2dp"
                        android:visibility="gone"
                        app:boxBackgroundMode="none"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toBottomOf="@+id/layout_segment_surgery">

                    <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/et_prevSurgery"
                            android:layout_width="match_parent"
                            android:layout_height="60dp"
                            android:fontFamily="@font/avenirltstd_roman"
                            android:gravity="start|center_vertical"
                            android:imeOptions="actionNext"
                            android:inputType="text"
                            android:textColor="@color/black"
                            android:textSize="15sp" />

                </com.google.android.material.textfield.TextInputLayout>

                <!-- More Details -->
                <androidx.appcompat.widget.AppCompatEditText
                        android:id="@+id/textinput_comment"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="15dp"
                        android:layout_marginTop="16dp"
                        android:layout_marginEnd="15dp"
                        android:layout_marginBottom="24dp"
                        android:background="@drawable/bg_edittext"
                        android:elevation="1dp"
                        android:gravity="start|top"
                        android:hint="@string/more_details"
                        android:imeOptions="actionDone"
                        android:inputType="textMultiLine"
                        android:minLines="4"
                        android:padding="12dp"
                        android:textSize="15sp"
                        app:layout_constraintBottom_toBottomOf="parent"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toBottomOf="@+id/textinput_prevSurgery" />

            </androidx.constraintlayout.widget.ConstraintLayout>
        </androidx.core.widget.NestedScrollView>

        <!-- Bottom Action Button: My Bookings -->
        <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/btn_my_schedule"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="20dp"
                android:layout_marginEnd="20dp"
                android:layout_marginTop="12dp"
                android:layout_marginBottom="16dp"
                android:background="@drawable/bg_chooselang_button"
                android:fontFamily="@font/sf_pro_display_semibold"
                android:textAllCaps="false"
                android:text="@string/my_schedule"
                android:textColor="@color/white"
                android:textSize="16sp"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintBottom_toBottomOf="parent" />

    </androidx.constraintlayout.widget.ConstraintLayout>

    <include
            android:id="@+id/layoutBottomsheetpersistant"
            layout="@layout/layout_bottomsheet_syemtoms"
            android:visibility="visible" />

</androidx.coordinatorlayout.widget.CoordinatorLayout>
