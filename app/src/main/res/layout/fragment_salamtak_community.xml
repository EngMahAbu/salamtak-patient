<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        tools:context=".fragment.home.SalamtakCommunityFragment">

    <Toolbar
        android:id="@+id/toolbar1"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintTop_toTopOf="parent"
        >

        <ImageView
            android:id="@+id/ic_back"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:src="@drawable/ic_back"
            />
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Salamtak Community"
            android:textSize="22sp"
            android:textColor="@color/black"
            android:layout_marginStart="32dp"
            android:textStyle="bold"
            />

    </Toolbar>

        <com.google.android.material.imageview.ShapeableImageView
            android:id="@+id/image"
            android:layout_width="match_parent"
            android:layout_height="200dp"
            android:src="@drawable/salamtak_community"
            android:scaleType="centerCrop"
            android:layout_marginTop="22dp"
            android:layout_marginStart="14dp"
            android:layout_marginEnd="14dp"
            app:layout_constraintTop_toBottomOf="@id/toolbar1"
            app:shapeAppearanceOverlay="@style/ShapeAppearance.Material3.MediumComponent"/>


    <TextView
        android:id="@+id/text_community_name"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/full_name"
        android:fontFamily="@font/inter_semibold"
        android:textColor="@color/color_64748B"
        android:textSize="14sp"
        app:layout_constraintTop_toBottomOf="@id/image"
        app:layout_constraintStart_toStartOf="@id/image"
        android:paddingTop="12dp"/>

    <EditText
        android:id="@+id/etCommunityName"
        android:layout_width="0dp"
        android:layout_height="50dp"
        android:layout_marginTop="7dp"
        android:fontFamily="@font/inter_regular"
        android:textSize="11sp"
        android:paddingStart="10dp"
        app:layout_constraintTop_toBottomOf="@id/text_community_name"
        app:layout_constraintStart_toStartOf="@id/image"
        app:layout_constraintEnd_toEndOf="@id/image"
        android:background="@drawable/bg_edittext_box"
        android:hint="@string/full_name_in_english_first_middle_last"
        android:inputType="text"/>

    <!-- Mobile Number -->
    <TextView
        android:id="@+id/text_mobile_number"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Mobile Number"
        android:fontFamily="@font/inter_semibold"
        android:textColor="@color/color_64748B"
        app:layout_constraintTop_toBottomOf="@id/etCommunityName"
        app:layout_constraintStart_toStartOf="@id/image"
        android:textSize="14sp"
        android:paddingTop="8dp"/>

    <EditText
        android:id="@+id/etMobileNumber"
        android:layout_width="0dp"
        android:layout_height="50dp"
        android:layout_marginTop="10dp"
        android:fontFamily="@font/inter_regular"
        app:layout_constraintTop_toBottomOf="@id/text_mobile_number"
        app:layout_constraintStart_toStartOf="@id/image"
        app:layout_constraintEnd_toEndOf="@id/image"
        android:textSize="11sp"
        android:paddingStart="12dp"
        android:background="@drawable/bg_edittext_box"
        android:hint="Mobile Number: (+2)"
        android:inputType="phone"/>

        <RadioGroup
            android:id="@+id/radioGroupOptions"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            app:layout_constraintTop_toBottomOf="@id/etMobileNumber"
            android:padding="16dp">

            <RadioButton
                android:id="@+id/rbBloodBag"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Blood Bag" />

            <EditText
                android:id="@+id/etDiabetes"
                android:layout_width="match_parent"
                android:layout_height="50dp"
                android:hint="Blood Bag details"
                android:visibility="gone"
                android:enabled="false"
                android:textSize="11sp"
                android:drawableEnd="@drawable/ic_down_arrow"
                android:background="@drawable/bg_edittext_box"
                android:padding="10dp"/>

            <LinearLayout
                android:id="@+id/layoutAge"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:visibility="gone">

                <Button
                    android:id="@+id/btnMinus"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:text="-" />

                <TextView
                    android:id="@+id/tvAge"
                    android:layout_width="60dp"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:text="18"
                    android:textSize="20sp"
                    android:textStyle="bold" />

                <Button
                    android:id="@+id/btnPlus"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:text="+" />

            </LinearLayout>

            <com.google.android.material.button.MaterialButtonToggleGroup
                android:id="@+id/toggleGender"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:singleSelection="true">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnMale"
                    style="@style/Widget.Material3.Button.OutlinedButton"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:textSize="18sp"
                    android:textColor="@color/black"
                    android:text="Male" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnFemale"
                    style="@style/Widget.Material3.Button.OutlinedButton"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:textColor="@color/black"
                    android:textSize="18sp"

                    android:text="Female" />

            </com.google.android.material.button.MaterialButtonToggleGroup>

            <RadioButton
                android:id="@+id/rbMedicalEquipment"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Medical Equipment" />

            <EditText
                android:id="@+id/etPressure"
                android:layout_width="match_parent"
                android:layout_height="50dp"
                android:hint="Select Equipment Type"
                android:visibility="gone"
                android:textSize="11sp"
                android:enabled="false"
                android:background="@drawable/bg_edittext_box"
                android:drawableEnd="@drawable/ic_down_arrow"
                android:padding="10dp"/>

            <RadioButton
                android:id="@+id/rbLocation"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Location Or Space" />

            <EditText
                android:id="@+id/etHeart"
                android:layout_width="match_parent"
                android:layout_height="50dp"
                android:hint="Location details"
                android:visibility="gone"
                android:textSize="11sp"
                android:enabled="false"
                android:background="@drawable/bg_edittext_box"
                android:drawableEnd="@drawable/ic_down_arrow"
                android:padding="10dp"/>

            <RadioButton
                android:id="@+id/rbVolunteer"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Volunteer Effort" />

            <EditText
                android:id="@+id/etOther"
                android:layout_width="match_parent"
                android:layout_height="50dp"
                android:hint="Volunteer details"
                android:textSize="11sp"
                android:visibility="gone"
                android:enabled="false"
                android:background="@drawable/bg_edittext_box"
                android:drawableEnd="@drawable/ic_down_arrow"
                android:padding="10dp"/>

        </RadioGroup>

        <EditText
            android:id="@+id/details"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:fontFamily="@font/inter_regular"
            app:layout_constraintTop_toBottomOf="@id/radioGroupOptions"
            app:layout_constraintStart_toStartOf="@id/image"
            app:layout_constraintEnd_toEndOf="@id/image"
            android:textSize="11sp"
            android:padding="15dp"
            android:background="@drawable/bg_edittext_box"
            android:hint="Enter Details"
            android:minLines="6"
            android:gravity="start"
            />

        <androidx.appcompat.widget.AppCompatButton
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            app:layout_constraintTop_toBottomOf="@id/details"
            app:layout_constraintStart_toStartOf="@id/image"
            app:layout_constraintEnd_toEndOf="@id/image"
            android:paddingVertical="15dp"
            android:gravity="center"
            android:backgroundTint="#1F3D89"
            android:text="Send"
            android:textColor="@color/white"
            android:textStyle="bold"
            android:background="@drawable/bg_chooselang_button"
            android:layout_marginTop="12dp"
            />


    </androidx.constraintlayout.widget.ConstraintLayout>

</ScrollView>