<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
        xmlns:app="http://schemas.android.com/apk/res-auto"
        xmlns:tools="http://schemas.android.com/tools">

    <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

        <androidx.cardview.widget.CardView
                android:id="@+id/cardview"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardCornerRadius="10dp"
                app:cardUseCompatPadding="true"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent">

            <androidx.constraintlayout.widget.ConstraintLayout
                    android:id="@+id/layput_services"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:padding="5dp">

                <androidx.constraintlayout.widget.ConstraintLayout
                        android:id="@+id/layout_doctorsDetail"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_margin="10dp"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toTopOf="parent">

                    <com.google.android.material.imageview.ShapeableImageView
                            android:id="@+id/iv_doctorProfile"
                            android:layout_width="70dp"
                            android:layout_height="65dp"
                            android:src="@drawable/ic_docspecialization"
                            app:layout_constraintStart_toStartOf="parent"
                            app:layout_constraintTop_toTopOf="parent" />

                    <androidx.appcompat.widget.AppCompatTextView
                            android:id="@+id/tv_doctorName"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="10dp"
                            android:layout_marginStart="10dp"
                            android:fontFamily="@font/avenirltstd_black"
                            android:gravity="start"
                            android:text="osama"
                            android:textColor="@color/black"
                            android:textSize="15sp"
                            app:layout_constraintStart_toEndOf="@+id/iv_doctorProfile"
                            app:layout_constraintTop_toTopOf="@+id/iv_doctorProfile"
                            app:layout_constraintEnd_toEndOf="parent" />

                    <androidx.appcompat.widget.AppCompatTextView
                            android:id="@+id/tv_city"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="10dp"
                            android:layout_marginTop="10dp"
                            android:fontFamily="@font/avenirltstd_roman"
                            android:gravity="start"
                            android:drawablePadding="@dimen/_5sdp"
                            android:drawableStart="@drawable/ic_location"
                            android:text=""
                            android:textColor="@color/black"
                            android:textSize="12sp"
                            app:layout_constraintStart_toEndOf="@+id/iv_doctorProfile"
                            app:layout_constraintEnd_toEndOf="parent"
                            android:layout_marginEnd="@dimen/_10sdp"
                            app:layout_constraintTop_toBottomOf="@+id/tv_doctorName" />
                    <com.google.android.material.imageview.ShapeableImageView
                            android:id="@+id/iv_avilabilty"
                            android:layout_width="20dp"
                            android:layout_height="15dp"
                            android:src="@drawable/ic_about_app"
                            app:tint="@color/blue"
                            android:visibility="gone"
                            android:layout_marginTop="5dp"
                            android:layout_marginStart="6dp"
                            app:layout_constraintStart_toEndOf="@+id/iv_doctorProfile"
                            app:layout_constraintTop_toBottomOf="@+id/tv_city" />

                    <androidx.appcompat.widget.AppCompatTextView
                            android:id="@+id/tv_area"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="5dp"
                            android:fontFamily="@font/avenirltstd_roman"
                            app:drawableTint="@color/blue"
                            android:drawablePadding="@dimen/_1sdp"
                            android:gravity="start"
                            android:paddingBottom="1dp"
                            android:text=""
                            android:visibility="gone"
                            android:textColor="@color/black"
                            android:textSize="12sp"
                            app:layout_constraintStart_toEndOf="@+id/iv_avilabilty"
                            app:layout_constraintEnd_toEndOf="parent"
                            android:layout_marginEnd="@dimen/_10sdp"
                            app:layout_constraintTop_toBottomOf="@+id/tv_city" />

                    <androidx.recyclerview.widget.RecyclerView
                            android:id="@+id/rvSubItem"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/_5sdp"
                            android:layout_marginStart="5dp"
                            android:layout_marginEnd="5dp"
                            tools:itemCount="3"
                            android:visibility="visible"
                            app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"
                            app:layout_constraintTop_toBottomOf="@id/tv_area"
                            app:layout_constraintBottom_toBottomOf="parent"
                            app:layout_constraintEnd_toEndOf="parent"
                            tools:listitem="@layout/item_layout_analysis_price" />

                </androidx.constraintlayout.widget.ConstraintLayout>
                <TextView
                        android:id="@+id/tv_Book"
                        android:layout_width="75dp"
                        android:layout_height="28dp"
                        android:gravity="center"
                        android:padding="2dp"
                        android:layout_marginStart="17dp"
                        android:layout_marginBottom="@dimen/_5sdp"
                        android:background="@drawable/bg_button_green"
                        android:textSize="17sp"
                        android:layout_marginTop="@dimen/_10sdp"
                        android:text="@string/more"
                        android:visibility="gone"
                        android:textColor="@color/blue"
                        app:layout_constraintTop_toBottomOf="@+id/layout_doctorsDetail"
                        app:layout_constraintStart_toStartOf="parent"
                        />

                <androidx.constraintlayout.widget.ConstraintLayout
                        android:id="@+id/layout"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toBottomOf="@+id/tv_Book"
                        app:layout_constraintBottom_toBottomOf="parent"
                        android:layout_marginBottom="5dp"
                        android:layout_marginTop="10dp">

                    <androidx.appcompat.widget.AppCompatButton
                            android:id="@+id/btn_booking"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:background="@drawable/bg_chooselang_button"
                            android:fontFamily="@font/avenirltstd_roman"
                            android:text="@string/book_now"
                            android:textColor="@color/white"
                            android:textSize="12sp"
                            android:textAllCaps="false"
                            android:layout_marginStart="@dimen/_10sdp"
                            app:layout_constraintWidth_percent=".60"
                            app:layout_constraintEnd_toStartOf="@+id/btn_more"
                            app:layout_constraintStart_toStartOf="parent"
                            app:layout_constraintTop_toTopOf="parent"
                            app:layout_constraintHorizontal_chainStyle="spread_inside" />

                    <androidx.appcompat.widget.AppCompatButton
                            android:id="@+id/btn_more"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:background="@drawable/bg_chooselang_button"
                            android:fontFamily="@font/avenirltstd_roman"
                            android:text="@string/btnmore"
                            android:layout_marginStart="@dimen/_3sdp"
                            android:textColor="@color/white"
                            android:layout_marginEnd="10dp"
                            android:textSize="13sp"
                            android:padding="1dp"
                            android:textAllCaps="false"
                            android:drawableEnd="@drawable/ic_arrow_right"
                            app:layout_constraintBottom_toBottomOf="parent"
                            app:layout_constraintEnd_toEndOf="parent"
                            app:layout_constraintStart_toEndOf="@+id/btn_booking"
                            app:layout_constraintTop_toTopOf="parent" />
                </androidx.constraintlayout.widget.ConstraintLayout>


            </androidx.constraintlayout.widget.ConstraintLayout>
        </androidx.cardview.widget.CardView>


    </androidx.constraintlayout.widget.ConstraintLayout>

</layout>