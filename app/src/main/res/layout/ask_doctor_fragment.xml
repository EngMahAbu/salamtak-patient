<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
        xmlns:android="http://schemas.android.com/apk/res/android"
        xmlns:tools="http://schemas.android.com/tools"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/bg_color_gray"
        xmlns:app="http://schemas.android.com/apk/res-auto"
        tools:context=".fragment.askdoctor.AskDoctorFragment">

    <com.google.android.material.imageview.ShapeableImageView
            android:id="@+id/iv_arrow"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="15dp"
            android:adjustViewBounds="true"
            android:padding="10dp"
            android:layout_marginTop="@dimen/_5sdp"
            android:src="@drawable/ic_arrowleft"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
    <ImageView
            android:id="@+id/iv_animatio"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="15dp"
            android:src="@drawable/visa"
            android:visibility="gone"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
    <androidx.appcompat.widget.AppCompatTextView
            android:id="@+id/tv_askDoctor"
            android:layout_width="wrap_content"
            android:layout_height="30dp"
            android:layout_marginTop="10dp"
            android:fontFamily="@font/avenirltstd_black"
            android:text="@string/askdoctor"
            android:gravity="center"
            android:padding="2dp"
            android:textColor="@color/black"
            android:textSize="15sp"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>

    <androidx.core.widget.NestedScrollView
            android:id="@+id/all_layout"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_marginBottom="@dimen/_5sdp"
            app:layout_constraintBottom_toTopOf="@+id/layout"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/tv_askDoctor">

        <androidx.constraintlayout.widget.ConstraintLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:padding="3dp"
                android:layout_marginBottom="@dimen/_5sdp"
        >
            <androidx.appcompat.widget.AppCompatButton
                    android:id="@+id/btn_layout_Choose_Specialization"
                    android:layout_width="0dp"
                    android:layout_height="0dp"
                    android:background="@android:color/transparent"
                    app:layout_constraintEnd_toEndOf="@+id/layout_Choose_Specialization"
                    app:layout_constraintStart_toStartOf="@+id/layout_Choose_Specialization"
                    app:layout_constraintTop_toTopOf="@+id/layout_Choose_Specialization"
                    app:layout_constraintBottom_toBottomOf="@+id/layout_Choose_Specialization"
            />

            <androidx.constraintlayout.widget.ConstraintLayout
                    android:id="@+id/layout_Choose_Specialization"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="15dp"
                    android:layout_marginTop="12dp"
                    android:layout_marginEnd="15dp"
                    android:background="@drawable/bg_edittext"
                    android:elevation="1dp"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent"
            >

                <androidx.appcompat.widget.AppCompatImageView
                        android:id="@+id/iv_arrowdown"
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        android:layout_gravity="center_horizontal"
                        android:layout_marginEnd="12dp"
                        android:layout_marginBottom="12dp"
                        android:gravity="start"
                        android:src="@drawable/ic_arrowdwon"
                        app:layout_constraintBottom_toBottomOf="parent"
                        app:layout_constraintEnd_toEndOf="parent"/>

                <com.google.android.material.textfield.TextInputLayout
                        android:id="@+id/textinput_Specialization"
                        style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                        android:layout_width="match_parent"
                        android:layout_height="55dp"
                        android:layout_marginEnd="25dp"
                        android:layout_marginBottom="5dp"
                        android:hint="@string/choose_specialization"
                        android:paddingTop="2dp"
                        app:boxBackgroundColor="@color/white"
                        app:boxBackgroundMode="none"
                        app:layout_constraintBottom_toBottomOf="parent"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toTopOf="parent">

                    <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/et_Specialization"
                            android:layout_width="match_parent"
                            android:layout_height="55dp"
                            android:layout_gravity="center_horizontal"
                            android:fontFamily="@font/avenirltstd_roman"
                            android:inputType="text"
                            android:enabled="false"
                            android:textColor="@color/black"
                            android:textSize="16sp"/>

                </com.google.android.material.textfield.TextInputLayout>


            </androidx.constraintlayout.widget.ConstraintLayout>


            <androidx.appcompat.widget.AppCompatTextView
                    android:id="@+id/tv_questions"
                    android:layout_width="wrap_content"
                    android:layout_height="30dp"
                    android:layout_marginStart="15dp"
                    android:layout_marginTop="18dp"
                    android:fontFamily="@font/avenirltstd_black"
                    android:text="@string/yor_question_your_identity_will_be_anonymous"
                    android:gravity="center"
                    android:padding="2dp"
                    android:textColor="@color/black"
                    android:textSize="13sp"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@+id/layout_Choose_Specialization"/>

            <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/textinput_Question"
                    style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                    android:layout_width="match_parent"
                    android:layout_height="60dp"
                   android:layout_marginStart="15dp"
                    android:layout_marginEnd="15dp"
                    android:layout_marginTop="10dp"
                    android:background="@drawable/bg_edittext"
                    android:elevation="1dp"
                    android:paddingTop="2dp"
                    app:boxBackgroundMode="none"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@+id/tv_questions">

                <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/et_Question"
                        android:layout_width="match_parent"
                        android:layout_height="60dp"
                        android:layout_gravity="center_horizontal"
                        android:fontFamily="@font/avenirltstd_roman"
                        android:gravity="start"
                        android:hint="@string/your_question"
                        android:imeOptions="actionNext"
                        android:importantForAutofill="no"
                        android:inputType="text"
                        android:textColor="@color/black"
                        android:textSize="16sp"/>

            </com.google.android.material.textfield.TextInputLayout>
            <androidx.appcompat.widget.AppCompatTextView
                    android:id="@+id/tv_questionError"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="15dp"
                    android:layout_marginTop="7dp"
                    android:layout_marginBottom="4dp"
                    android:fontFamily="@font/avenirltstd_roman"
                    android:gravity="center"
                    android:padding="2dp"
                    android:text="@string/required"
                    android:textColor="@color/red"
                    android:textSize="12sp"
                    android:visibility="gone"
                    app:layout_constraintBottom_toTopOf="@+id/layout_Diseases"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@+id/textinput_Question"/>

            <androidx.constraintlayout.widget.ConstraintLayout
                    android:id="@+id/layout_salamtakAngel"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="25dp"
                    android:layout_marginBottom="15dp"
                    android:padding="3dp"
                    android:visibility="gone"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@+id/textinput_Question">

                <androidx.appcompat.widget.AppCompatButton
                        android:id="@+id/btn_emergencies"
                        android:layout_width="0dp"
                        android:layout_height="35dp"
                        android:layout_marginStart="15dp"
                        android:background="@drawable/bg_button_sellector"
                        android:fontFamily="@font/avenirltstd_roman"
                        android:text="@string/anotherpatient"
                        android:textColor="@color/white"
                        android:textSize="14sp"
                        android:textAllCaps="false"
                        app:layout_constraintBottom_toBottomOf="parent"
                        app:layout_constraintEnd_toStartOf="@+id/btn_QandA"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toTopOf="parent"/>

                <androidx.appcompat.widget.AppCompatButton
                        android:id="@+id/btn_QandA"
                        android:layout_width="0dp"
                        android:layout_height="35dp"
                        android:layout_marginStart="10dp"
                        android:layout_marginEnd="15dp"
                        android:background="@drawable/bg_help"
                        android:fontFamily="@font/avenirltstd_roman"
                        android:text="@string/me"
                        android:textAllCaps="false"
                        android:textColor="@color/blue"
                        android:textSize="14sp"
                        app:layout_constraintBottom_toBottomOf="parent"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintStart_toEndOf="@+id/btn_emergencies"
                        app:layout_constraintTop_toTopOf="parent"/>


            </androidx.constraintlayout.widget.ConstraintLayout>
            <androidx.appcompat.widget.AppCompatTextView
                    android:id="@+id/tv_specError"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="15dp"
                    android:layout_marginTop="5dp"
                    android:layout_marginBottom="4dp"
                    android:fontFamily="@font/avenirltstd_roman"
                    android:gravity="center"
                    android:padding="1dp"
                    android:text="@string/required"
                    android:textColor="@color/red"
                    android:textSize="12sp"
                    android:visibility="gone"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@+id/layout_Choose_Specialization"/>

        <androidx.constraintlayout.widget.ConstraintLayout
                android:id="@+id/layout_Diseases"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="15dp"
                android:layout_marginStart="5dp"
                android:background="@drawable/bg_edittext_gray"
                android:layout_marginEnd="5dp"
                app:layout_constraintTop_toBottomOf="@+id/layout_salamtakAngel"
                >

            <androidx.appcompat.widget.AppCompatEditText
                    android:id="@+id/textinput_QuestionDetails"
                    android:padding="8dp"
                    android:minLines="5"
                    android:singleLine="false"
                    android:lines="6"
                    android:scrollbars="vertical"
                    android:background="@drawable/bg_edittext"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_margin="10dp"
                    android:autofillHints=""
                    android:elevation="1dp"
                    android:textSize="16sp"
                    android:importantForAutofill="no"
                    android:imeOptions="actionNext"
                    android:hint="@string/chronic_diseases"
                    android:gravity="start|center_vertical"
                    android:inputType="textMultiLine"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"
                   app:layout_constraintTop_toTopOf="parent"
                    />
            <androidx.appcompat.widget.AppCompatEditText
                    android:id="@+id/textinput_surgeryOperations"
                    android:padding="8dp"
                    android:minLines="5"
                    android:singleLine="false"
                    android:lines="6"
                    android:scrollbars="vertical"
                    android:background="@drawable/bg_edittext"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_margin="10dp"
                    android:autofillHints=""
                    android:elevation="1dp"
                    android:textSize="16sp"
                    android:importantForAutofill="no"
                    android:imeOptions="actionNext"
                    android:hint="@string/prevSurgery"
                    android:gravity="start|center_vertical"
                    android:inputType="textMultiLine"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintTop_toBottomOf="@+id/textinput_QuestionDetails"
                    />

        </androidx.constraintlayout.widget.ConstraintLayout>


            <androidx.appcompat.widget.AppCompatTextView
                    android:id="@+id/tv_questionDetailsError"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="15dp"
                    android:layout_marginTop="7dp"
                    android:layout_marginBottom="8dp"
                    android:fontFamily="@font/avenirltstd_roman"
                    android:gravity="center"
                    android:padding="2dp"
                    android:text="@string/required"
                    android:textColor="@color/red"
                    android:textSize="12sp"
                    android:visibility="gone"
                    app:layout_constraintBottom_toTopOf="@+id/layout_Choose_Gender"
                    app:layout_constraintStart_toStartOf="parent"
                   />

            <!--    </com.google.android.material.textfield.TextInputLayout>-->

            <!--    <androidx.appcompat.widget.AppCompatEditText-->
            <!--            android:id="@+id/textinput_QuestionDetails"-->
            <!--            android:padding="8dp"-->
            <!--            android:minLines="6"-->
            <!--            style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"-->
            <!--            android:singleLine="false"-->
            <!--            android:lines="8"-->
            <!--            android:scrollbars="vertical"-->
            <!--            android:background="@drawable/bg_edittext"-->
            <!--            android:layout_width="0dp"-->
            <!--            android:layout_height="wrap_content"-->
            <!--            android:layout_margin="15dp"-->
            <!--            android:autofillHints=""-->
            <!--            android:elevation="1dp"-->
            <!--            android:hint="@string/question_descreption_explanation_of_your_medical_symotoms"-->
            <!--            android:gravity="start|top"-->
            <!--            android:inputType="textMultiLine"-->
            <!--            app:layout_constraintStart_toStartOf="parent"-->
            <!--            app:layout_constraintEnd_toEndOf="parent"-->
            <!--            app:layout_constraintTop_toBottomOf="@+id/textinput_Question"-->
            <!--    />-->


            <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/textinput_Age"
                    style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                    android:layout_width="match_parent"
                    android:layout_height="60dp"
                    android:layout_marginEnd="15dp"
                    android:layout_marginStart="15dp"
                    android:layout_marginTop="15dp"
                    android:layout_marginBottom="15dp"
                    android:background="@drawable/bg_edittext"
                    android:elevation="1dp"
                    android:paddingTop="2dp"
                    app:boxBackgroundMode="none"
                    app:layout_constraintBottom_toTopOf="@+id/tv_Notes"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@+id/layout_Choose_Gender">

                <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/et_Age"
                        android:layout_width="match_parent"
                        android:layout_height="60dp"
                        android:layout_gravity="center_horizontal"
                        android:fontFamily="@font/avenirltstd_roman"
                        android:gravity="start"
                        android:hint="@string/ages"
                        android:imeOptions="actionNext"
                        android:importantForAutofill="no"
                        android:inputType="number"
                        android:textColor="@color/black"
                        android:textSize="16sp"/>

            </com.google.android.material.textfield.TextInputLayout>

            <androidx.appcompat.widget.AppCompatTextView
                    android:id="@+id/tv_Notes"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="15dp"
                    android:layout_marginEnd="15dp"
                    android:layout_marginTop="10dp"
                    android:background="@drawable/more_cards_background"
                    android:fontFamily="@font/sf_pro_display_semibold"
                    android:text="@string/questionsnotes"
                    android:gravity="start"
                    android:padding="8dp"
                    android:textColor="@color/text_doctor_card_color"
                    android:textSize="15sp"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintTop_toBottomOf="@+id/tv_genderError"
                    app:layout_constraintHorizontal_bias="1.0" />

            <androidx.appcompat.widget.AppCompatTextView
                    android:id="@+id/tv_ageError"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="15dp"
                    android:layout_marginTop="7dp"
                    android:layout_marginBottom="8dp"
                    android:fontFamily="@font/avenirltstd_roman"
                    android:gravity="center"
                    android:padding="2dp"
                    android:text="@string/required"
                    android:textColor="@color/red"
                    android:textSize="12sp"
                    android:visibility="gone"
                    app:layout_constraintBottom_toTopOf="@+id/textinput_Age"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@+id/layout_Choose_Gender"/>
            <androidx.constraintlayout.widget.ConstraintLayout
                    android:id="@+id/layout_Choose_Gender"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="15dp"
                    android:layout_marginTop="15dp"
                    android:layout_marginEnd="15dp"
                    android:layout_marginBottom="10dp"
                    android:background="@drawable/bg_edittext"
                    android:elevation="1dp"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@+id/layout_Diseases">

                <androidx.appcompat.widget.AppCompatImageView
                        android:id="@+id/iv_arrowdownChoose_Gender"
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        android:layout_gravity="center_horizontal"
                        android:layout_marginEnd="12dp"
                        android:layout_marginBottom="12dp"
                        android:gravity="start"
                        android:src="@drawable/ic_arrowdwon"
                        app:layout_constraintBottom_toBottomOf="parent"
                        app:layout_constraintEnd_toEndOf="parent"/>

                <com.google.android.material.textfield.TextInputLayout
                        android:id="@+id/textinput_Choose_Gender"
                        style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                        android:layout_width="match_parent"
                        android:layout_height="55dp"
                        android:layout_marginEnd="25dp"
                        android:layout_marginBottom="5dp"
                        android:hint="@string/choose_gender"
                        android:paddingTop="4dp"
                        app:boxBackgroundColor="@color/white"
                        app:boxBackgroundMode="none"
                        app:layout_constraintBottom_toBottomOf="parent"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toTopOf="parent">

                    <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/et_Choose_Gender"
                            android:layout_width="match_parent"
                            android:layout_height="55dp"
                            android:layout_gravity="center_horizontal"
                            android:fontFamily="@font/avenirltstd_roman"
                            android:inputType="text"
                            android:enabled="false"
                            android:textColor="@color/black"
                            android:textSize="16sp"/>

                </com.google.android.material.textfield.TextInputLayout>

            </androidx.constraintlayout.widget.ConstraintLayout>
            <androidx.appcompat.widget.AppCompatButton
                    android:id="@+id/btn_layout_Choose_Gender"
                    android:layout_width="0dp"
                    android:layout_height="0dp"
                    android:background="@android:color/transparent"
                    app:layout_constraintEnd_toEndOf="@+id/layout_Choose_Gender"
                    app:layout_constraintStart_toStartOf="@+id/layout_Choose_Gender"
                    app:layout_constraintTop_toTopOf="@+id/layout_Choose_Gender"
                    app:layout_constraintBottom_toBottomOf="@+id/layout_Choose_Gender"
            />
            <androidx.appcompat.widget.AppCompatTextView
                    android:id="@+id/tv_genderError"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="15dp"
                    android:layout_marginTop="7dp"
                    android:layout_marginBottom="5dp"
                    android:fontFamily="@font/avenirltstd_roman"
                    android:gravity="center"
                    android:padding="2dp"
                    android:text="@string/required"
                    android:textColor="@color/red"
                    android:textSize="12sp"
                    android:visibility="gone"

                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@+id/textinput_Age"/>


            <androidx.appcompat.widget.AppCompatButton
                    android:id="@+id/btn_layoutChoose_me"
                    android:layout_width="0dp"
                    android:layout_height="0dp"
                    android:background="@android:color/transparent"
                    app:layout_constraintEnd_toEndOf="@+id/layout_Choose_me"
                    app:layout_constraintStart_toStartOf="@+id/layout_Choose_me"
                    app:layout_constraintTop_toTopOf="@+id/layout_Choose_me"
                    app:layout_constraintBottom_toBottomOf="@+id/layout_Choose_me"
            />

            <androidx.constraintlayout.widget.ConstraintLayout
                    android:id="@+id/layout_Choose_me"
                    android:layout_width="match_parent"
                    android:layout_height="55dp"
                    android:layout_marginStart="15dp"
                    android:layout_marginTop="15dp"
                    android:layout_marginEnd="15dp"
                    android:layout_marginBottom="@dimen/_5sdp"
                    android:background="@drawable/bg_edittext"
                    android:elevation="1dp"
                    android:visibility="gone"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@+id/textinput_Age">
                <androidx.appcompat.widget.AppCompatImageView
                        android:id="@+id/iv_arrowdownChoose_me"
                        android:layout_width="20dp"
                        android:layout_height="0dp"
                        android:layout_gravity="center_horizontal"
                        android:layout_marginEnd="12dp"
                        android:gravity="start"
                        android:src="@drawable/ic_arrowdwon"
                        app:layout_constraintTop_toTopOf="parent"
                        app:layout_constraintBottom_toBottomOf="parent"
                        app:layout_constraintEnd_toEndOf="parent"/>

                <com.google.android.material.textfield.TextInputLayout
                        android:id="@+id/textinput_Choose_me"
                        style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                        android:layout_width="match_parent"
                        android:layout_height="55dp"
                        android:layout_marginEnd="25dp"
                        android:layout_marginBottom="5dp"
                        android:hint="@string/questionanswer"
                        android:paddingTop="4dp"
                        app:boxBackgroundColor="@color/white"
                        app:boxBackgroundMode="none"
                        app:layout_constraintBottom_toBottomOf="parent"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toTopOf="parent">

                    <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/et_Choose_me"
                            android:layout_width="match_parent"
                            android:layout_height="55dp"
                            android:layout_gravity="center_horizontal"
                            android:fontFamily="@font/avenirltstd_roman"
                            android:inputType="text"
                            android:enabled="false"
                            android:textColor="@color/black"
                            android:textSize="16sp"/>

                </com.google.android.material.textfield.TextInputLayout>

            </androidx.constraintlayout.widget.ConstraintLayout>

            <androidx.appcompat.widget.AppCompatTextView
                    android:id="@+id/tv_patientError"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="15dp"
                    android:layout_marginBottom="8dp"
                    android:layout_marginTop="@dimen/_3sdp"
                    android:fontFamily="@font/avenirltstd_roman"
                    android:gravity="center"
                    android:padding="2dp"
                    android:text="@string/required"
                    android:textColor="@color/red"
                    android:textSize="12sp"
                    android:visibility="gone"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@+id/layout_salamtakAngel"/>


        </androidx.constraintlayout.widget.ConstraintLayout>


    </androidx.core.widget.NestedScrollView>

    <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/layout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/all_layout"
            app:layout_constraintWidth_percent=".9"
            android:padding="8dp"
    >
        <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/btn_send"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_chooselang_button"
                android:fontFamily="@font/avenirltstd_black"
                android:padding="5dp"
                android:text="@string/send"
                android:textAllCaps="false"
                android:textColor="@color/white"
                android:textSize="14sp"
                android:layout_marginStart="15dp"
