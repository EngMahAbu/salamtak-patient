<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:padding="16dp">

    <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">
        <TextView
                android:id="@+id/tvTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Monitoring devices"
                android:textColor="#800000"
                android:textSize="24sp"
                android:layout_gravity="center"
                android:paddingBottom="16dp"
                android:textStyle="bold" />
        <!-- Full Name -->
        <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Full Name (First _ Middle _ Last)"
                android:textSize="16sp"
                android:paddingTop="8dp"/>

        <EditText
                android:id="@+id/etFullName"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="Enter full name"
                android:inputType="textPersonName"/>

        <!-- Mobile Number -->
        <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Mobile Number"
                android:textSize="16sp"
                android:paddingTop="8dp"/>

        <EditText
                android:id="@+id/etMobileNumber"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="Enter mobile number"
                android:inputType="phone"/>

        <!-- Address -->
        <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Address (Details)"
                android:textSize="16sp"
                android:paddingTop="8dp"/>

        <EditText
                android:id="@+id/etAddress"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="Enter address"
                android:inputType="textPostalAddress"/>

        <!-- Monitoring Devices Level Dropdown -->
        <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Monitoring Devices Level"
                android:textSize="16sp"
                android:paddingTop="8dp"/>

        <Spinner
                android:id="@+id/spinnerMonitoringLevel"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:spinnerMode="dropdown"/>

        <!-- Fees with From/To -->
        <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Fees"
                android:textSize="16sp"
                android:paddingTop="8dp"/>

        <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:weightSum="3"
                android:paddingTop="4dp">

            <EditText
                    android:id="@+id/etFees"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:hint="Fees"
                    android:inputType="numberDecimal"/>

            <EditText
                    android:id="@+id/etFrom"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:hint="From"
                    android:focusable="false"/>

            <EditText
                    android:id="@+id/etTo"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:hint="To"
                    android:focusable="false"/>
        </LinearLayout>

        <!-- Photo Upload -->
        <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Photo"
                android:textSize="16sp"
                android:paddingTop="8dp"/>

        <ImageView
                android:id="@+id/imgPhoto"
                android:layout_width="150dp"
                android:layout_height="150dp"
                android:layout_gravity="center"
                android:src="@android:drawable/ic_menu_camera"
                android:contentDescription="Upload Photo"
                android:scaleType="centerCrop"
                android:background="@android:color/darker_gray"
                android:padding="4dp"/>

        <!-- Send Button -->
        <Button
                android:id="@+id/btnSend"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Send"
                android:layout_marginTop="16dp"/>

    </LinearLayout>
</ScrollView>
