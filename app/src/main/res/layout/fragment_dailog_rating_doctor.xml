<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
        xmlns:android="http://schemas.android.com/apk/res/android"
        xmlns:tools="http://schemas.android.com/tools"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:padding="15dp"
        xmlns:app="http://schemas.android.com/apk/res-auto"
        tools:context=".fragment.dialog.DialogRatingDoctorFragment">


    <androidx.appcompat.widget.AppCompatTextView
            android:id="@+id/tv_ratingDoctor"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="@font/avenirltstd_black"
            android:gravity="center"
            android:padding="2dp"
            android:layout_marginTop="10dp"
            android:layout_marginStart="15dp"
            android:text="@string/rate_doctor"
            android:textColor="@color/black"
            android:textSize="15sp"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
    />


    <androidx.core.widget.NestedScrollView
            android:id="@+id/layout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:layout_constraintTop_toBottomOf="@+id/tv_ratingDoctor"

    >
        <androidx.constraintlayout.widget.ConstraintLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
        >

            <androidx.constraintlayout.widget.ConstraintLayout
                    android:id="@+id/layout_doctorsDetail"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:layout_marginTop="15dp"
                    android:layout_marginStart="15dp"
                    android:layout_marginEnd="15dp"
                    android:padding="8dp"
                    android:background="@drawable/bg_edittext"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent">

                <com.google.android.material.imageview.ShapeableImageView
                        android:id="@+id/iv_doctorProfile"
                        android:layout_width="47dp"
                        android:layout_height="47dp"
                        android:src="@drawable/ic_docspecialization"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toTopOf="parent"/>

                <androidx.appcompat.widget.AppCompatTextView
                        android:id="@+id/tv_doctorName"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="10dp"
                        android:layout_marginEnd="15dp"
                        android:fontFamily="@font/avenirltstd_roman"
                        android:gravity="start"
                        android:padding="3dp"
                        android:text="Dr. Mohamed Farag Abdullatif"
                        android:textColor="@color/black"
                        android:textSize="15sp"
                        app:layout_constraintStart_toEndOf="@+id/iv_doctorProfile"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintTop_toTopOf="@+id/iv_doctorProfile"/>

                <androidx.appcompat.widget.AppCompatTextView
                        android:id="@+id/tv_Specialization"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="10dp"
                        android:layout_marginEnd="15dp"
                        android:layout_marginTop="5dp"
                        android:fontFamily="@font/avenirltstd_roman"
                        android:gravity="start"
                        android:padding="2dp"
                        android:text="Genecology and Infertility"
                        android:textColor="@color/gray"
                        android:textSize="15sp"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintStart_toEndOf="@+id/iv_doctorProfile"
                        app:layout_constraintTop_toBottomOf="@+id/tv_doctorName"/>

            </androidx.constraintlayout.widget.ConstraintLayout>

            <androidx.appcompat.widget.AppCompatRatingBar
                    android:id="@+id/ratingBar"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    app:layout_constraintTop_toBottomOf="@+id/layout_doctorsDetail"
                    android:layout_marginTop="10dp"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"
                    android:rating="0"
                    android:theme="@style/ratingBar"

            />
            <androidx.appcompat.widget.AppCompatEditText
                    android:id="@+id/textinput_comment"
                    android:padding="8dp"
                    android:minLines="5"
                    android:singleLine="false"
                    android:lines="6"
                    android:scrollbars="vertical"
                    android:background="@drawable/bg_rating"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_margin="15dp"
                    android:autofillHints=""
                    android:elevation="1dp"
                    android:importantForAutofill="no"
                    android:imeOptions="actionDone"
                    android:hint="@string/write_a_comment"
                    android:gravity="start|center"
                    android:inputType="textMultiLine"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintTop_toBottomOf="@+id/ratingBar"
            />
            <androidx.appcompat.widget.AppCompatTextView
                    android:id="@+id/tv_name"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="15dp"
                    android:layout_marginTop="15dp"
                    android:fontFamily="@font/avenirltstd_black"
                    android:text="@string/reviewspolyclinics"
                    android:textColor="@color/black"
                    android:textSize="16sp"
                  app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@+id/textinput_comment" />
            <androidx.appcompat.widget.AppCompatEditText
                    android:id="@+id/textinput_comment_polyclinics"
                    android:padding="8dp"
                    android:minLines="5"
                    android:singleLine="false"
                    android:lines="6"
                    android:scrollbars="vertical"
                    android:background="@drawable/bg_rating"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="15dp"
                    android:layout_marginEnd="15dp"
                    android:autofillHints=""
                    android:elevation="1dp"
                    android:importantForAutofill="no"
                    android:imeOptions="actionDone"
                    android:hint="@string/write_a_comment"
                    android:gravity="start|center"
                    android:inputType="textMultiLine"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintTop_toBottomOf="@+id/tv_name"
                    />


        </androidx.constraintlayout.widget.ConstraintLayout>

    </androidx.core.widget.NestedScrollView>

    <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/layout_btn_save"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/layout"
            app:layout_constraintWidth_percent=".90"
            app:layout_constraintBottom_toBottomOf="parent"
            android:padding="8dp"
            android:layout_marginTop="20dp"
    >
        <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/btn_save"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_chooselang_button"
                android:fontFamily="@font/avenirltstd_black"
                android:padding="5dp"
                android:text="@string/save"
                android:textColor="@color/white"
                android:textSize="14sp"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintBottom_toBottomOf="parent"

        />
    </androidx.constraintlayout.widget.ConstraintLayout>
    <ProgressBar
            android:id="@+id/progress_barInfo"
            android:layout_width="35dp"
            android:layout_height="35dp"
            android:visibility="gone"
            android:indeterminateTint="@color/white"
            app:layout_constraintBottom_toBottomOf="@+id/layout_btn_save"
            app:layout_constraintEnd_toEndOf="@+id/layout_btn_save"
            app:layout_constraintStart_toStartOf="@+id/layout_btn_save"
            app:layout_constraintTop_toTopOf="@+id/layout_btn_save"/>


</androidx.constraintlayout.widget.ConstraintLayout>