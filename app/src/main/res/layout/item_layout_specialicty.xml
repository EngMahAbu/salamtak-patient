<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
        xmlns:android="http://schemas.android.com/apk/res/android"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        xmlns:app="http://schemas.android.com/apk/res-auto">

    <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/layout"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintStart_toStartOf="parent"

    >

    <CheckBox
            android:id="@+id/ch_examinationtype"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_margin="5dp"
            android:buttonTint="@color/color_primary"
            android:elevation="1dp"
            android:paddingStart="@dimen/_25sdp"
            android:fontFamily="@font/avenirltstd_black"
            android:minWidth="48dp"
            android:minHeight="0dp"
            android:text="55555555555555555555555555555"
            android:textColor="@color/black"
            android:textSize="14sp"
            app:layout_constraintStart_toStartOf="parent"/>

    <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/iv_examination"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:layout_marginEnd="15dp"
            android:layout_marginStart="@dimen/_25sdp"
            app:layout_constraintBottom_toBottomOf="@+id/ch_examinationtype"
            app:layout_constraintStart_toStartOf="@+id/ch_examinationtype"
            app:layout_constraintTop_toTopOf="@+id/ch_examinationtype"
    >

        <com.google.android.material.imageview.ShapeableImageView
                android:id="@+id/ivExaminationtype"
                android:layout_width="45dp"
                android:layout_height="45dp"
                android:adjustViewBounds="true"
                android:src="@drawable/ic_doctors"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
    <androidx.appcompat.widget.AppCompatTextView
            android:id="@+id/tv_Examinationtype"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="5dp"
            android:fontFamily="@font/avenirltstd_roman"
            android:gravity="start"
            android:padding="3dp"
            android:visibility="gone"
            android:text="@string/Clinic_Booking"
            android:textColor="@color/gray"
            android:textSize="16sp"
            app:layout_constraintStart_toEndOf="@+id/iv_examination"
            app:layout_constraintTop_toTopOf="@+id/iv_examination"
            app:layout_constraintBottom_toBottomOf="@+id/iv_examination"
    />
    </androidx.constraintlayout.widget.ConstraintLayout>
</androidx.constraintlayout.widget.ConstraintLayout>