    <com.google.android.material.card.MaterialCardView
            android:id="@+id/mcard"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="@dimen/_6sdp"
            android:layout_marginBottom="@dimen/_12sdp"
            app:cardElevation="@dimen/_2sdp"
            app:cardCornerRadius="@dimen/_6sdp"
            app:cardBackgroundColor="@color/white">

        <androidx.constraintlayout.widget.ConstraintLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

            <!-- DOCTOR NAME & ARROW -->
            <TextView
                    android:id="@+id/doctor_name_tv"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:gravity="start|center_vertical"
                    android:padding="@dimen/_8sdp"
                    android:textColor="@color/black"
                    android:textSize="16sp"
                    android:fontFamily="@font/sf_pro_display_semibold"
                    android:textStyle="bold"
                    app:layout_constraintEnd_toStartOf="@+id/edit_patient_account_tv"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent"
                    tools:text="Dr. osm test test" />

            <TextView
                    android:id="@+id/details_tv"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:visibility="gone"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintTop_toTopOf="parent" />

            <!-- Using a standard ImageView with background for the expand icon -->
            <ImageView
                    android:id="@+id/edit_patient_account_tv"
                    android:layout_width="28dp"
                    android:layout_height="28dp"
                    android:layout_marginEnd="@dimen/_8sdp"
                    android:background="@drawable/bg_dark_blue_square"
                    android:padding="6dp"
                    android:src="@drawable/ic_circle_arrow_down"
                    app:tint="@color/white"
                    app:layout_constraintBottom_toBottomOf="@+id/doctor_name_tv"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintTop_toTopOf="@+id/doctor_name_tv" />

            <ImageView
                    android:id="@+id/edit_next_arrow"
                    android:layout_width="28dp"
                    android:layout_height="28dp"
                    android:layout_marginEnd="@dimen/_8sdp"
                    android:background="@drawable/bg_dark_blue_square"
                    android:padding="6dp"
                    android:src="@drawable/ic_up_arrow"
                    android:visibility="gone"
                    app:tint="@color/white"
                    app:layout_constraintBottom_toBottomOf="@+id/doctor_name_tv"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintTop_toTopOf="@+id/doctor_name_tv" />

            <ImageView
                    android:id="@+id/delete_patient_account_tv"
                    android:layout_width="32dp"
                    android:layout_height="32dp"
                    android:visibility="gone"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintTop_toTopOf="parent" />

            <!-- SEPARATOR -->
            <View
                    android:id="@+id/header_separator"
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:layout_marginHorizontal="@dimen/_8sdp"
                    android:background="#E0E0E0"
                    app:layout_constraintTop_toBottomOf="@+id/doctor_name_tv" />

            <!-- TABLE HEADERS -->
            <LinearLayout
                    android:id="@+id/linearLayout2"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:paddingVertical="8dp"
                    android:paddingHorizontal="@dimen/_8sdp"
                    app:layout_constraintTop_toBottomOf="@+id/header_separator">

                <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1.2"
                        android:gravity="center"
                        android:textColor="#333333"
                        android:textSize="12sp"
                        android:text="Date" />

                <View android:layout_width="1dp" android:layout_height="match_parent" android:background="#E0E0E0" />

                <TextView
                        android:id="@+id/tv_services"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1.2"
                        android:gravity="center"
                        android:textColor="#333333"
                        android:textSize="12sp"
                        android:text="Service" />

                <View android:layout_width="1dp" android:layout_height="match_parent" android:background="#E0E0E0" />

                <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1.1"
                        android:gravity="center"
                        android:textColor="#333333"
                        android:textSize="12sp"
                        android:text="Service\nCost" />

                <View android:layout_width="1dp" android:layout_height="match_parent" android:background="#E0E0E0" />

                <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:gravity="center"
                        android:textColor="#333333"
                        android:textSize="12sp"
                        android:text="Paid" />

                <View android:layout_width="1dp" android:layout_height="match_parent" android:background="#E0E0E0" />

                <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:gravity="center"
                        android:textColor="#333333"
                        android:textSize="12sp"
                        android:text="Balance" />
            </LinearLayout>

            <!-- SINGLE ITEM ROW (tab) -->
            <LinearLayout
                    android:id="@+id/tab"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:paddingVertical="8dp"
                    android:paddingHorizontal="@dimen/_8sdp"
                    android:visibility="gone"
                    app:layout_constraintTop_toBottomOf="@+id/linearLayout2">

                <TextView
                        android:id="@+id/date_tv"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1.2"
                        android:gravity="center"
                        android:textColor="#333333"
                        android:textSize="12sp"
                        android:lines="1"
                        tools:text="22/07/2020" />

                <View android:layout_width="1dp" android:layout_height="match_parent" android:background="#E0E0E0" />

                <TextView
                        android:id="@+id/service_tv"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1.2"
                        android:gravity="center"
                        android:textColor="#333333"
                        android:textSize="12sp"
                        tools:text="Simple test" />

                <View android:layout_width="1dp" android:layout_height="match_parent" android:background="#E0E0E0" />

                <TextView
                        android:id="@+id/fee_tv"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1.1"
                        android:gravity="center"
                        android:textColor="#333333"
                        android:textSize="12sp"
                        tools:text="300 LE" />

                <View android:layout_width="1dp" android:layout_height="match_parent" android:background="#E0E0E0" />

                <TextView
                        android:id="@+id/paid_tv"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:gravity="center"
                        android:textColor="#333333"
                        android:textSize="12sp"
                        tools:text="100 LE" />

                <View android:layout_width="1dp" android:layout_height="match_parent" android:background="#E0E0E0" />

                <TextView
                        android:id="@+id/totabalance_tv"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:gravity="center"
                        android:textColor="#333333"
                        android:textSize="12sp"
                        tools:text="200 LE" />
            </LinearLayout>

            <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/rvSubItem"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:visibility="gone"
                    android:paddingHorizontal="@dimen/_8sdp"
                    app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"
                    app:layout_constraintTop_toBottomOf="@id/tab"
                    tools:listitem="@layout/item_layout_invoice" />

            <!-- FOOTER TOTALS -->
            <LinearLayout
                    android:id="@+id/balance"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:paddingVertical="12dp"
                    android:paddingHorizontal="@dimen/_8sdp"
                    android:background="@drawable/bg_billing_footer"
                    app:layout_constraintTop_toBottomOf="@+id/rvSubItem">

                <!-- Grand Total Label spanning first two columns (1.2 + 1.2 = 2.4 weight) -->
                <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="2.4"
                        android:gravity="center"
                        android:text="Grand Total"
                        android:textColor="#1F1A4D"
                        android:textSize="14sp" />

                <View android:layout_width="1dp" android:layout_height="match_parent" android:background="#1F1A4D" />

                <!-- Total Service Cost -->
                <TextView
                        android:id="@+id/totalfees_tv"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1.1"
                        android:gravity="center"
                        android:textColor="#333333"
                        android:textSize="12sp"
                        tools:text="381 LE" />

                <View android:layout_width="1dp" android:layout_height="match_parent" android:background="#1F1A4D" />

                <!-- Total Paid -->
                <TextView
                        android:id="@+id/totalpaid_tv"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:gravity="center"
                        android:textColor="#333333"
                        android:textSize="12sp"
                        tools:text="217 LE" />

                <View android:layout_width="1dp" android:layout_height="match_parent" android:background="#1F1A4D" />

                <!-- Balance -->
                <TextView
                        android:id="@+id/balance_tv"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:gravity="center"
                        android:textColor="#333333"
                        android:textSize="12sp"
                        tools:text="164 LE" />
            </LinearLayout>

        </androidx.constraintlayout.widget.ConstraintLayout>
    </com.google.android.material.card.MaterialCardView>


</layout>