    <com.google.android.material.card.MaterialCardView
            android:id="@+id/mcard"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="@dimen/_6sdp"
            app:cardElevation="@dimen/_1sdp"
            app:cardCornerRadius="@dimen/_6sdp">

        <androidx.constraintlayout.widget.ConstraintLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent">


            <TextView
                    android:id="@+id/doctor_name_tv"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:gravity="start"
                    android:padding="@dimen/_3sdp"
                    android:textColor="@color/black"
                    android:textSize="@dimen/_12ssp"
                    android:layout_marginTop="10dp"
                    android:layout_marginStart="@dimen/_5sdp"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent"
                    tools:text="Mohamed " />
            <TextView
                    android:id="@+id/details_tv"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:gravity="start"
                    android:padding="@dimen/_3sdp"
                    android:textColor="@color/black"
                    android:textSize="@dimen/_12ssp"
                    android:text="@string/detailsaccount"
                    android:layout_marginTop="10dp"
                    android:layout_marginEnd="@dimen/_10sdp"
                    android:layout_marginStart="@dimen/_20sdp"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintTop_toTopOf="parent"
                    tools:text="تفاصيل الحساب " />

            <androidx.appcompat.widget.AppCompatImageView
                    android:id="@+id/edit_patient_account_tv"
                    android:layout_width="25dp"
                    android:layout_height="25dp"
                    android:layout_column="7"
                    android:gravity="center"
                    android:src="@drawable/ic_circle_arrow_down"
                    android:tint="@color/blue"
                    android:visibility="visible"
                    app:layout_constraintBottom_toBottomOf="@+id/delete_patient_account_tv"
                    app:layout_constraintEnd_toStartOf="@+id/details_tv"
                    app:layout_constraintTop_toTopOf="@+id/delete_patient_account_tv" />

            <androidx.appcompat.widget.AppCompatImageView
                    android:id="@+id/edit_next_arrow"
                    android:layout_width="25dp"
                    android:layout_height="25dp"
                    android:layout_column="7"
                    android:layout_marginStart="3dp"
                    android:layout_marginEnd="8dp"
                    android:gravity="center"
                    android:visibility="gone"
                    android:src="@drawable/ic_up_arrow"
                    android:tint="@color/blue"
                    app:layout_constraintBottom_toBottomOf="@+id/delete_patient_account_tv"
                    app:layout_constraintStart_toEndOf="@+id/doctor_name_tv"
                    app:layout_constraintTop_toTopOf="@+id/delete_patient_account_tv" />

            <ImageView
                    android:id="@+id/delete_patient_account_tv"
                    android:layout_width="32dp"
                    android:layout_height="32dp"
                    android:layout_column="8"
                    android:layout_marginEnd="8dp"
                    android:gravity="center"
                    android:visibility="gone"
                    app:layout_constraintBottom_toBottomOf="@+id/doctor_name_tv"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintTop_toTopOf="@+id/doctor_name_tv" />

            <LinearLayout
                    android:id="@+id/linearLayout2"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:paddingHorizontal="@dimen/_6sdp"
                    android:layout_marginTop="@dimen/_6sdp"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@+id/doctor_name_tv">


                <TableLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:stretchColumns="1,2,3,4">

                    <TableRow
                            android:layout_width="match_parent"
                            android:layout_height="match_parent">

                        <TextView
                                android:layout_width="80dp"
                                android:layout_height="wrap_content"
                                android:layout_column="1"
                                android:gravity="start"
                                android:textColor="@color/hint_color"
                                android:textSize="@dimen/_12ssp"
                                android:text="@string/datess" />


                        <TextView
                                android:id="@+id/tv_services"
                                android:layout_width="80dp"
                                android:layout_height="wrap_content"
                                android:layout_column="2"
                                android:gravity="center"
                                android:visibility="invisible"
                                android:textColor="@color/hint_color"
                                android:textSize="@dimen/_12ssp"
                                android:text="@string/servicess" />

                        <TextView
                                android:layout_width="80dp"
                                android:layout_height="wrap_content"
                                android:layout_column="3"
                                android:gravity="center"
                                android:textColor="@color/hint_color"
                                android:textSize="@dimen/_11ssp"
                                android:text="@string/fee" />

                        <TextView
                                android:layout_width="80dp"
                                android:layout_height="wrap_content"
                                android:layout_column="4"
                                android:gravity="center"
                                android:textColor="@color/hint_color"
                                android:textSize="@dimen/_12ssp"
                                android:text="@string/paids" />

                    </TableRow>

                </TableLayout>

            </LinearLayout>

            <TableLayout
                    android:id="@+id/tab"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_margin="@dimen/_5sdp"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintTop_toBottomOf="@+id/linearLayout2"
                    android:stretchColumns="1,2,3,4">

                <TableRow
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:background="@drawable/invoice_border">

                    <TextView
                            android:id="@+id/date_tv"
                            android:layout_width="80dp"
                            android:layout_height="wrap_content"
                            android:layout_column="1"
                            android:gravity="center"
                            android:lines="1"
                            android:textColor="@color/black"
                            android:textSize="12sp"
                            tools:text="22/07/2020" />


                    <TextView
                            android:id="@+id/service_tv"
                            android:layout_width="80dp"
                            android:layout_height="wrap_content"
                            android:layout_column="2"
                            android:gravity="center_horizontal"
                            android:textColor="@color/black"
                            android:textSize="12sp"
                            android:visibility="invisible"
                            android:background="@drawable/invoice_border"
                            tools:text="limpe tets" />

                    <TextView
                            android:id="@+id/fee_tv"
                            android:layout_width="80dp"
                            android:layout_height="wrap_content"
                            android:layout_column="3"
                            android:gravity="center_horizontal"
                            android:textColor="@color/black"
                            android:textSize="12sp"
                            tools:text="300" />

                    <TextView
                            android:id="@+id/paid_tv"
                            android:layout_width="80dp"
                            android:layout_height="wrap_content"
                            android:layout_column="4"
                            android:gravity="center_horizontal"
                            android:textColor="@color/black"
                            android:textSize="12sp"
                            tools:text="100" />

                </TableRow>

            </TableLayout>

            <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/rvSubItem"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/_15sdp"
                    tools:itemCount="3"
                    android:visibility="gone"
                    app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"
                    app:layout_constraintTop_toBottomOf="@id/linearLayout2"
                    tools:listitem="@layout/item_layout_invoice" />

            <LinearLayout
                    android:id="@+id/balance"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginTop="25dp"
                    android:paddingHorizontal="@dimen/_6sdp"
                    android:visibility="visible"
                    android:background="@drawable/balance_bg"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@+id/rvSubItem">

                <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:gravity="start"
                        android:layout_weight="1"
                        android:padding="@dimen/_6sdp"
                        android:textColor="@color/head_color"
                        android:textSize="@dimen/_12ssp"
                        android:text="@string/balance" />

                <TextView
                        android:id="@+id/balance_tv"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:padding="@dimen/_6sdp"
                        android:layout_weight="1"
                        android:gravity="center_horizontal"
                        android:textColor="@color/head_color"
                        android:textSize="@dimen/_12ssp"
                        tools:text="100" />
            </LinearLayout>


        </androidx.constraintlayout.widget.ConstraintLayout>
    </com.google.android.material.card.MaterialCardView>


</layout>