<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout
        xmlns:android="http://schemas.android.com/apk/res/android"
        xmlns:tools="http://schemas.android.com/tools"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#FAFAFA"
        xmlns:app="http://schemas.android.com/apk/res-auto"
        tools:context=".fragment.labsandscanner.AnalysisFragment">

    <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent">

    <com.google.android.material.imageview.ShapeableImageView
            android:id="@+id/iv_arrow"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="15dp"
            android:adjustViewBounds="true"
            android:padding="10dp"
            android:src="@drawable/ic_arrowleft"
            app:layout_constraintBottom_toBottomOf="@+id/tv_search"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="@+id/tv_search" />
    <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/layout_help"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:layout_marginEnd="15dp"
            android:background="@drawable/bg_help"
            android:padding="8dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent">

        <androidx.appcompat.widget.AppCompatTextView
                android:id="@+id/tv_help"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/avenirltstd_roman"
                android:text="@string/help"
                android:textColor="#616161"
                android:textSize="12sp"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="parent" />

        <com.google.android.material.imageview.ShapeableImageView
                android:id="@+id/iv_help"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="5dp"
                android:adjustViewBounds="true"
                android:src="@drawable/ic_help"
                app:layout_constraintEnd_toStartOf="@+id/tv_help"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent" />


    </androidx.constraintlayout.widget.ConstraintLayout>

    <androidx.appcompat.widget.AppCompatTextView
            android:id="@+id/tv_search"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="15dp"
            android:layout_marginTop="20dp"
            android:fontFamily="@font/avenirltstd_black"
            android:text="التحاليل"
            android:textColor="@color/black"
            android:textSize="16sp"
            app:layout_constraintStart_toEndOf="@+id/iv_arrow"
            app:layout_constraintTop_toTopOf="parent" />

    <androidx.core.widget.NestedScrollView
            android:id="@+id/nestedScrollView"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            app:layout_constraintTop_toBottomOf="@+id/tv_search"
            app:layout_constraintBottom_toTopOf="@+id/layout"
            >
        <androidx.constraintlayout.widget.ConstraintLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent">

            <androidx.constraintlayout.widget.ConstraintLayout
                    android:id="@+id/layout_uploadImage"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="20dp"
                    android:layout_marginStart="15dp"
                    android:layout_marginEnd="15dp"
                    android:elevation="2dp"
                    android:background="@drawable/more_cards_background"
                    app:layout_constraintTop_toTopOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent">
                <com.google.android.material.imageview.ShapeableImageView
                        android:id="@+id/iv_services"
                        android:layout_width="45dp"
                        android:layout_height="45dp"
                        android:adjustViewBounds="true"
                        android:src="@drawable/ic_chat"
                        android:layout_marginStart="10dp"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toTopOf="parent"
                        app:layout_constraintBottom_toBottomOf="parent"
                        />
                <TextView
                        android:id="@+id/tv_serviceName"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="55555555"
                        android:gravity="center"
                        android:fontFamily="@font/sf_pro_display_semibold"
                        android:layout_marginStart="5dp"
                        android:layout_marginBottom="@dimen/_3sdp"
                        android:layout_marginTop="@dimen/_8sdp"
                        android:padding="2dp"
                        android:textAppearance="@style/TextAppearance.AppCompat.Headline"
                        android:textColor="@color/black"
                        android:textSize="16sp"
                        app:layout_constraintStart_toEndOf="@+id/iv_services"
                        app:layout_constraintTop_toTopOf="parent"

                        />
                <TextView
                        android:id="@+id/tv_city"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="55555555"
                        android:gravity="center"
                        android:fontFamily="@font/sf_pro_display_semibold"
                        android:layout_marginStart="5dp"
                        android:layout_marginBottom="@dimen/_3sdp"
                        android:layout_marginTop="@dimen/_2sdp"
                        android:padding="2dp"
                        android:textAppearance="@style/TextAppearance.AppCompat.Headline"
                        android:textColor="@color/text_doctor_card_color"
                        android:textSize="14sp"
                        app:layout_constraintStart_toEndOf="@+id/iv_services"
                        app:layout_constraintTop_toBottomOf="@+id/tv_serviceName"

                        />
            </androidx.constraintlayout.widget.ConstraintLayout>
            <TextView
                    android:id="@+id/tv_analaysis"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:elevation="1dp"
                    android:layout_marginTop="10dp"
                    android:layout_marginBottom="20dp"
                    android:layout_marginStart="15dp"
                    android:fontFamily="@font/sf_pro_display_semibold"
                    android:text="@string/bookinglist"
                    android:padding="3dp"
                    android:textColor="@color/blue"
                    android:textSize="20sp"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@+id/layout_uploadImage"
                    tools:text="التحاليل المختارة" />
            <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/rv_analysisPrice"
                    android:layout_width="match_parent"
                    android:layout_height="180dp"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"
                    android:layout_margin="15dp"
                    android:paddingBottom="10dp"
                    app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"
                    app:layout_constraintTop_toBottomOf="@+id/tv_analaysis"
                    app:layout_constraintBottom_toTopOf="@+id/tv_analaysisTime"
                    tools:listitem="@layout/item_layout_analysis_price"
                    />
            <TextView
                    android:id="@+id/tv_analaysisTime"
                    android:layout_width="wrap_content"
                    android:layout_height="40dp"
                    android:elevation="1dp"
                    android:layout_marginTop="10dp"
                    android:layout_marginBottom="20dp"
                    android:layout_marginStart="15dp"
                    android:fontFamily="@font/sf_pro_display_semibold"
                    android:text=""
                    android:gravity="center"
                    android:padding="4dp"
                    android:textColor="@color/white"
                    android:background="@drawable/bg_button_sellector"
                    android:textSize="14sp"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintTop_toBottomOf="@+id/rv_analysisPrice"
                    tools:text="التحاليل المختارة" />
            <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/rv_Calender"
                    android:layout_width="match_parent"
                    android:layout_height="120dp"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"
                    android:layout_marginEnd="15dp"
                    android:layout_marginStart="15dp"
                    android:layout_marginTop="15dp"
                    android:orientation="horizontal"
                    android:visibility="gone"
                    app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"
                    app:layout_constraintTop_toBottomOf="@+id/tv_analaysisTime"
                    tools:listitem="@layout/item_layoutcalendardate"
                    />
            <CalendarView
                    android:id="@+id/calendar"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@+id/tv_analaysisTime"/>

            <TextView
                    android:id="@+id/tv_analaysisInstrucion"
                    android:layout_width="wrap_content"
                    android:layout_height="40dp"
                    android:elevation="1dp"
                    android:layout_marginTop="10dp"
                    android:layout_marginBottom="10dp"
                    android:layout_marginStart="15dp"
                    android:fontFamily="@font/sf_pro_display_semibold"
                    android:text="التعليمات: الصوم لمدة 8 ساعات"
                    android:gravity="center"
                    android:padding="3dp"
                    android:textColor="@color/blue"
                    android:background="@drawable/bg_help"
                    android:textSize="16sp"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@+id/calendar"
                    tools:text="التعليمات: الصوم لمدة 8 ساعات" />
            <TextView
                    android:id="@+id/tv_noAppointement"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/no_availability_found_for_the_given_labid"
                    android:gravity="center"
                    android:layout_marginBottom="@dimen/_3sdp"
                    android:layout_marginTop="@dimen/_3sdp"
                    android:padding="2dp"
                    android:visibility="gone"
                    android:textAppearance="@style/TextAppearance.AppCompat.Headline"
                    android:textColor="@color/red"
                    android:textSize="13sp"
                    app:layout_constraintBottom_toBottomOf="@+id/rv_Calender"
                    app:layout_constraintStart_toStartOf="@+id/rv_Calender"
                    app:layout_constraintEnd_toEndOf="@+id/rv_Calender"
                    app:layout_constraintTop_toTopOf="@+id/rv_Calender"
                    />

            <androidx.constraintlayout.widget.ConstraintLayout
                    android:id="@+id/result"
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/_80sdp"
                    app:layout_constraintBottom_toBottomOf="parent"
                    android:background="@drawable/bg_help"
                    android:visibility="gone"
                    >
                <TextView
                        android:id="@+id/tv_result"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="عدد التحاليل المطلوبة: 2"
                        android:gravity="center"
                        android:layout_marginBottom="@dimen/_3sdp"
                        android:layout_marginTop="@dimen/_3sdp"
                        android:padding="2dp"
                        android:textAppearance="@style/TextAppearance.AppCompat.Headline"
                        android:textColor="@color/blue"
                        android:textSize="13sp"
                        app:layout_constraintBottom_toBottomOf="parent"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintTop_toTopOf="parent"
                        />

            </androidx.constraintlayout.widget.ConstraintLayout>

        </androidx.constraintlayout.widget.ConstraintLayout>

    </androidx.core.widget.NestedScrollView>


    <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/layout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:layout_constraintTop_toBottomOf="@+id/nestedScrollView"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintBottom_toBottomOf="parent"
            android:layout_marginBottom="5dp"
            android:layout_marginTop="10dp">
        <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/btn_booking"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_chooselang_button"
                android:fontFamily="@font/sf_pro_display_semibold"
                android:text="@string/book_now"
                android:textColor="@color/white"
                android:textSize="13sp"
                android:textAllCaps="false"
                android:layout_marginStart="@dimen/_10sdp"
                app:layout_constraintWidth_percent=".80"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintHorizontal_chainStyle="spread_inside" />
    </androidx.constraintlayout.widget.ConstraintLayout>
    <ProgressBar
            android:id="@+id/progress_bar"
            android:layout_width="35dp"
            android:layout_height="wrap_content"
            android:indeterminateTint="@color/white"
            app:layout_constraintEnd_toEndOf="@+id/layout"
            app:layout_constraintStart_toStartOf="@+id/layout"
            app:layout_constraintBottom_toBottomOf="@+id/layout"
            app:layout_constraintTop_toTopOf="@+id/layout"
            android:visibility="gone"
            />

    </androidx.constraintlayout.widget.ConstraintLayout>
    <include
            android:id="@+id/layoutBottomsheetpersistant"
            layout="@layout/item_layout_deleteitem"
            android:visibility="visible"
            />
    <include
            android:id="@+id/layoutBottomsheetpersistantBooking"
            layout="@layout/item_layout_confirm"
            android:visibility="visible"
            />
</androidx.coordinatorlayout.widget.CoordinatorLayout>