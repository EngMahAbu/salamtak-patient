<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">

    <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/layout_doctorsDetail"
            android:layout_width="160dp"
            android:layout_height="wrap_content"
            android:layout_margin="6dp"
            android:background="@drawable/more_cards_background"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent">

        <com.google.android.material.imageview.ShapeableImageView
                android:id="@+id/iv_doctorProfile"
                android:layout_width="60dp"
                android:layout_height="60dp"
                android:layout_margin="@dimen/_5sdp"
                android:visibility="gone"
                android:src="@drawable/ic_docspecialization"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent" />

        <androidx.appcompat.widget.AppCompatTextView
                android:id="@+id/tv_doctorName"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="10dp"
                android:layout_marginTop="10dp"
                android:layout_marginEnd="6dp"
                android:fontFamily="@font/sf_pro_display_semibold"
                android:gravity="start"
                android:text=""
                android:textColor="@color/black"
                android:textSize="13sp"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toEndOf="@+id/iv_doctorProfile"
                app:layout_constraintTop_toTopOf="@+id/iv_doctorProfile" />

        <com.google.android.material.imageview.ShapeableImageView
                android:id="@+id/iv_star"
                android:layout_width="18dp"
                android:layout_height="15dp"
                android:layout_marginStart="10dp"
                android:adjustViewBounds="true"
                android:visibility="gone"
                android:src="@drawable/ic_star"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintStart_toEndOf="@+id/iv_doctorProfile"
                app:layout_constraintTop_toBottomOf="@+id/tv_doctorName" />


        <androidx.appcompat.widget.AppCompatTextView
                android:id="@+id/Reviews"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="5dp"
                android:fontFamily="@font/avenirltstd_roman"
                android:gravity="start"
                android:layout_marginTop="@dimen/_5sdp"
                android:text="8.0"
                android:visibility="gone"
                android:textColor="@color/gray"
                android:textSize="15sp"
                app:layout_constraintStart_toEndOf="@+id/ratingBar"
                app:layout_constraintTop_toBottomOf="@+id/tv_doctorName" />
        <androidx.appcompat.widget.AppCompatTextView
                android:id="@+id/tv_Reviews"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="5dp"
                android:fontFamily="@font/avenirltstd_roman"
                android:gravity="start"
                android:layout_marginTop="@dimen/_5sdp"
                android:text="@string/reviews"
                android:visibility="gone"
                android:textColor="@color/gray"
                android:textSize="15sp"
                app:layout_constraintStart_toEndOf="@+id/Reviews"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/tv_doctorName" />

        <androidx.appcompat.widget.AppCompatRatingBar
                android:id="@+id/ratingBar"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="10dp"
                app:layout_constraintTop_toBottomOf="@+id/tv_doctorName"
                app:layout_constraintStart_toEndOf="@+id/iv_star"
                android:rating="2"
                android:theme="@style/ratingBar"
                android:layout_marginTop="@dimen/_5sdp"
                style="?android:attr/ratingBarStyleSmall"
                android:transformPivotX="0dp"
                android:transformPivotY="0dp"
                android:isIndicator="true"
                android:minHeight="@dimen/_10sdp"
                android:minWidth="@dimen/_5sdp"
        />

        <androidx.appcompat.widget.AppCompatTextView
                android:id="@+id/tv_reviewsDetails"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="10dp"
                android:layout_marginTop="10dp"
                android:layout_marginEnd="10dp"
                android:fontFamily="@font/sd_pro_display_regular"
                android:gravity="start"
                android:text=""
                android:textColor="@color/black"
                android:textSize="15sp"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/ratingBar" />

        <androidx.appcompat.widget.AppCompatTextView
                android:id="@+id/tv_clinicCommit"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="10dp"
                android:layout_marginTop="10dp"
                android:layout_marginEnd="10dp"
                android:fontFamily="@font/sd_pro_display_regular"
                android:gravity="start"
                android:text=""
                android:textColor="@color/text_doctor_card_color"
                android:textSize="14sp"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/tv_reviewsDetails" />

        <androidx.appcompat.widget.AppCompatTextView
                android:id="@+id/tv_reviewsClinics"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="10dp"
                android:layout_marginTop="10dp"
                android:layout_marginEnd="10dp"
                android:layout_marginBottom="@dimen/_10sdp"
                android:fontFamily="@font/avenirltstd_roman"
                android:gravity="start"
                android:text=""
                android:textColor="@color/black"
                android:textSize="15sp"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/tv_clinicCommit" />


    </androidx.constraintlayout.widget.ConstraintLayout>

</layout>