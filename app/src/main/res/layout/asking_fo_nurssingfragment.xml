<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView
        xmlns:android="http://schemas.android.com/apk/res/android"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scrollbars="none"
        android:background="#F4F4F6"
        xmlns:app="http://schemas.android.com/apk/res-auto"
        android:padding="16dp">

    <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

        <androidx.constraintlayout.widget.ConstraintLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
            >
            <com.google.android.material.imageview.ShapeableImageView
                    android:id="@+id/iv_arrow"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="15dp"
                    android:adjustViewBounds="true"
                    android:padding="10dp"
                    android:src="@drawable/ic_arrowleft"
                    app:layout_constraintBottom_toBottomOf="@+id/tv_Filter"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="@+id/tv_Filter" />

            <androidx.appcompat.widget.AppCompatTextView
                    android:id="@+id/tv_Filter"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="15dp"
                    android:layout_marginTop="20dp"
                    android:fontFamily="@font/avenirltstd_black"
                    android:text="Nursing Service Request"
                    android:textColor="@color/black"
                    android:textSize="16sp"
                    app:layout_constraintStart_toEndOf="@+id/iv_arrow"
                    app:layout_constraintTop_toTopOf="parent" />
        </androidx.constraintlayout.widget.ConstraintLayout>


        <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_margin="5dp"
                app:cardBackgroundColor="#FFFFFF"
                app:cardCornerRadius="@dimen/_15sdp">
            <androidx.constraintlayout.widget.ConstraintLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">

                <ImageView
                        android:id="@+id/nursing_image"
                        android:layout_width="match_parent"
                        android:layout_height="160dp"
                        android:scaleType="centerCrop"
                        app:layout_constraintTop_toTopOf="parent"
                        android:src="@drawable/ic_nursing"
                        />
                <TextView
                        android:id="@+id/nursing_Title"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="@font/inter_bold"
                        android:layout_marginStart="15dp"
                        android:textColor="@color/blue"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toBottomOf="@+id/nursing_image"
                        android:text="Professional Nursing Services"
                        android:textSize="16sp"
                        android:paddingTop="8dp"/>
                <TextView
                        android:id="@+id/nursing_Desc"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:fontFamily="@font/inter_regular"
                        android:layout_marginStart="15dp"
                        android:layout_marginEnd="15dp"
                        android:layout_marginBottom="5dp"
                        android:textColor="#475569"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintBottom_toBottomOf="parent"
                        app:layout_constraintTop_toBottomOf="@+id/nursing_Title"
                        android:text="@string/salamtak_app_offers_home_nursing_services"
                        android:textSize="14sp"
                        />

            </androidx.constraintlayout.widget.ConstraintLayout>
        </androidx.cardview.widget.CardView>
        <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/full_name"
                android:fontFamily="@font/inter_semibold"
                android:textColor="@color/color_64748B"
                android:textSize="12sp"
                android:paddingTop="8dp"/>

        <EditText
                android:id="@+id/etPatientName"
                android:layout_width="match_parent"
                android:layout_height="50dp"
                android:layout_marginTop="7dp"
                android:fontFamily="@font/inter_regular"
                android:textSize="11sp"
                android:paddingStart="5dp"
                android:background="@drawable/bg_edittext_box"
                android:hint="@string/full_name_in_english_first_middle_last"
                android:inputType="text"/>

        <!-- Mobile Number -->
        <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Mobile Number"
                android:fontFamily="@font/inter_semibold"
                android:textColor="@color/color_64748B"
                android:textSize="12sp"
                android:paddingTop="8dp"/>

        <EditText
                android:id="@+id/etMobileNumber"
                android:layout_width="match_parent"
                android:layout_height="50dp"
                android:fontFamily="@font/inter_regular"
                android:textSize="11sp"
                android:paddingStart="5dp"
                android:background="@drawable/bg_edittext_box"
                android:hint="Mobile Number: (+2)"
                android:inputType="phone"/>
        <androidx.constraintlayout.widget.ConstraintLayout
                android:id="@+id/layout_Location_Details"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="5dp"
                android:visibility="visible"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/layout_Choose_Specialization">

            <androidx.appcompat.widget.AppCompatButton
                    android:id="@+id/btn_layout_Choose_City"
                    android:layout_width="0dp"
                    android:layout_height="0dp"
                    android:background="@android:color/transparent"
                    app:layout_constraintEnd_toEndOf="@+id/layout_Choose_City"
                    app:layout_constraintStart_toStartOf="@+id/layout_Choose_City"
                    app:layout_constraintTop_toTopOf="@+id/layout_Choose_City"
                    app:layout_constraintBottom_toBottomOf="@+id/layout_Choose_City" />

            <androidx.appcompat.widget.AppCompatButton
                    android:id="@+id/btn_layout_Choose_Area"
                    android:layout_width="0dp"
                    android:layout_height="0dp"
                    android:background="@android:color/transparent"
                    app:layout_constraintEnd_toEndOf="@+id/layout_Choose_Area"
                    app:layout_constraintStart_toStartOf="@+id/layout_Choose_Area"
                    app:layout_constraintTop_toTopOf="@+id/layout_Choose_Area"
                    app:layout_constraintBottom_toBottomOf="@+id/layout_Choose_Area" />

            <androidx.constraintlayout.widget.ConstraintLayout
                    android:id="@+id/layout_Choose_City"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:layout_marginEnd="15dp"
                    android:background="@drawable/bg_edittext_box"
                    android:elevation="1dp"
                    app:layout_constraintEnd_toStartOf="@+id/layout_Choose_Area"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent">

                <androidx.appcompat.widget.AppCompatImageView
                        android:id="@+id/iv_arrowdownChoose_City"
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        android:layout_gravity="center_horizontal"
                        android:layout_marginEnd="12dp"
                        android:layout_marginBottom="12dp"
                        android:gravity="start"
                        android:src="@drawable/ic_arrowdwon"
                        android:tint="@color/color_64748B"
                        app:layout_constraintBottom_toBottomOf="parent"
                        app:layout_constraintEnd_toEndOf="parent" />

                <com.google.android.material.textfield.TextInputLayout
                        android:id="@+id/textinput_Choose_City"
                        style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                        android:layout_width="match_parent"
                        android:layout_height="55dp"
                        android:layout_marginEnd="25dp"
                        android:layout_marginBottom="5dp"
                        android:hint="@string/choose_city"
                        android:paddingTop="4dp"
                        app:boxBackgroundColor="@color/white"
                        app:boxBackgroundMode="none"
                        app:layout_constraintBottom_toBottomOf="parent"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toTopOf="parent">

                    <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/et_Choose_City"
                            android:layout_width="match_parent"
                            android:layout_height="55dp"
                            android:layout_gravity="center_horizontal"
                            android:fontFamily="@font/avenirltstd_roman"
                            android:inputType="text"
                            android:enabled="false"
                            android:textColor="@color/black"
                            android:textSize="13sp" />

                </com.google.android.material.textfield.TextInputLayout>

            </androidx.constraintlayout.widget.ConstraintLayout>
            <androidx.appcompat.widget.AppCompatTextView
                    android:id="@+id/tv_cityError"
                    android:layout_width="wrap_content"
                    android:layout_height="20dp"
                    android:layout_marginTop="5dp"
                    android:layout_marginBottom="5dp"
                    android:layout_marginStart="15dp"
                    android:fontFamily="@font/avenirltstd_roman"
                    android:gravity="center"
                    android:padding="1dp"
                    android:text="55555"
                    android:textColor="@color/red"
                    android:textSize="12sp"
                    android:visibility="gone"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintBottom_toTopOf="@+id/layout_Choose_Area"
                    app:layout_constraintTop_toBottomOf="@+id/layout_Choose_City" />

            <androidx.constraintlayout.widget.ConstraintLayout
                    android:id="@+id/layout_Choose_Area"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="15dp"
                    android:layout_marginTop="12dp"
                    android:layout_marginBottom="10dp"
                    android:background="@drawable/bg_edittext_box"
                    android:elevation="1dp"
                    app:layout_constraintTop_toTopOf="parent"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toEndOf="@+id/layout_Choose_City"
                    >

                <androidx.appcompat.widget.AppCompatImageView
                        android:id="@+id/iv_arrowdownArea"
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        android:layout_gravity="center_horizontal"
                        android:layout_marginEnd="12dp"
                        android:layout_marginBottom="12dp"
                        android:gravity="start"
                        android:src="@drawable/ic_arrowdwon"
                        android:tint="@color/color_64748B"
                        app:layout_constraintBottom_toBottomOf="parent"
                        app:layout_constraintEnd_toEndOf="parent" />

                <com.google.android.material.textfield.TextInputLayout
                        android:id="@+id/textinput_Choose_Area"
                        style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                        android:layout_width="match_parent"
                        android:layout_height="55dp"
                        android:layout_marginEnd="25dp"
                        android:layout_marginBottom="5dp"
                        android:hint="@string/choose_area"
                        android:paddingTop="4dp"
                        app:boxBackgroundColor="@color/white"
                        app:boxBackgroundMode="none"
                        app:layout_constraintBottom_toBottomOf="parent"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toTopOf="parent">

                    <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/et_Choose_Area"
                            android:layout_width="match_parent"
                            android:layout_height="55dp"
                            android:layout_gravity="center_horizontal"
                            android:fontFamily="@font/avenirltstd_roman"
                            android:inputType="text"
                            android:enabled="false"
                            android:textColor="@color/black"
                            android:textSize="13sp" />

                </com.google.android.material.textfield.TextInputLayout>

            </androidx.constraintlayout.widget.ConstraintLayout>
            <androidx.appcompat.widget.AppCompatTextView
                    android:id="@+id/tv_areaError"
                    android:layout_width="wrap_content"
                    android:layout_height="20dp"
                    android:layout_marginTop="5dp"
                    android:layout_marginBottom="5dp"
                    android:layout_marginStart="15dp"
                    android:fontFamily="@font/avenirltstd_roman"
                    android:gravity="center"
                    android:padding="1dp"
                    android:text="55555"
                    android:textColor="@color/red"
                    android:textSize="12sp"
                    android:visibility="gone"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintTop_toBottomOf="@+id/layout_Choose_Area" />


        </androidx.constraintlayout.widget.ConstraintLayout>
        <!-- Address -->
        <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Address"
                android:fontFamily="@font/inter_semibold"
                android:textColor="@color/color_64748B"
                android:textSize="12sp"
                android:paddingTop="8dp"/>

        <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:weightSum="4"
                android:paddingTop="4dp">

            <EditText
                    android:id="@+id/etStreetName"
                    android:layout_width="156dp"
                    android:layout_height="50dp"
                    android:fontFamily="@font/inter_regular"
                    android:textSize="11sp"
                    android:paddingStart="15dp"
                    android:layout_marginEnd="5dp"
                    android:background="@drawable/bg_edittext_box"
                    android:layout_weight="1"
                    android:hint="Street Name "
                    android:textColorHint="@color/Color_0f172a"
                    android:focusable="false"/>

            <EditText
                    android:id="@+id/etBuilding"
                    android:layout_width="156dp"
                    android:layout_height="50dp"
                    android:fontFamily="@font/inter_regular"
                    android:textSize="11sp"
                    android:paddingStart="15dp"
                    android:layout_marginEnd="5dp"
                    android:background="@drawable/bg_edittext_box"
                    android:layout_weight="1"
                    android:hint="Building#"
                    android:textColorHint="@color/Color_0f172a"
                    android:focusable="false"/>
            <EditText
                    android:id="@+id/etFloor"
                    android:layout_width="156dp"
                    android:layout_height="50dp"
                    android:fontFamily="@font/inter_regular"
                    android:textSize="11sp"
                    android:paddingStart="15dp"
                    android:layout_marginEnd="5dp"
                    android:background="@drawable/bg_edittext_box"
                    android:layout_weight="1"
                    android:hint="Floor #"
                    android:textColorHint="@color/Color_0f172a"
                    android:focusable="false"/>
            <EditText
                    android:id="@+id/etApartment"
                    android:layout_width="156dp"
                    android:layout_height="50dp"
                    android:fontFamily="@font/inter_regular"
                    android:textSize="11sp"
                    android:paddingStart="15dp"
                    android:layout_marginEnd="5dp"
                    android:background="@drawable/bg_edittext_box"
                    android:layout_weight="1"
                    android:hint="Apartment #"
                    android:textColorHint="@color/Color_0f172a"
                    android:focusable="false"/>
        </LinearLayout>
        <!-- Nurse Request -->
        <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Service Level"
                android:fontFamily="@font/inter_semibold"
                android:textColor="@color/color_64748B"
                android:textSize="12sp"
                android:paddingTop="8dp"/>

        <androidx.constraintlayout.widget.ConstraintLayout
                android:id="@+id/layout_Choose_serviceLevel"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:background="@drawable/bg_edittext_box"
                android:elevation="1dp"
               >


        <androidx.appcompat.widget.AppCompatImageView
                android:id="@+id/iv_arrowdownChoose_serviceLevel"
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:layout_gravity="center_horizontal"
                android:layout_marginEnd="12dp"
                android:layout_marginBottom="12dp"
                android:gravity="start"
                android:src="@drawable/ic_arrowdwon"
                android:tint="@color/color_64748B"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent" />

        <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/textinput_serviceLevel"
                style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                android:layout_width="match_parent"
                android:layout_height="55dp"
                android:layout_marginEnd="25dp"
                android:layout_marginBottom="5dp"
                android:hint="choose_Service Level"
                android:paddingTop="4dp"
                app:boxBackgroundColor="@color/white"
                app:boxBackgroundMode="none"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent">

            <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/et_serviceLevel"
                    android:layout_width="match_parent"
                    android:layout_height="55dp"
                    android:layout_gravity="center_horizontal"
                    android:fontFamily="@font/avenirltstd_roman"
                    android:inputType="text"
                    android:enabled="false"
                    android:textColor="@color/black"
                    android:textSize="13sp" />

        </com.google.android.material.textfield.TextInputLayout>
        </androidx.constraintlayout.widget.ConstraintLayout>
        <!-- Gender -->
        <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Gender"
                android:fontFamily="@font/inter_semibold"
                android:textColor="@color/color_64748B"
                android:textSize="12sp"
                android:paddingTop="8dp"/>

        <RadioGroup
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textSize="14sp"
                android:textColor="@color/Color_0f172a"
                android:orientation="horizontal">

            <RadioButton
                    android:id="@+id/rbMale"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textSize="14sp"
                    android:layout_marginEnd="15dp"
                    android:textColor="@color/Color_0f172a"
                    android:buttonTint="@color/colortint_cbd5e1"
                    android:text="Male"/>

            <RadioButton
                    android:id="@+id/rbFemale"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textSize="14sp"
                    android:buttonTint="@color/colortint_cbd5e1"
                    android:textColor="@color/Color_0f172a"
                    android:text="Female"/>
        </RadioGroup>


        <!-- Number of Days -->
        <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Number of Days"
                android:fontFamily="@font/inter_semibold"
                android:textColor="@color/color_64748B"
                android:textSize="12sp"
                android:paddingTop="8dp"/>
        <EditText
                android:id="@+id/etNumberofDays"
                android:layout_width="match_parent"
                android:layout_height="50dp"
                android:layout_marginTop="8dp"
                android:fontFamily="@font/inter_regular"
                android:textSize="16sp"
                android:paddingStart="5dp"
                android:background="@drawable/bg_edittext_box"
                android:hint="nursing service duration"
                android:inputType="textPostalAddress"/>
        <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:weightSum="2"
                android:paddingTop="4dp">

            <TextView
                    android:id="@+id/FromDate"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/inter_semibold"
                    android:textColor="@color/color_64748B"
                    android:textSize="12sp"
                    android:layout_marginEnd="15dp"
                    android:paddingTop="8dp"
                    android:text="From Date"
                    android:layout_weight="1"
                    />

            <TextView
                    android:id="@+id/ToDate"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/inter_semibold"
                    android:textColor="@color/color_64748B"
                    android:textSize="12sp"
                    android:paddingTop="8dp"
                    android:text="To Date"
                    android:layout_weight="1"/>
        </LinearLayout>

        <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:weightSum="2"
                android:paddingTop="4dp">

            <EditText
                    android:id="@+id/etFromDate"
                    android:layout_width="156dp"
                    android:layout_height="50dp"
                    android:fontFamily="@font/inter_regular"
                    android:textSize="16sp"
                    android:paddingStart="15dp"
                    android:layout_marginEnd="15dp"
                    android:background="@drawable/bg_edittext_box"
                    android:layout_weight="1"
                    android:hint="mm/dd/yyyy"
                    android:textColorHint="@color/Color_0f172a"
                    android:focusable="false"/>

            <EditText
                    android:id="@+id/etToDate"
                    android:layout_width="156dp"
                    android:layout_height="50dp"
                    android:fontFamily="@font/inter_regular"
                    android:textSize="16sp"
                    android:paddingStart="15dp"
                    android:background="@drawable/bg_edittext_box"
                    android:layout_weight="1"
                    android:hint="mm/dd/yyyy"
                    android:textColorHint="@color/Color_0f172a"
                    android:focusable="false"/>
        </LinearLayout>
        <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:weightSum="2"
                android:paddingTop="4dp">

            <TextView
                    android:id="@+id/FromTime"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/inter_semibold"
                    android:textColor="@color/color_64748B"
                    android:textSize="12sp"
                    android:layout_marginEnd="15dp"
                    android:paddingTop="8dp"
                    android:text="From Time"
                    android:layout_weight="1"
                    />

            <TextView
                    android:id="@+id/ToTime"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/inter_semibold"
                    android:textColor="@color/color_64748B"
                    android:textSize="12sp"
                    android:paddingTop="8dp"
                    android:text="To Time"
                    android:layout_weight="1"/>
        </LinearLayout>

        <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:weightSum="2"
                android:paddingTop="4dp">

            <EditText
                    android:id="@+id/etFromTime"
                    android:layout_width="156dp"
                    android:layout_height="50dp"
                    android:layout_marginEnd="15dp"
                    android:fontFamily="@font/inter_regular"
                    android:textSize="16sp"
                    android:paddingStart="15dp"
                    android:background="@drawable/bg_edittext_box"
                    android:layout_weight="1"
                    android:hint="--:--"
                    android:textColorHint="@color/Color_0f172a"
                    android:focusable="false"/>

            <EditText
                    android:id="@+id/etToTime"
                    android:layout_width="156dp"
                    android:layout_height="50dp"
                    android:fontFamily="@font/inter_regular"
                    android:textSize="16sp"
                    android:paddingStart="15dp"
                    android:background="@drawable/bg_edittext_box"
                    android:layout_weight="1"
                    android:hint="--:--"
                    android:textColorHint="@color/Color_0f172a"
                    android:focusable="false"/>
        </LinearLayout>


        <!-- Send Button -->
        <androidx.constraintlayout.widget.ConstraintLayout
                android:id="@+id/layout"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/all_layout"
                app:layout_constraintWidth_percent=".95"
                android:padding="8dp"
                >
            <androidx.appcompat.widget.AppCompatButton
                    android:id="@+id/btn_send"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_chooselang_button"
                    android:fontFamily="@font/avenirltstd_black"
                    android:padding="5dp"
                    android:text="@string/send"
                    android:textAllCaps="false"
                    android:textColor="@color/white"
                    android:textSize="14sp"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent"

                    />
        </androidx.constraintlayout.widget.ConstraintLayout>
    </LinearLayout>
</androidx.core.widget.NestedScrollView>
