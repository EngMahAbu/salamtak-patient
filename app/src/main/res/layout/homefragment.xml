<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
        xmlns:android="http://schemas.android.com/apk/res/android"
        xmlns:tools="http://schemas.android.com/tools"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:padding="2dp"
        android:background="@color/bg_color_gray"
        xmlns:app="http://schemas.android.com/apk/res-auto"
        tools:context=".fragment.home.HomeFragment">

    <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:padding="3dp">

        <androidx.appcompat.widget.AppCompatTextView
                android:id="@+id/tv_patientname"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:fontFamily="@font/avenirltstd_black"
                android:gravity="center"
                android:padding="2dp"
                android:layout_marginBottom="10dp"
                android:layout_marginStart="14dp"
                android:text="Osama"
                android:textColor="@color/black"
                android:textSize="14sp"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/tv_Welcome"
        />

        <androidx.appcompat.widget.AppCompatTextView
                android:id="@+id/tv_city"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/sd_pro_display_regular"
                android:gravity="center"
                android:textFontWeight="@integer/material_motion_duration_long_1"
                android:padding="1dp"
                android:layout_marginStart="14dp"
                android:layout_marginEnd="@dimen/_3sdp"
                android:text="cairo"
                android:textColor="#8088A4"
                android:textSize="20sp"
                app:layout_constraintEnd_toStartOf="@+id/iv_selectCity"
                app:layout_constraintTop_toTopOf="@+id/iv_selectCity"
                app:layout_constraintBottom_toBottomOf="@+id/iv_selectCity"
                />
        <com.google.android.material.imageview.ShapeableImageView
                android:id="@+id/iv_selectCity"
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:layout_marginTop="10dp"
                android:layout_marginEnd="15dp"
                app:srcCompat="@drawable/new_arrow_down"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="parent"/>

        <androidx.appcompat.widget.AppCompatTextView
                android:id="@+id/tv_Welcome"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:fontFamily="@font/avenirltstd_roman"
                android:gravity="center"
                android:padding="2dp"
                android:layout_marginStart="15dp"
                android:text="os"
                android:textColor="@color/dark_grey"
                android:textSize="12sp"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"
        />
        <com.airbnb.lottie.LottieAnimationView
                android:id="@+id/iv_message"
                android:layout_width="55dp"
                android:layout_height="55dp"
                android:layout_marginTop="10dp"
                app:lottie_rawRes="@raw/alarm"
                app:lottie_autoPlay="false"
                android:visibility="gone"
                app:lottie_loop="true"
                app:layout_constraintEnd_toStartOf="@+id/iv_notification"
                app:layout_constraintTop_toTopOf="parent"
                />
        <ImageView
                android:id="@+id/iv_messageroundbg"
                android:layout_width="15dp"
                android:layout_height="15dp"
                android:layout_marginStart="12dp"
                android:visibility="gone"
                app:layout_constraintTop_toTopOf="@+id/iv_message"
                app:layout_constraintBottom_toTopOf="@+id/iv_message"
                app:layout_constraintStart_toStartOf="@+id/iv_message"
                app:layout_constraintVertical_bias="0.0"
                app:srcCompat="@drawable/red_round_bg" />
        <androidx.appcompat.widget.AppCompatTextView
                android:id="@+id/tv_numberOfDoctorNotification"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/avenirltstd_book"
                android:gravity="center"
                android:text=""
                android:textColor="@color/white"
                android:textSize="10sp"
                app:layout_constraintStart_toStartOf="@id/iv_messageroundbg"
                app:layout_constraintTop_toTopOf="@+id/iv_messageroundbg"
                app:layout_constraintBottom_toBottomOf="@+id/iv_messageroundbg"
                app:layout_constraintEnd_toEndOf="@+id/iv_messageroundbg"
                />

        <com.google.android.material.imageview.ShapeableImageView
                android:id="@+id/iv_welcome"
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:adjustViewBounds="true"
                android:layout_marginTop="20dp"
                android:visibility="gone"
                android:src="@drawable/ic_welcome"
                app:layout_constraintStart_toEndOf="@+id/tv_Welcome"
                app:layout_constraintTop_toTopOf="parent"/>

        <com.google.android.material.imageview.ShapeableImageView
                android:id="@+id/iv_notification"
                android:layout_width="28dp"
                android:layout_height="28dp"
                android:adjustViewBounds="true"
                android:layout_marginTop="20dp"
                android:layout_marginEnd="15dp"
                android:visibility="gone"
                android:src="@drawable/ic_notify"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="parent"/>
        <ImageView
                android:id="@+id/iv_roundbg"
                android:layout_width="18dp"
                android:layout_height="18dp"
                android:layout_marginEnd="8dp"
                android:layout_marginStart="12dp"
                android:layout_marginTop="5dp"
                android:visibility="gone"
                app:layout_constraintBottom_toTopOf="@+id/iv_notification"
                app:layout_constraintTop_toTopOf="@+id/iv_notification"
                app:layout_constraintStart_toStartOf="@+id/iv_notification"
                app:srcCompat="@drawable/red_round_bg"/>
        <androidx.appcompat.widget.AppCompatTextView
                android:id="@+id/tv_numberOfNotification"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/avenirltstd_book"
                android:gravity="center"
                android:text=""
                android:textColor="@color/white"
                android:textSize="10sp"
                app:layout_constraintStart_toStartOf="@id/iv_roundbg"
                app:layout_constraintTop_toTopOf="@+id/iv_roundbg"
                app:layout_constraintBottom_toBottomOf="@+id/iv_roundbg"
                app:layout_constraintEnd_toEndOf="@+id/iv_roundbg"
                />

        <!--    <androidx.constraintlayout.widget.ConstraintLayout-->
        <!--        android:layout_width="match_parent"-->
        <!--        android:layout_height="0dp"-->
        <!--        android:layout_marginTop="10dp"-->
        <!--        app:layout_constraintStart_toStartOf="parent"-->
        <!--        app:layout_constraintEnd_toEndOf="parent"-->
        <!--        app:layout_constraintTop_toBottomOf="@+id/iv_PatientProfile"-->
        <!--        app:layout_constraintBottom_toBottomOf="parent"-->
        <!--        >-->

        <androidx.constraintlayout.widget.ConstraintLayout
                android:id="@+id/layout_signup"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_help"
                android:layout_marginTop="10dp"
                android:layout_marginStart="14dp"
                android:layout_marginEnd="10dp"
                app:layout_constraintTop_toBottomOf="@+id/tv_patientname">

            <androidx.appcompat.widget.AppCompatTextView
                    android:id="@+id/tv_sign_up"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/avenirltstd_black"
                    android:gravity="center"
                    android:padding="2dp"
                    android:layout_marginTop="5dp"
                    android:layout_marginBottom="10dp"
                    android:layout_marginStart="10dp"
                    android:text="@string/sign_up"
                    android:textColor="@color/black"
                    android:textSize="14sp"
                    app:layout_constraintTop_toTopOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
            />

            <androidx.appcompat.widget.AppCompatTextView
                    android:id="@+id/tv_YoumustSignUptobookyourdoctor"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/avenirltstd_roman"
                    android:gravity="center"
                    android:padding="2dp"
                    android:layout_marginBottom="10dp"
                    android:layout_marginStart="10dp"
                    android:layout_marginTop="5dp"
                    android:text="@string/signupedit"
                    android:textColor="@color/black"
                    android:textSize="12sp"
                    app:layout_constraintTop_toBottomOf="@+id/tv_sign_up"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintBottom_toBottomOf="parent"/>

            <com.google.android.material.imageview.ShapeableImageView
                    android:id="@+id/iv_arrow"
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:adjustViewBounds="true"
                    android:layout_marginTop="20dp"
                    android:layout_marginEnd="10dp"
                    android:src="@drawable/ic_arrow_blue"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintTop_toTopOf="parent"/>

            />

        </androidx.constraintlayout.widget.ConstraintLayout>


        <androidx.core.widget.NestedScrollView
                android:layout_width="match_parent"
                android:layout_height="0dp"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/layout_signup"
                app:layout_constraintBottom_toBottomOf="parent"
                android:layout_marginTop="10dp"
        >
            <androidx.constraintlayout.widget.ConstraintLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:padding="2dp"
            >

                <androidx.constraintlayout.widget.ConstraintLayout
                        android:id="@+id/layout_completeProfile"
                        android:layout_width="match_parent"
                        android:layout_height="90dp"
                        android:layout_marginStart="15dp"
                        android:layout_marginTop="28dp"
                        android:layout_marginEnd="15dp"
                        android:visibility="gone"
                        android:background="@drawable/bg_completeprofile"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintHorizontal_bias="1.0"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toTopOf="parent">

                    <com.google.android.material.imageview.ShapeableImageView
                            android:id="@+id/iv_arrowRight"
                            android:layout_width="30dp"
                            android:layout_height="30dp"
                            android:adjustViewBounds="true"
                            android:layout_marginEnd="15dp"
                            android:src="@drawable/ic_arrow_right"
                            app:layout_constraintEnd_toEndOf="parent"
                            app:layout_constraintTop_toTopOf="parent"
                            app:layout_constraintBottom_toBottomOf="parent"
                    />

                    <ProgressBar
                            android:id="@+id/circular_determinative_pb"
                            android:layout_width="60dp"
                            android:layout_height="60dp"
                            android:layout_margin="10dp"
                            android:indeterminateOnly="false"
                            android:max="100"
                            android:progress="40"
                            android:progressDrawable="@drawable/bg_progressbar"
                            android:secondaryProgress="100"
                            app:layout_constraintStart_toStartOf="parent"
                            app:layout_constraintTop_toTopOf="parent"/>

                    <TextView
                            android:id="@+id/ratio_tv"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:fontFamily="@font/avenirltstd_black"
                            android:text="40%"
                            android:textColor="@color/color_primary"
                            android:textSize="14sp"
                            app:layout_constraintStart_toStartOf="@+id/circular_determinative_pb"
                            app:layout_constraintBottom_toBottomOf="@id/circular_determinative_pb"
                            app:layout_constraintTop_toTopOf="@id/circular_determinative_pb"
                            app:layout_constraintEnd_toEndOf="@+id/circular_determinative_pb"/>

                    <androidx.appcompat.widget.AppCompatTextView
                            android:id="@+id/tv_completeProfile"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:fontFamily="@font/avenirltstd_black"
                            android:gravity="center"
                            android:padding="2dp"
                            android:layout_marginTop="5dp"
                            android:layout_marginStart="5dp"
                            android:text="@string/complete_your_profile"
                            android:textColor="@color/black"
                            android:textSize="15sp"
                            app:layout_constraintStart_toEndOf="@+id/circular_determinative_pb"
                            app:layout_constraintTop_toTopOf="@+id/circular_determinative_pb"
                    />
                    <androidx.appcompat.widget.AppCompatTextView
                            android:id="@+id/tv_yourcompleteProfile"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:fontFamily="@font/avenirltstd_roman"
                            android:gravity="start"
                            android:padding="2dp"
                            android:layout_marginEnd="10dp"
                            android:layout_marginStart="5dp"
                            android:text="@string/you_must_complete_your_profile_to_can_book_your_doctor"
                            android:textColor="@color/black"
                            android:textSize="12sp"
                            app:layout_constraintStart_toEndOf="@+id/circular_determinative_pb"
                            app:layout_constraintTop_toBottomOf="@+id/tv_completeProfile"
                            app:layout_constraintEnd_toStartOf="@+id/iv_arrowRight"
                    />

                </androidx.constraintlayout.widget.ConstraintLayout>


                <EditText
                        android:id="@+id/et_search"
                        android:layout_width="match_parent"
                        android:layout_height="50dp"
                        android:layout_marginTop="10dp"
                        android:padding="5dp"
                        android:layout_marginStart="15dp"
                        android:layout_marginEnd="15dp"
                        android:drawableStart="@drawable/icon_search"
                        android:drawablePadding="5dp"
                        android:autofillHints=""
                        android:focusable="false"
                        android:visibility="gone"
                        android:hint="@string/search_by_doctor_name"
                        android:inputType="text"
                        android:background="@drawable/bg_edittext"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toBottomOf="@+id/layout_completeProfile"/>
                <androidx.viewpager2.widget.ViewPager2
                        android:id="@+id/view_pager"
                        android:layout_width="match_parent"
                        android:layout_height="150dp"
                        android:layout_marginStart="15dp"
                        android:layout_marginTop="20dp"
                        android:layout_marginEnd="15dp"
                         android:visibility="visible"
                        android:orientation="horizontal"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toBottomOf="@+id/et_search"
                />
                <ImageView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:src="@drawable/imageadvertising"
                        android:elevation="@dimen/_5sdp"
                        android:adjustViewBounds="true"
                        android:layout_marginStart="14dp"
                        android:layout_marginEnd="18dp"
                        app:layout_constraintEnd_toEndOf="@+id/view_pager"
                        app:layout_constraintStart_toStartOf="@+id/view_pager"
                        app:layout_constraintTop_toTopOf="@+id/view_pager"
                        app:layout_constraintBottom_toBottomOf="@+id/view_pager"
                        />

                <ProgressBar
                        android:id="@+id/progress_bar"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        app:layout_constraintEnd_toEndOf="@+id/rv_top_Specilaist"
                        app:layout_constraintStart_toStartOf="@+id/rv_top_Specilaist"
                        app:layout_constraintBottom_toBottomOf="@+id/rv_top_Specilaist"
                        app:layout_constraintTop_toTopOf="@+id/rv_top_Specilaist"
                        android:visibility="gone"
                />
                <androidx.appcompat.widget.AppCompatTextView
                        android:id="@+id/tv_SalamtakServices"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:fontFamily="@font/sf_pro_display_semibold"
                        android:gravity="start"
                        android:padding="2dp"
                        android:layout_marginTop="8dp"
                        android:layout_marginStart="15dp"
                        android:text="@string/salamtak_services"
                        android:textColor="@color/black"
                        android:textSize="20sp"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toBottomOf="@+id/view_pager"
                />
                <androidx.recyclerview.widget.RecyclerView
                        android:id="@+id/rv_SalamtakServices"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintEnd_toEndOf="parent"
                        android:layout_margin="13dp"
                        android:paddingBottom="20dp"
                        app:layoutManager="androidx.recyclerview.widget.GridLayoutManager"
                        app:layout_constraintTop_toBottomOf="@+id/tv_SalamtakServices"
                />

                <androidx.appcompat.widget.AppCompatTextView
                        android:id="@+id/tv_chooseSpecility"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:fontFamily="@font/sf_pro_display_semibold"
                        android:gravity="start"
                        android:padding="2dp"
                        android:layout_marginTop="8dp"
                        android:layout_marginStart="15dp"
                        android:text="@string/choose_specialization"
                        android:textColor="@color/black"
                        android:textSize="20sp"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toBottomOf="@+id/rv_SalamtakServices"
                        />
                <androidx.appcompat.widget.AppCompatTextView
                        android:id="@+id/tv_SeeAll"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:fontFamily="@font/sd_pro_display_regular"
                        android:gravity="start"
                        android:padding="2dp"
                        android:layout_marginTop="8dp"
                        android:layout_marginEnd="15dp"
                        android:text="@string/seeall"
                        android:textColor="@color/green"
                        android:textSize="16sp"
                        app:layout_constraintBottom_toBottomOf="@+id/tv_chooseSpecility"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintTop_toBottomOf="@+id/rv_SalamtakServices"
                        />
                <androidx.recyclerview.widget.RecyclerView
                        android:id="@+id/rv_top_Specilaist"
                        android:layout_width="0dp"
                        android:layout_height="@dimen/_70sdp"
                        app:layout_constraintStart_toStartOf="parent"
                        android:layout_marginStart="14dp"
                        android:layout_marginTop="8dp"
                        android:orientation="horizontal"
                        app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"
                        tools:listitem="@layout/item_layout_top_speciality"
                        app:layout_constraintTop_toBottomOf="@+id/tv_chooseSpecility"
                        app:layout_constraintEnd_toEndOf="parent"
                        />

                <androidx.recyclerview.widget.RecyclerView
                        android:id="@+id/rv_PopularDoctors"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintEnd_toEndOf="parent"
                        android:layout_marginStart="14dp"
                        android:layout_marginEnd="15dp"
                        android:paddingBottom="10dp"
                        tools:listitem="@layout/item_layout_poulardoctors"
                        app:layoutManager="androidx.recyclerview.widget.GridLayoutManager"
                        app:layout_constraintTop_toBottomOf="@+id/rv_top_Specilaist"
                        />

                <androidx.appcompat.widget.AppCompatTextView
                        android:id="@+id/tv_Medical_ServicesDirectory"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:fontFamily="@font/sf_pro_display_semibold"
                        android:gravity="start"
                        android:padding="2dp"
                        android:layout_marginTop="10dp"
                        android:layout_marginStart="15dp"
                        android:text="@string/medical_services_directory"
                        android:textColor="@color/black"
                        android:textSize="20sp"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toBottomOf="@+id/layout_doctorsDetail"
                />

                <androidx.recyclerview.widget.RecyclerView
                        android:id="@+id/rv_SalamtakmedicalServices"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintEnd_toEndOf="parent"
                        android:layout_marginStart="14dp"
                        android:layout_marginTop="15dp"
                        tools:listitem="@layout/item_layout_medicalrvservices"
                        app:layout_constraintTop_toBottomOf="@+id/tv_Medical_ServicesDirectory"
                />

                <androidx.constraintlayout.widget.ConstraintLayout
                        android:id="@+id/layout_doctorsDetail"
                        android:layout_width="match_parent"
                        android:layout_height="150dp"
                        android:layout_marginTop="8dp"
                        android:layout_marginStart="14dp"
                        android:layout_marginEnd="14dp"
                        android:background="@drawable/bg_button_sellector"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toBottomOf="@+id/rv_PopularDoctors">

                    <com.google.android.material.imageview.ShapeableImageView
                            android:id="@+id/iv_doctorProfile"
                            android:layout_width="wrap_content"
                            android:layout_height="50dp"
                            android:layout_marginStart="15dp"
                            android:layout_marginTop="12dp"
                            android:layoutDirection="locale"
                            android:src="@drawable/ic_salamtakask"
                            app:layout_constraintStart_toStartOf="parent"
                            app:layout_constraintTop_toTopOf="parent"
                    />
                    <com.google.android.material.imageview.ShapeableImageView
                            android:id="@+id/iv_imageSalamtakDoctor"
                            android:layout_width="wrap_content"
                            android:layout_height="0dp"
                            android:adjustViewBounds="true"
                            android:scaleType="fitCenter"
                            android:layoutDirection="locale"
                            android:src="@drawable/new_image_salamtakdoctor"
                            app:layout_constraintEnd_toEndOf="parent"
                            app:layout_constraintTop_toTopOf="parent"
                            app:layout_constraintBottom_toBottomOf="parent"
                    />

                    <androidx.appcompat.widget.AppCompatTextView
                            android:id="@+id/tv_doctorName"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginEnd="10dp"
                            android:layout_marginTop="5dp"
                            android:layout_marginStart="15dp"
                            android:fontFamily="@font/sd_pro_display_regular"
                            android:gravity="start"
                            android:lines="2"
                            android:text="@string/have_amedicalquestion"
                            android:textColor="@color/white"
                            android:textSize="11sp"
                            app:layout_constraintEnd_toStartOf="@+id/iv_imageSalamtakDoctor"
                            app:layout_constraintStart_toStartOf="parent"
                            app:layout_constraintTop_toBottomOf="@+id/iv_doctorProfile"/>

                    <androidx.constraintlayout.widget.ConstraintLayout
                            android:id="@+id/ask_question"
                            android:layout_width="80dp"
                            android:layout_height="wrap_content"
                            android:background="@drawable/bg_help"
                            android:padding="7dp"
                            android:layout_marginStart="15dp"
                            android:layout_marginBottom="15dp"
                            app:layout_constraintStart_toStartOf="parent"
                            app:layout_constraintBottom_toBottomOf="parent"
                    >

                        <androidx.appcompat.widget.AppCompatTextView
                                android:id="@+id/tv_help"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:fontFamily="@font/avenirltstd_roman"
                                android:text="@string/ask_now"
                                android:textColor="@color/blue"
                                android:textSize="13sp"
                                app:layout_constraintBottom_toBottomOf="parent"
                                app:layout_constraintEnd_toEndOf="parent"
                                app:layout_constraintStart_toStartOf="parent"
                                app:layout_constraintTop_toTopOf="parent"/>


                    </androidx.constraintlayout.widget.ConstraintLayout>


                </androidx.constraintlayout.widget.ConstraintLayout>


                <androidx.appcompat.widget.AppCompatTextView
                        android:id="@+id/tv_HealthTopics"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:fontFamily="@font/sf_pro_display_semibold"
                        android:gravity="start"
                        android:padding="2dp"
                        android:layout_marginTop="15dp"
                        android:layout_marginStart="15dp"
                        android:text="@string/salamtak_gates"
                        android:textColor="@color/black"
                        android:textSize="20sp"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toBottomOf="@+id/rv_SalamtakmedicalServices"
                />

                <androidx.recyclerview.widget.RecyclerView
                        android:id="@+id/rv_HealthTopics"
                        android:layout_width="match_parent"
                        android:layout_height="250dp"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintEnd_toEndOf="parent"
                        android:paddingBottom="5dp"
                        android:layout_marginTop="@dimen/_8sdp"
                        android:layout_marginStart="14dp"
                        android:layout_marginEnd="15dp"
                        tools:listitem="@layout/item_layout_gates"
                        app:layoutManager="androidx.recyclerview.widget.GridLayoutManager"
                        app:layout_constraintTop_toBottomOf="@+id/tv_HealthTopics"
                        app:layout_constraintBottom_toBottomOf="parent"
                />

                <ProgressBar
                        android:id="@+id/health_progress_bar"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        app:layout_constraintEnd_toEndOf="@+id/rv_HealthTopics"
                        app:layout_constraintStart_toStartOf="@+id/rv_HealthTopics"
                        app:layout_constraintBottom_toBottomOf="@+id/rv_HealthTopics"
                        app:layout_constraintTop_toTopOf="@+id/rv_HealthTopics"
                        android:visibility="gone"
                />


            </androidx.constraintlayout.widget.ConstraintLayout>

        </androidx.core.widget.NestedScrollView>
    </androidx.constraintlayout.widget.ConstraintLayout>


</androidx.constraintlayout.widget.ConstraintLayout>