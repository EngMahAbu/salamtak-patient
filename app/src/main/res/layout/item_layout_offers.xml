<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
        xmlns:android="http://schemas.android.com/apk/res/android"
        xmlns:app="http://schemas.android.com/apk/res-auto"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="3dp">

    <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/layout_Subspecialization"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:padding="3dp"
            android:layout_marginStart="5dp"
            android:layout_marginEnd="5dp"
            android:layout_marginBottom="5dp"
            android:background="@drawable/bg_edittext"
            android:elevation="1dp"
            app:layout_constraintTop_toTopOf="parent">

        <androidx.constraintlayout.widget.ConstraintLayout
                android:id="@+id/first_layout"
                android:layout_width="match_parent"
                android:layout_height="145dp"
                android:layout_marginStart="5dp"
                android:layout_marginEnd="5dp"
                app:layout_constraintTop_toTopOf="parent">

            <com.google.android.material.imageview.ShapeableImageView
                    android:id="@+id/iv_catOffer"
                    android:layout_width="@dimen/_300sdp"
                    android:layout_height="120dp"
                    android:layout_marginTop="@dimen/_2sdp"
                    android:adjustViewBounds="true"
                    android:scaleType="fitXY"
                    android:src="@drawable/iv_addimage"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintTop_toTopOf="parent" />
            <TextView
                    android:id="@+id/tv_categoryname"
                    android:layout_width="60dp"
                    android:layout_height="25dp"
                    android:gravity="center"
                    android:background="@color/red"
                    android:textSize="12sp"
                    android:text="35%"
                    android:textColor="@color/white"
                    app:layout_constraintBottom_toBottomOf="@+id/iv_catOffer"
                    app:layout_constraintEnd_toEndOf="parent"
                    />
            <androidx.appcompat.widget.AppCompatTextView
                    android:id="@+id/tv_doctor_name"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="35dp"
                    android:layout_marginEnd="10dp"
                    android:layout_marginTop="@dimen/_5sdp"
                    android:layout_marginBottom="@dimen/_3sdp"
                    android:gravity="start"
                    android:padding="2dp"
                    android:text="hhhhhhh"
                    android:textColor="@color/dark_grey"
                    android:textSize="12sp"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@+id/iv_catOffer" />
        </androidx.constraintlayout.widget.ConstraintLayout>
        <com.google.android.material.imageview.ShapeableImageView
                android:id="@+id/iv_offerPhoto"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:layout_marginStart="@dimen/_20sdp"
                android:src="@drawable/ic_docspecialization"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintBottom_toBottomOf="@+id/first_layout" />


        <androidx.appcompat.widget.AppCompatTextView
                android:id="@+id/tv_Service"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="15dp"
                android:layout_marginEnd="@dimen/_15sdp"
                android:layout_marginTop="@dimen/_3sdp"
                android:gravity="start"
                android:padding="2dp"
                android:text=""
                android:textColor="@color/blue"
                android:textSize="12sp"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/first_layout" />

        <androidx.appcompat.widget.AppCompatTextView
                android:id="@+id/tv_date"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="15dp"
                android:layout_marginEnd="@dimen/_15sdp"
                android:layout_marginTop="@dimen/_3sdp"
                android:gravity="start"
                android:padding="2dp"
                android:text=""
                android:textColor="@color/blue"
                android:textSize="12sp"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/tv_Service" />

        <androidx.appcompat.widget.AppCompatTextView
                android:id="@+id/tv_sessionCount"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="15dp"
                android:layout_marginTop="@dimen/_5sdp"
                android:gravity="start"
                android:padding="2dp"
                android:text="ggggg"
                android:textColor="@color/dark_grey"
                android:textSize="10sp"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/tv_date" />
        <androidx.appcompat.widget.AppCompatTextView
                android:id="@+id/tv_priceBefore"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="15dp"
                android:layout_marginBottom="@dimen/_5sdp"
                android:layout_marginTop="@dimen/_5sdp"
                android:gravity="start"
                android:padding="2dp"
                android:background="@drawable/bg_line"
                android:text="1024"
                android:lineBreakWordStyle="phrase"
                android:textColor="@color/dark_grey"
                android:textSize="12sp"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/tv_sessionCount" />

        <androidx.appcompat.widget.AppCompatTextView
                android:id="@+id/tv_priceAfter"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="15dp"
                android:layout_marginBottom="@dimen/_5sdp"
                android:layout_marginTop="@dimen/_5sdp"
                android:gravity="start"
                android:padding="2dp"
                android:text="1024 EGP"
                android:textColor="@color/blue"
                android:textSize="13sp"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintStart_toEndOf="@+id/tv_priceBefore"
                app:layout_constraintTop_toBottomOf="@+id/tv_sessionCount" />
        <TextView
                android:id="@+id/tv_Book"
                android:layout_width="65dp"
                android:layout_height="25dp"
                android:gravity="center"
                android:padding="2dp"
                android:layout_marginEnd="@dimen/_5sdp"
                android:layout_marginBottom="@dimen/_5sdp"
                android:background="@drawable/bg_button_green"
                android:textSize="12sp"
                android:layout_marginTop="@dimen/_10sdp"
                android:text="@string/book_now"
                android:textColor="@color/white"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/tv_sessionCount"
                app:layout_constraintEnd_toEndOf="parent"
                />

    </androidx.constraintlayout.widget.ConstraintLayout>


</androidx.constraintlayout.widget.ConstraintLayout>