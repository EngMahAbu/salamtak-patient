<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
        xmlns:android="http://schemas.android.com/apk/res/android"
        xmlns:tools="http://schemas.android.com/tools"
        android:layout_width="match_parent"
        android:background="@color/bg_color_gray"
        android:layout_height="match_parent" xmlns:app="http://schemas.android.com/apk/res-auto"
        tools:context=".fragment.offers.OffersFragment">

    <com.google.android.material.imageview.ShapeableImageView
            android:id="@+id/iv_confirm"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            android:adjustViewBounds="true"
            app:layout_constraintTop_toTopOf="parent"
            android:layout_marginTop="100dp"
            android:layout_marginStart="20dp"
            android:layout_marginEnd="20dp"
            android:src="@drawable/ic_offers_logo"/>

    <androidx.appcompat.widget.AppCompatTextView
            android:id="@+id/tv_confirm"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="@font/avenirltstd_black"
            android:gravity="start"
            android:padding="3dp"
            android:layout_marginTop="15dp"
            android:text="@string/offers_not_available_at_the_moment"
            android:textColor="@color/black"
            android:textSize="18sp"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/iv_confirm"/>

    <androidx.appcompat.widget.AppCompatTextView
            android:id="@+id/tv_thanks"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:fontFamily="@font/avenirltstd_roman"
            android:gravity="start|center_horizontal"
            android:padding="3dp"
            android:layout_marginTop="5dp"
            android:text="@string/we_are_working_on_delivering_the_best_offers_to_you_please_come_back_and_check_later"
            android:textColor="@color/black"
            android:textSize="14sp"
            app:layout_constraintWidth_percent=".80"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/tv_confirm"/>

</androidx.constraintlayout.widget.ConstraintLayout>