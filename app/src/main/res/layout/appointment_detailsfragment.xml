<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android"
        xmlns:tools="http://schemas.android.com/tools"
        xmlns:app="http://schemas.android.com/apk/res-auto"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/bg_color_gray"
        tools:context=".fragment.booking.AppointmentDetailsFragment">

    <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent">


        <com.google.android.material.imageview.ShapeableImageView
                android:id="@+id/iv_arrow"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="15dp"
                android:adjustViewBounds="true"
                android:padding="10dp"
                android:src="@drawable/ic_arrowleft"
                app:layout_constraintBottom_toBottomOf="@+id/tv_Filter"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="@+id/tv_Filter" />

        <androidx.appcompat.widget.AppCompatTextView
                android:id="@+id/tv_Filter"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="15dp"
                android:layout_marginTop="20dp"
                android:fontFamily="@font/avenirltstd_black"
                android:text="@string/summary"
                android:textColor="@color/black"
                android:textSize="16sp"
                app:layout_constraintStart_toEndOf="@+id/iv_arrow"
                app:layout_constraintTop_toTopOf="parent" />

        <androidx.core.widget.NestedScrollView
                android:id="@+id/layout"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/iv_arrow"
                app:layout_constraintBottom_toTopOf="@+id/layout_btn_confirm">


            <androidx.constraintlayout.widget.ConstraintLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:padding="3dp">

                <androidx.constraintlayout.widget.ConstraintLayout
                        android:id="@+id/layout_doctorsDetail"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="25dp"
                        android:layout_marginStart="15dp"
                        android:layout_marginEnd="15dp"
                        android:padding="8dp"
                        android:background="@drawable/bg_edittext"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toTopOf="parent">

                    <com.google.android.material.imageview.ShapeableImageView
                            android:id="@+id/iv_doctorProfile"
                            android:layout_width="50dp"
                            android:layout_height="50dp"
                            android:src="@drawable/ic_docspecialization"
                            app:layout_constraintStart_toStartOf="parent"
                            app:layout_constraintTop_toTopOf="parent" />

                    <androidx.appcompat.widget.AppCompatTextView
                            android:id="@+id/tv_doctorName"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="10dp"
                            android:fontFamily="@font/avenirltstd_roman"
                            android:gravity="start"
                            android:padding="3dp"
                            android:textColor="@color/black"
                            android:textSize="15sp"
                            app:layout_constraintStart_toEndOf="@+id/iv_doctorProfile"
                            app:layout_constraintTop_toTopOf="@+id/iv_doctorProfile" />

                    <androidx.appcompat.widget.AppCompatTextView
                            android:id="@+id/tv_Specialization"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="10dp"
                            android:layout_marginTop="5dp"
                            android:fontFamily="@font/avenirltstd_roman"
                            android:gravity="start"
                            android:padding="2dp"
                            android:textColor="@color/gray"
                            android:textSize="15sp"
                            app:layout_constraintStart_toEndOf="@+id/iv_doctorProfile"
                            app:layout_constraintTop_toBottomOf="@+id/tv_doctorName" />

                    <com.google.android.material.imageview.ShapeableImageView
                            android:id="@+id/iv_star"
                            android:layout_width="18dp"
                            android:layout_height="15dp"
                            android:layout_marginStart="10dp"
                            android:adjustViewBounds="true"
                            android:src="@drawable/ic_star"
                            android:visibility="gone"
                            app:layout_constraintBottom_toBottomOf="parent"
                            app:layout_constraintStart_toEndOf="@+id/iv_doctorProfile"
                            app:layout_constraintTop_toBottomOf="@+id/tv_Specialization" />

                    <androidx.appcompat.widget.AppCompatTextView
                            android:id="@+id/tv_Reviews"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="5dp"
                            android:fontFamily="@font/avenirltstd_roman"
                            android:gravity="start"
                            android:padding="2dp"
                            android:text="@string/reviews"
                            android:visibility="gone"
                            android:textColor="@color/gray"
                            android:textSize="15sp"
                            app:layout_constraintStart_toEndOf="@+id/iv_star"
                            app:layout_constraintTop_toBottomOf="@+id/tv_Specialization" />

                </androidx.constraintlayout.widget.ConstraintLayout>


                <androidx.appcompat.widget.AppCompatTextView
                        android:id="@+id/tv_PatientInfo"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="15dp"
                        android:layout_marginTop="20dp"
                        android:fontFamily="@font/sf_pro_display_semibold"
                        android:text="@string/PatientInfo"
                        android:textColor="@color/black"
                        android:textSize="16sp"
                        app:layout_constraintTop_toBottomOf="@+id/layout_doctorsDetail"
                        app:layout_constraintStart_toStartOf="parent" />

                <androidx.constraintlayout.widget.ConstraintLayout
                        android:id="@+id/layout_btn_insurance"
                        android:layout_width="match_parent"
                        android:layout_height="0dp"
                        android:layout_marginBottom="10dp"
                        android:layout_marginTop="10dp"
                        android:layout_margin="15dp"
                        app:layout_constraintTop_toBottomOf="@+id/tv_PatientInfo"
                        app:layout_constraintEnd_toEndOf="parent">

                    <CheckBox
                            android:id="@+id/ch_Card"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:drawablePadding="10dp"
                            android:elevation="1dp"
                            android:layout_marginBottom="20dp"
                            android:fontFamily="@font/sf_pro_display_semibold"
                            android:text="@string/book_with_insurance"
                            android:padding="3dp"
                            android:buttonTint="@color/checkbox_sellector"
                            android:textColor="@color/text_doctor_card_color"
                            android:textSize="14sp"
                            app:layout_constraintEnd_toEndOf="parent" />

                </androidx.constraintlayout.widget.ConstraintLayout>

                <androidx.constraintlayout.widget.ConstraintLayout
                        android:id="@+id/layout_choose_relation_type"
                        android:layout_width="match_parent"
                        android:layout_height="55dp"
                        android:layout_marginTop="10dp"
                        android:layout_marginStart="15dp"
                        android:layout_marginEnd="15dp"
                        android:elevation="1dp"
                        android:visibility="gone"
                        android:background="@drawable/more_cards_background"
                        android:backgroundTint="@color/white"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toBottomOf="@+id/layout_btn_insurance">

                    <TextView
                            android:id="@+id/tv_relation"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="20dp"
                            android:fontFamily="@font/avenirltstd_roman"
                            android:gravity="start"
                            android:text="@string/select_relation_type"
                            android:textColor="@color/black"
                            android:textSize="14sp"
                            app:layout_constraintStart_toStartOf="parent"
                            app:layout_constraintBottom_toBottomOf="parent"
                            app:layout_constraintTop_toTopOf="parent"
                            />

                    <com.google.android.material.imageview.ShapeableImageView
                            android:id="@+id/iv_city"
                            android:layout_width="12dp"
                            android:layout_height="12dp"
                            android:layout_marginEnd="15dp"
                            android:adjustViewBounds="true"
                            android:src="@drawable/ic_arrowdwon"
                            app:layout_constraintEnd_toEndOf="parent"
                            app:layout_constraintTop_toTopOf="parent"
                            app:layout_constraintBottom_toBottomOf="parent" />


                </androidx.constraintlayout.widget.ConstraintLayout>

                <com.google.android.material.textfield.TextInputLayout
                        android:id="@+id/textinput_fullName"
                        style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                        android:layout_width="match_parent"
                        android:layout_height="67dp"
                        android:layout_marginStart="15dp"
                        android:layout_marginEnd="15dp"
                        android:background="@drawable/bg_edittext"
                        android:elevation="1dp"
                        android:paddingTop="5dp"
                        android:layout_marginTop="15dp"
                        android:hint="@string/full_name"
                        app:boxBackgroundMode="none"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toBottomOf="@+id/layout_choose_relation_type">

                    <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/et_fullName_AR"
                            android:layout_width="match_parent"
                            android:layout_gravity="center_horizontal"
                            android:gravity="start"
                            android:text=""
                            android:imeOptions="actionNext"
                            android:textColor="@color/black"
                            android:fontFamily="@font/sf_pro_display_semibold"
                            android:textSize="12sp"
                            android:layout_marginTop="5dp"
                            android:layout_height="60dp"
                            android:inputType="text" />

                </com.google.android.material.textfield.TextInputLayout>

                <com.google.android.material.textfield.TextInputLayout
                        android:id="@+id/textinput_PhoneNumber"
                        style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                        android:layout_width="match_parent"
                        android:layout_height="67dp"
                        android:layout_marginStart="15dp"
                        android:layout_marginEnd="15dp"
                        android:background="@drawable/bg_edittext"
                        android:elevation="1dp"
                        android:paddingTop="7dp"
                        android:layout_marginTop="15dp"
                        android:hint="@string/mobile_number"
                        android:visibility="gone"
                        app:boxBackgroundMode="none"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toBottomOf="@+id/textinput_fullName"
                        app:layout_constraintHorizontal_bias="0.8">

                    <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/et_PhoneNumber"
                            android:layout_width="match_parent"
                            android:layout_gravity="center_horizontal"
                            android:gravity="start"
                            android:textColor="@color/black"
                            android:fontFamily="@font/avenirltstd_roman"
                            android:textSize="12sp"
                            android:maxLength="11"
                            android:imeOptions="actionNext"
                            android:digits="jjfhdddbbbjshjksdj6mifghdkjwaxmjjk0123456789d"
                            android:layout_marginTop="5dp"
                            android:layout_height="60dp"
                            android:inputType="number" />
                </com.google.android.material.textfield.TextInputLayout>

                <androidx.appcompat.widget.AppCompatTextView
                        android:id="@+id/tv_InsuranceCompanies"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="15dp"
                        android:layout_marginTop="20dp"
                        android:fontFamily="@font/sf_pro_display_semibold"
                        android:text="@string/InsuranceCompanies"
                        android:textColor="@color/black"
                        android:visibility="gone"
                        android:textSize="16sp"
                        app:layout_constraintTop_toBottomOf="@+id/textinput_PhoneNumber"
                        app:layout_constraintStart_toStartOf="parent" />

                <androidx.constraintlayout.widget.ConstraintLayout
                        android:id="@+id/layout_InsuranceCompanies"
                        android:layout_width="match_parent"
                        android:layout_height="54dp"
                        android:layout_marginStart="15dp"
                        android:layout_marginTop="15dp"
                        android:layout_marginEnd="15dp"
                        android:visibility="gone"
                        android:background="@drawable/more_cards_background"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toBottomOf="@+id/tv_InsuranceCompanies">

                    <androidx.appcompat.widget.AppCompatTextView
                            android:id="@+id/tv_completeProfile"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:fontFamily="@font/avenirltstd_roman"
                            android:gravity="start"
                            android:padding="2dp"
                            app:layout_constraintStart_toStartOf="parent"
                            app:layout_constraintTop_toTopOf="parent"
                            app:layout_constraintBottom_toBottomOf="parent"
                            android:layout_marginStart="15dp"
                            android:text="@string/insurance_company"
                            android:textColor="@color/text_doctor_card_color"
                            android:textSize="18sp" />

                    <ImageView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginEnd="15dp"
                            app:layout_constraintEnd_toEndOf="parent"
                            app:layout_constraintTop_toTopOf="parent"
                            app:layout_constraintBottom_toBottomOf="parent"
                            android:src="@drawable/ic_arrowdwon"
                            />
                </androidx.constraintlayout.widget.ConstraintLayout>

                <androidx.appcompat.widget.AppCompatTextView
                        android:id="@+id/tv_BookingDetails"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="15dp"
                        android:layout_marginTop="20dp"
                        android:fontFamily="@font/sf_pro_display_semibold"
                        android:text="@string/BookingDetails"
                        android:textColor="@color/black"
                        android:textSize="16sp"
                        app:layout_constraintTop_toBottomOf="@+id/layout_InsuranceCompanies"
                        app:layout_constraintStart_toStartOf="parent" />

                <androidx.constraintlayout.widget.ConstraintLayout
                        android:id="@+id/layout_details"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="15dp"
                        android:layout_marginEnd="15dp"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toBottomOf="@+id/tv_BookingDetails">

                    <androidx.constraintlayout.widget.ConstraintLayout
                            android:id="@+id/layout_Subspecialization"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:padding="5dp"
                            app:layout_constraintTop_toTopOf="parent">

                        <androidx.constraintlayout.widget.ConstraintLayout
                                android:id="@+id/layout_BookingDateTime"
                                android:layout_width="37dp"
                                android:layout_height="37dp"
                                android:layout_marginTop="10dp"
                                android:layout_marginStart="10dp"
                                app:layout_constraintStart_toStartOf="parent"
                                app:layout_constraintTop_toBottomOf="@+id/layout_Service">

                            <com.google.android.material.imageview.ShapeableImageView
                                    android:id="@+id/iv_sub_specialization"
                                    android:layout_width="21dp"
                                    android:layout_height="21dp"
                                    android:adjustViewBounds="true"
                                    android:src="@drawable/new_calendar"
                                    app:layout_constraintBottom_toBottomOf="parent"
                                    app:layout_constraintEnd_toEndOf="parent"
                                    app:layout_constraintStart_toStartOf="parent"
                                    app:layout_constraintTop_toTopOf="parent" />
                        </androidx.constraintlayout.widget.ConstraintLayout>

                        <androidx.appcompat.widget.AppCompatTextView
                                android:id="@+id/tv_BookingDateTime"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="5dp"
                                android:fontFamily="@font/avenirltstd_roman"
                                android:gravity="start"
                                android:padding="2dp"
                                android:visibility="gone"
                                android:text="@string/booking_date_time"
                                android:textColor="@color/gray"
                                android:textSize="15sp"
                                app:layout_constraintStart_toEndOf="@+id/layout_BookingDateTime"
                                app:layout_constraintTop_toTopOf="@+id/layout_BookingDateTime" />

                        <androidx.appcompat.widget.AppCompatTextView
                                android:id="@+id/tv_date"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="5dp"
                                android:fontFamily="@font/avenirltstd_black"
                                android:gravity="start"
                                android:padding="2dp"
                                android:textColor="@color/black"
                                android:textSize="12sp"
                                app:layout_constraintStart_toEndOf="@+id/layout_BookingDateTime"
                                app:layout_constraintBottom_toBottomOf="@+id/layout_BookingDateTime"
                                app:layout_constraintTop_toBottomOf="@+id/tv_BookingDateTime" />

                        <androidx.constraintlayout.widget.ConstraintLayout
                                android:id="@+id/layout_Service"
                                android:layout_width="37dp"
                                android:layout_height="37dp"
                                android:layout_marginTop="10dp"
                                android:layout_marginStart="10dp"
                                app:layout_constraintStart_toStartOf="parent"
                                app:layout_constraintTop_toTopOf="parent">

                            <com.google.android.material.imageview.ShapeableImageView
                                    android:id="@+id/iv_Service"
                                    android:layout_width="21dp"
                                    android:layout_height="21dp"
                                    android:adjustViewBounds="true"
                                    android:src="@drawable/ic_vediodetails"
                                    app:layout_constraintBottom_toBottomOf="parent"
                                    app:layout_constraintEnd_toEndOf="parent"
                                    app:layout_constraintStart_toStartOf="parent"
                                    app:layout_constraintTop_toTopOf="parent" />
                        </androidx.constraintlayout.widget.ConstraintLayout>

                        <androidx.appcompat.widget.AppCompatTextView
                                android:id="@+id/tv_Service"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="5dp"
                                android:fontFamily="@font/avenirltstd_roman"
                                android:gravity="start"
                                android:padding="2dp"
                                android:visibility="gone"
                                android:text="@string/service"
                                android:textColor="@color/gray"
                                android:textSize="15sp"
                                app:layout_constraintStart_toEndOf="@+id/layout_Service"
                                app:layout_constraintTop_toTopOf="@+id/layout_Service" />

                        <androidx.appcompat.widget.AppCompatTextView
                                android:id="@+id/Service"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="5dp"
                                android:fontFamily="@font/avenirltstd_black"
                                android:gravity="start"
                                android:padding="2dp"
                                android:textColor="@color/black"
                                android:textSize="12sp"
                                app:layout_constraintEnd_toEndOf="parent"
                                app:layout_constraintStart_toEndOf="@+id/layout_Service"
                                app:layout_constraintBottom_toBottomOf="@+id/layout_Service"
                                app:layout_constraintTop_toBottomOf="@+id/tv_Service" />


                        <androidx.constraintlayout.widget.ConstraintLayout
                                android:id="@+id/layout_Location"
                                android:layout_width="37dp"
                                android:layout_height="37dp"
                                android:layout_marginTop="10dp"
                                android:layout_marginStart="10dp"
                                android:visibility="gone"
                                app:layout_constraintStart_toStartOf="parent"
                                app:layout_constraintTop_toBottomOf="@+id/layout_BookingDateTime">

                            <com.google.android.material.imageview.ShapeableImageView
                                    android:id="@+id/iv_Location"
                                    android:layout_width="21dp"
                                    android:layout_height="21dp"
                                    android:adjustViewBounds="true"
                                    android:src="@drawable/svg_location"
                                    app:layout_constraintBottom_toBottomOf="parent"
                                    app:layout_constraintEnd_toEndOf="parent"
                                    app:layout_constraintStart_toStartOf="parent"
                                    app:layout_constraintTop_toTopOf="parent" />
                        </androidx.constraintlayout.widget.ConstraintLayout>

                        <androidx.appcompat.widget.AppCompatTextView
                                android:id="@+id/tv_Location"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="5dp"
                                android:fontFamily="@font/avenirltstd_black"
                                android:gravity="start"
                                android:padding="2dp"
                                android:textColor="@color/black"
                                android:textSize="12sp"
                                app:layout_constraintStart_toEndOf="@+id/layout_Location"
                                app:layout_constraintBottom_toBottomOf="@+id/layout_Location"
                                app:layout_constraintTop_toBottomOf="@+id/layout_BookingDateTime" />


                        <androidx.constraintlayout.widget.ConstraintLayout
                                android:id="@+id/layout_fees"
                                android:layout_width="37dp"
                                android:layout_height="37dp"
                                android:layout_marginTop="10dp"
                                android:layout_marginStart="10dp"
                                app:layout_constraintStart_toStartOf="parent"
                                app:layout_constraintTop_toBottomOf="@+id/layout_Location">

                            <com.google.android.material.imageview.ShapeableImageView
                                    android:id="@+id/iv_Fees"
                                    android:layout_width="21dp"
                                    android:layout_height="21dp"
                                    android:adjustViewBounds="true"
                                    android:src="@drawable/svg_money"
                                    app:layout_constraintBottom_toBottomOf="parent"
                                    app:layout_constraintEnd_toEndOf="parent"
                                    app:layout_constraintStart_toStartOf="parent"
                                    app:layout_constraintTop_toTopOf="parent" />
                        </androidx.constraintlayout.widget.ConstraintLayout>

                        <androidx.appcompat.widget.AppCompatTextView
                                android:id="@+id/tv_fees"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="5dp"
                                android:fontFamily="@font/avenirltstd_black"
                                android:gravity="start"
                                android:layout_marginTop="@dimen/_8sdp"
                                android:padding="2dp"
                                android:textColor="@color/black"
                                android:textSize="12sp"
                                app:layout_constraintStart_toEndOf="@+id/layout_fees"
                                app:layout_constraintBottom_toBottomOf="@+id/layout_fees"
                                app:layout_constraintTop_toBottomOf="@+id/layout_Location" />


                    </androidx.constraintlayout.widget.ConstraintLayout>


                </androidx.constraintlayout.widget.ConstraintLayout>




            </androidx.constraintlayout.widget.ConstraintLayout>
        </androidx.core.widget.NestedScrollView>


        <androidx.constraintlayout.widget.ConstraintLayout
                android:id="@+id/layout_btn_confirm"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="10dp"
                app:layout_constraintTop_toBottomOf="@+id/layout"
                app:layout_constraintBottom_toTopOf="@+id/imageView"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent">

            <androidx.appcompat.widget.AppCompatButton
                    android:id="@+id/btn_confirm"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_chooselang_button"
                    android:fontFamily="@font/avenirltstd_black"
                    android:padding="5dp"
                    android:text="@string/confirm"
                    android:textColor="@color/white"
                    android:textSize="14sp"
                    app:layout_constraintTop_toTopOf="parent"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintWidth_percent=".9" />

        </androidx.constraintlayout.widget.ConstraintLayout>

        <ProgressBar
                android:id="@+id/progress_bar"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:visibility="gone"
                app:layout_constraintEnd_toEndOf="@+id/layout_btn_confirm"
                app:layout_constraintStart_toStartOf="@+id/layout_btn_confirm"
                app:layout_constraintBottom_toBottomOf="@+id/layout_btn_confirm"
                app:layout_constraintTop_toTopOf="@+id/layout_btn_confirm" />

        <ImageView
                android:id="@+id/imageView"
                android:layout_width="100dp"
                android:layout_height="4dp"
                android:layout_marginTop="20dp"
                android:layout_marginBottom="5dp"
                android:adjustViewBounds="true"
                android:background="@color/black"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent" />

    </androidx.constraintlayout.widget.ConstraintLayout>

    <include
            android:id="@+id/layoutBottomsheetpersistant"
            layout="@layout/layout_bottomsheet_bookwithinsurance"
            android:visibility="gone" />

</androidx.coordinatorlayout.widget.CoordinatorLayout>