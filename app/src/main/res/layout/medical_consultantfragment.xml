<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView
        xmlns:android="http://schemas.android.com/apk/res/android"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scrollbars="none"
        android:background="#F4F4F6"
        xmlns:app="http://schemas.android.com/apk/res-auto"
        android:padding="16dp">

    <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

        <androidx.constraintlayout.widget.ConstraintLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                >
            <com.google.android.material.imageview.ShapeableImageView
                    android:id="@+id/iv_arrow"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="15dp"
                    android:adjustViewBounds="true"
                    android:padding="10dp"
                    android:src="@drawable/ic_arrowleft"
                    app:layout_constraintBottom_toBottomOf="@+id/tv_Filter"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="@+id/tv_Filter" />

            <androidx.appcompat.widget.AppCompatTextView
                    android:id="@+id/tv_Filter"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="15dp"
                    android:layout_marginTop="20dp"
                    android:fontFamily="@font/avenirltstd_black"
                    android:text="Medical Consultation Request"
                    android:textColor="@color/black"
                    android:textSize="16sp"
                    app:layout_constraintStart_toEndOf="@+id/iv_arrow"
                    app:layout_constraintTop_toTopOf="parent" />
        </androidx.constraintlayout.widget.ConstraintLayout>


        <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_margin="5dp"
                app:cardBackgroundColor="#FFFFFF"
                app:cardCornerRadius="@dimen/_15sdp">
            <androidx.constraintlayout.widget.ConstraintLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">

                <ImageView
                        android:id="@+id/nursing_image"
                        android:layout_width="match_parent"
                        android:layout_height="160dp"
                        android:scaleType="centerCrop"
                        app:layout_constraintTop_toTopOf="parent"
                        android:src="@drawable/medical_consultation_ic"
                        />
                <TextView
                        android:id="@+id/nursing_Desc"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:fontFamily="@font/avenirltstd_roman"
                        android:layout_marginStart="15dp"
                        android:layout_marginEnd="15dp"
                        android:layout_marginBottom="5dp"
                        android:layout_marginTop="8dp"
                        android:textColor="@color/black"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintBottom_toBottomOf="parent"
                        app:layout_constraintTop_toBottomOf="@+id/nursing_image"
                        android:text="Salamtak Application provides reliable medical information and directive diagnosis for simple cases through direct phone call with one of Salamtak Specialized Doctors"
                        android:textSize="13sp"
                        />

            </androidx.constraintlayout.widget.ConstraintLayout>
        </androidx.cardview.widget.CardView>
        <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/full_name"
                android:fontFamily="@font/inter_semibold"
                android:textColor="@color/color_64748B"
                android:textSize="12sp"
                android:paddingTop="8dp"/>

        <EditText
                android:id="@+id/etPatientName"
                android:layout_width="match_parent"
                android:layout_height="50dp"
                android:layout_marginTop="7dp"
                android:fontFamily="@font/inter_regular"
                android:textSize="11sp"
                android:paddingStart="10dp"
                android:background="@drawable/bg_edittext_box"
                android:hint="@string/full_name_in_english_first_middle_last"
                android:inputType="text"/>

        <!-- Mobile Number -->
        <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Mobile Number"
                android:fontFamily="@font/inter_semibold"
                android:textColor="@color/color_64748B"
                android:textSize="12sp"
                android:paddingTop="8dp"/>

        <EditText
                android:id="@+id/etMobileNumber"
                android:layout_width="match_parent"
                android:layout_height="50dp"
                android:layout_marginTop="10dp"
                android:fontFamily="@font/inter_regular"
                android:textSize="11sp"
                android:paddingStart="10dp"
                android:background="@drawable/bg_edittext_box"
                android:hint="Mobile Number: (+2)"
                android:inputType="phone"/>

        <!-- Address -->
        <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/specialization"
                android:fontFamily="@font/inter_semibold"
                android:textColor="@color/color_64748B"
                android:textSize="12sp"
                android:paddingTop="8dp"/>
        <androidx.constraintlayout.widget.ConstraintLayout
                android:id="@+id/layout_Location_Details"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:visibility="visible"
                >

            <androidx.appcompat.widget.AppCompatButton
                    android:id="@+id/btn_layout_Choose_City"
                    android:layout_width="0dp"
                    android:layout_height="0dp"
                    android:background="@android:color/transparent"
                    app:layout_constraintEnd_toEndOf="@+id/layout_Choose_City"
                    app:layout_constraintStart_toStartOf="@+id/layout_Choose_City"
                    app:layout_constraintTop_toTopOf="@+id/layout_Choose_City"
                    app:layout_constraintBottom_toBottomOf="@+id/layout_Choose_City" />

            <androidx.constraintlayout.widget.ConstraintLayout
                    android:id="@+id/layout_Choose_City"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_edittext_box"
                    android:elevation="1dp"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent">

                <androidx.appcompat.widget.AppCompatImageView
                        android:id="@+id/iv_arrowdownChoose_City"
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        android:layout_gravity="center_horizontal"
                        android:layout_marginEnd="12dp"
                        android:layout_marginBottom="12dp"
                        android:gravity="start"
                        android:src="@drawable/ic_arrowdwon"
                        android:tint="@color/color_64748B"
                        app:layout_constraintBottom_toBottomOf="parent"
                        app:layout_constraintEnd_toEndOf="parent" />

                <com.google.android.material.textfield.TextInputLayout
                        android:id="@+id/textinput_Choose_City"
                        style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                        android:layout_width="match_parent"
                        android:layout_height="55dp"
                        android:layout_marginEnd="25dp"
                        android:layout_marginBottom="5dp"
                        android:hint="@string/choose_specialization"
                        android:paddingTop="4dp"
                        app:boxBackgroundColor="@color/white"
                        app:boxBackgroundMode="none"
                        app:layout_constraintBottom_toBottomOf="parent"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toTopOf="parent">

                    <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/et_Choose_City"
                            android:layout_width="match_parent"
                            android:layout_height="55dp"
                            android:layout_gravity="center_horizontal"
                            android:fontFamily="@font/avenirltstd_roman"
                            android:inputType="text"
                            android:enabled="false"
                            android:textColor="@color/color_64748B"
                            android:textSize="11sp" />

                </com.google.android.material.textfield.TextInputLayout>

            </androidx.constraintlayout.widget.ConstraintLayout>
            <androidx.appcompat.widget.AppCompatTextView
                    android:id="@+id/tv_cityError"
                    android:layout_width="wrap_content"
                    android:layout_height="20dp"
                    android:layout_marginTop="5dp"
                    android:layout_marginBottom="5dp"
                    android:layout_marginStart="15dp"
                    android:fontFamily="@font/avenirltstd_roman"
                    android:gravity="center"
                    android:padding="1dp"
                    android:text="55555"
                    android:textColor="@color/red"
                    android:textSize="12sp"
                    android:visibility="gone"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@+id/layout_Choose_City" />

        </androidx.constraintlayout.widget.ConstraintLayout>

        <!-- Symptoms -->

        <TextView
                android:id="@+id/text_symptoms"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Symptoms"
                android:layout_marginTop="10dp"
                android:textColor="@color/color_64748B"
                android:fontFamily="sans-serif-medium"
                />

        <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/symptoms_text"
                style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:layout_constraintTop_toBottomOf="@id/text_symptoms"
                android:layout_marginTop="4dp"
                app:hintEnabled="false">

            <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/symptoms"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="Describe your Symptoms..."
                    android:minLines="4"
                    android:gravity="start"
                    android:background="@drawable/bg_edittext_box"/>

        </com.google.android.material.textfield.TextInputLayout>

        <!-- Ask Question -->

        <TextView
                android:id="@+id/text_Ask_ques"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Ask a Question"
                android:textColor="@color/color_64748B"
                android:fontFamily="sans-serif-medium"
                app:layout_constraintTop_toBottomOf="@id/symptoms_text"
                app:layout_constraintStart_toStartOf="@id/symptoms_text"
                android:layout_marginTop="8dp"/>

        <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/ask_text"
                style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:layout_constraintTop_toBottomOf="@id/text_Ask_ques"
                android:layout_marginTop="4dp"
                app:hintEnabled="false">

            <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/ask"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="Describe your question..."
                    android:minLines="4"
                    android:gravity="start"
                    android:background="@drawable/bg_edittext_box"/>

        </com.google.android.material.textfield.TextInputLayout>

        <!-- Send Button -->
        <androidx.constraintlayout.widget.ConstraintLayout
                android:id="@+id/layout"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/all_layout"
                app:layout_constraintWidth_percent=".95"
                android:padding="8dp"
                >
            <androidx.appcompat.widget.AppCompatButton
                    android:id="@+id/btn_send"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_chooselang_button"
                    android:fontFamily="@font/avenirltstd_black"
                    android:padding="5dp"
                    android:text="@string/send"
                    android:textAllCaps="false"
                    android:textColor="@color/white"
                    android:textSize="14sp"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent"

                    />
        </androidx.constraintlayout.widget.ConstraintLayout>
    </LinearLayout>
</androidx.core.widget.NestedScrollView>
