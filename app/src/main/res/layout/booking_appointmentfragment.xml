<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_color_gray"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    tools:context=".fragment.booking.AppointmentDetailsFragment">

    <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent">
    <com.google.android.material.imageview.ShapeableImageView
        android:id="@+id/iv_arrow"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="15dp"
        android:adjustViewBounds="true"
        android:padding="10dp"
        android:src="@drawable/ic_arrowleft"
        app:layout_constraintBottom_toBottomOf="@+id/tv_name"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="@+id/tv_name" />

    <androidx.appcompat.widget.AppCompatTextView
        android:id="@+id/tv_name"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="15dp"
        android:layout_marginTop="20dp"
        android:fontFamily="@font/avenirltstd_black"
        android:text=""
        android:textColor="@color/black"
        android:textSize="16sp"
        app:layout_constraintStart_toEndOf="@+id/iv_arrow"
        app:layout_constraintTop_toTopOf="parent" />


            <androidx.constraintlayout.widget.ConstraintLayout
                android:id="@+id/layout_doctorsDetail"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="25dp"
                android:layout_marginStart="5dp"
                android:layout_marginEnd="15dp"
                android:padding="8dp"
                android:background="@color/white"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/iv_arrow">

                <com.google.android.material.imageview.ShapeableImageView
                    android:id="@+id/iv_doctorProfile"
                    android:layout_width="80dp"
                    android:layout_height="80dp"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent" />

                <androidx.appcompat.widget.AppCompatTextView
                    android:id="@+id/tv_doctorName"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="10dp"
                    android:fontFamily="@font/avenirltstd_roman"
                    android:gravity="start"
                    android:padding="3dp"
                    android:text=""
                    android:textColor="@color/black"
                    android:textSize="15sp"
                    app:layout_constraintStart_toEndOf="@+id/iv_doctorProfile"
                    app:layout_constraintTop_toTopOf="@+id/iv_doctorProfile" />

                <androidx.appcompat.widget.AppCompatTextView
                    android:id="@+id/tv_Specialization"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="10dp"
                    android:layout_marginEnd="10dp"
                    android:layout_marginTop="5dp"
                    android:fontFamily="@font/avenirltstd_roman"
                    android:gravity="start"
                    android:padding="2dp"
                    android:text=""
                    android:textColor="@color/gray"
                    android:textSize="15sp"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toEndOf="@+id/iv_doctorProfile"
                    app:layout_constraintTop_toBottomOf="@+id/tv_doctorName" />

                <androidx.appcompat.widget.AppCompatTextView
                        android:id="@+id/Reviewss"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="5dp"
                        android:fontFamily="@font/avenirltstd_roman"
                        android:gravity="start"
                        android:layout_marginTop="@dimen/_5sdp"
                        android:text="0"
                        android:visibility="gone"
                        android:textColor="@color/black"
                        android:textSize="14sp"
                        app:layout_constraintStart_toEndOf="@+id/ratingBar"
                        app:layout_constraintTop_toBottomOf="@+id/tv_Specialization" />

                <androidx.appcompat.widget.AppCompatTextView
                        android:id="@+id/Ratecount"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="5dp"
                        android:fontFamily="@font/avenirltstd_roman"
                        android:gravity="start"
                        android:layout_marginTop="@dimen/_8sdp"
                        android:text="0"
                        android:textColor="@color/gray"
                        android:textSize="11sp"
                        app:layout_constraintStart_toEndOf="@+id/Reviewss"
                        app:layout_constraintTop_toBottomOf="@+id/tv_Specialization" />

                <androidx.appcompat.widget.AppCompatTextView
                        android:id="@+id/tv_Reviews"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="5dp"
                        android:fontFamily="@font/avenirltstd_roman"
                        android:gravity="start"
                        android:layout_marginTop="@dimen/_8sdp"
                        android:text="@string/reviews"
                        android:textColor="@color/gray"
                        android:textSize="10sp"
                        app:layout_constraintStart_toEndOf="@+id/Ratecount"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintTop_toBottomOf="@+id/tv_Specialization" />

                <androidx.appcompat.widget.AppCompatRatingBar
                        android:id="@+id/ratingBar"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="10dp"
                        app:layout_constraintTop_toBottomOf="@+id/tv_Specialization"
                        app:layout_constraintStart_toEndOf="@+id/iv_doctorProfile"
                        android:rating="2"
                        android:theme="@style/ratingBar"
                        android:layout_marginTop="@dimen/_5sdp"
                        style="?android:attr/ratingBarStyleSmall"
                        android:transformPivotX="0dp"
                        android:transformPivotY="0dp"
                        android:isIndicator="true"
                        android:minHeight="@dimen/_10sdp"
                        android:minWidth="@dimen/_5sdp"

                        />

            </androidx.constraintlayout.widget.ConstraintLayout>

    <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/layout_Sharelink"
            android:layout_width="0dp"
            android:layout_height="46dp"
            android:layout_marginTop="8dp"
            android:layout_marginEnd="10dp"
            android:background="@drawable/bg_helpgray"
            android:padding="8dp"
            android:layout_marginStart="10dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintHorizontal_bias="0.5"
            app:layout_constraintStart_toEndOf="@+id/layout_Addtofavorite"
            app:layout_constraintTop_toBottomOf="@+id/layout_doctorsDetail">

        <androidx.appcompat.widget.AppCompatTextView
                android:id="@+id/tv_Sharelink"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/avenirltstd_roman"
                android:text="@string/myquestions"
                android:textColor="@color/dark_gray"
                android:textSize="14sp"
                android:gravity="center_vertical"
                android:drawableStart="@drawable/ic_question_mark"
                android:drawablePadding="10dp"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"/>
        />

    </androidx.constraintlayout.widget.ConstraintLayout>
    <androidx.constraintlayout.widget.ConstraintLayout
                android:id="@+id/layout_Addtofavorite"
                android:layout_width="0dp"
                android:layout_height="46dp"
                android:layout_marginStart="10dp"
                android:layout_marginTop="10dp"
                android:background="@drawable/bg_help"
                android:padding="8dp"
                app:layout_constraintEnd_toStartOf="@+id/layout_Sharelink"
                app:layout_constraintHorizontal_bias="0.5"
                app:layout_constraintHorizontal_chainStyle="spread_inside"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/layout_doctorsDetail">

                <androidx.appcompat.widget.AppCompatTextView
                    android:id="@+id/tv_Addtofavorite"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="10dp"
                    android:fontFamily="@font/avenirltstd_roman"
                    android:text="@string/add_to_favorite"
                    android:textColor="@color/color_primary"
                    android:textSize="14sp"
                    android:drawableStart="@drawable/ic_heart"
                    android:drawablePadding="10dp"
                    android:gravity="center"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent" />
                />

            </androidx.constraintlayout.widget.ConstraintLayout>



    <androidx.core.widget.NestedScrollView
            android:layout_width="match_parent"
            android:layout_height="0dp"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/layout_Addtofavorite"
            app:layout_constraintBottom_toBottomOf="parent"
            android:layout_marginTop="10dp"
            >
        <androidx.constraintlayout.widget.ConstraintLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:padding="3dp"
        >

            <androidx.constraintlayout.widget.ConstraintLayout
                    android:id="@+id/layout_current"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="25dp"
                    android:layout_marginStart="5dp"
                    android:layout_marginEnd="15dp"
                    android:padding="8dp"
                    android:background="@color/white"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent">

                <com.google.android.material.imageview.ShapeableImageView
                        android:id="@+id/iv_currentProfile"
                        android:layout_width="70dp"
                        android:layout_height="70dp"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toTopOf="parent" />

                <androidx.appcompat.widget.AppCompatTextView
                        android:id="@+id/tv_currentdoctorName"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="10dp"
                        android:fontFamily="@font/avenirltstd_black"
                        android:gravity="start"
                        android:padding="3dp"
                        android:text=""
                        android:textColor="@color/black"
                        android:textSize="15sp"
                        app:layout_constraintStart_toEndOf="@+id/iv_currentProfile"
                        app:layout_constraintTop_toTopOf="@+id/iv_currentProfile" />

                <androidx.appcompat.widget.AppCompatTextView
                        android:id="@+id/tv_currentSpecialization"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="10dp"
                        android:layout_marginEnd="10dp"
                        android:layout_marginTop="5dp"
                        android:fontFamily="@font/avenirltstd_roman"
                        android:gravity="start"
                        android:padding="2dp"
                        android:text=""
                        android:textColor="@color/black"
                        android:textSize="15sp"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintStart_toEndOf="@+id/iv_currentProfile"
                        app:layout_constraintTop_toBottomOf="@+id/tv_currentdoctorName" />

            </androidx.constraintlayout.widget.ConstraintLayout>

            <androidx.appcompat.widget.AppCompatTextView
                    android:id="@+id/tv_AboutDoctor"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="10dp"
                    android:fontFamily="@font/avenirltstd_roman"
                    android:gravity="start"
                    android:layout_marginTop="5dp"
                    android:padding="2dp"
                    android:text="@string/about_doctor"
                    android:textColor="@color/black"
                    android:textSize="18sp"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@+id/layout_current" />

            <androidx.appcompat.widget.AppCompatTextView
                    android:id="@+id/AboutDoctor"
                    android:layout_width="match_parent"
                    android:layout_height="80dp"
                    android:layout_marginStart="10dp"
                    android:layout_marginEnd="15dp"
                    android:fontFamily="@font/avenirltstd_roman"
                    android:gravity="center_vertical"
                    android:background="@drawable/bg_edittext"
                    android:layout_marginTop="5dp"
                    android:padding="3dp"
                    android:text=""
                    android:textColor="@color/black"
                    android:textSize="14sp"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@+id/tv_AboutDoctor" />
            <androidx.appcompat.widget.AppCompatTextView
                    android:id="@+id/tv_clinicservices"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="10dp"
                    android:fontFamily="@font/avenirltstd_roman"
                    android:gravity="start"
                    android:layout_marginTop="5dp"
                    android:padding="2dp"
                    android:text="@string/clinicservices"
                    android:textColor="@color/black"
                    android:textSize="18sp"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@+id/AboutDoctor" />

            <androidx.appcompat.widget.AppCompatTextView
                    android:id="@+id/clinicservices"
                    android:layout_width="match_parent"
                    android:layout_height="80dp"
                    android:layout_marginStart="10dp"
                    android:layout_marginEnd="15dp"
                    android:fontFamily="@font/avenirltstd_roman"
                    android:gravity="center_vertical"
                    android:background="@drawable/bg_edittext"
                    android:layout_marginTop="5dp"
                    android:padding="3dp"
                    android:text=""
                    android:textColor="@color/black"
                    android:textSize="14sp"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@+id/tv_clinicservices" />

            <androidx.appcompat.widget.AppCompatTextView
                    android:id="@+id/tv_insurance"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="10dp"
                    android:fontFamily="@font/avenirltstd_roman"
                    android:gravity="start"
                    android:layout_marginTop="5dp"
                    android:padding="2dp"
                    android:text="@string/insurance_company"
                    android:textColor="@color/black"
                    android:textSize="18sp"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@+id/clinicservices" />

            <androidx.appcompat.widget.AppCompatTextView
                    android:id="@+id/insurance"
                    android:layout_width="match_parent"
                    android:layout_height="80dp"
                    android:layout_marginStart="10dp"
                    android:layout_marginEnd="15dp"
                    android:fontFamily="@font/avenirltstd_roman"
                    android:gravity="center_vertical"
                    android:background="@drawable/bg_edittext"
                    android:layout_marginTop="5dp"
                    android:padding="3dp"
                    android:text=""
                    android:textColor="@color/black"
                    android:textSize="14sp"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@+id/tv_insurance" />

            <androidx.appcompat.widget.AppCompatTextView
                    android:id="@+id/tv_features"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="10dp"
                    android:fontFamily="@font/avenirltstd_roman"
                    android:gravity="start"
                    android:layout_marginTop="5dp"
                    android:padding="2dp"
                    android:text="@string/features"
                    android:textColor="@color/black"
                    android:textSize="18sp"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@+id/insurance" />

            <androidx.appcompat.widget.AppCompatTextView
                    android:id="@+id/features"
                    android:layout_width="match_parent"
                    android:layout_height="80dp"
                    android:layout_marginStart="10dp"
                    android:layout_marginEnd="15dp"
                    android:fontFamily="@font/avenirltstd_roman"
                    android:gravity="center_vertical"
                    android:background="@drawable/bg_edittext"
                    android:layout_marginTop="5dp"
                    android:paddingStart="10dp"
                    android:padding="3dp"
                    android:text=""
                    android:textColor="@color/black"
                    android:textSize="14sp"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@+id/tv_features" />
            <androidx.appcompat.widget.AppCompatTextView
                    android:id="@+id/photo"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/avenirltstd_black"
                    android:gravity="start"
                    android:padding="2dp"
                    android:layout_marginTop="10dp"
                    android:layout_marginStart="15dp"
                    android:text="@string/photos"
                    android:textColor="@color/black"
                    android:textSize="15sp"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@+id/features"
                    />

            <androidx.constraintlayout.widget.ConstraintLayout
                    android:id="@+id/layout_photo"
                    android:layout_width="match_parent"
                    android:layout_height="150dp"
                    android:layout_marginTop="15dp"
                    android:layout_marginStart="2dp"
                    android:layout_marginEnd="2dp"
                    android:background="@drawable/bg_edittext"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                   app:layout_constraintTop_toBottomOf="@id/photo">

                <androidx.recyclerview.widget.RecyclerView
                        android:id="@+id/rv_gallry"
                        android:layout_width="match_parent"
                        android:layout_height="150dp"
                        android:layout_margin="10dp"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintEnd_toEndOf="parent"
                        android:paddingBottom="10dp"
                        android:orientation="horizontal"
                        app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"
                        tools:listitem="@layout/item_layout_images"
                        app:layout_constraintTop_toTopOf="parent"
                        app:layout_constraintBottom_toBottomOf="parent"
                        />

            </androidx.constraintlayout.widget.ConstraintLayout>
            <androidx.appcompat.widget.AppCompatTextView
                    android:id="@+id/videos"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/avenirltstd_black"
                    android:gravity="start"
                    android:padding="2dp"
                    android:layout_marginTop="10dp"
                    android:layout_marginStart="15dp"
                    android:text="@string/showDoctorvideos"
                    android:textColor="@color/black"
                    android:textSize="15sp"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@+id/layout_photo"
                    />
            <androidx.constraintlayout.widget.ConstraintLayout
                    android:id="@+id/layout_showDoctorVideos"
                    android:layout_width="match_parent"
                    android:layout_height="200dp"
                    android:layout_marginStart="10dp"
                    android:layout_marginTop="10dp"
                    android:padding="8dp"
                    android:background="@drawable/bg_edittext"
                    app:layout_constraintWidth_percent=".75"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintHorizontal_bias="0.5"
                    app:layout_constraintHorizontal_chainStyle="spread_inside"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@+id/videos">

                <androidx.recyclerview.widget.RecyclerView
                        android:id="@+id/view_pager"
                        android:layout_width="match_parent"
                        android:layout_height="0dp"
                        android:layout_marginStart="10dp"
                        android:layout_marginTop="20dp"
                        android:layout_marginEnd="10dp"
                        android:orientation="horizontal"
                        app:layout_constraintBottom_toBottomOf="parent"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toTopOf="parent"
                        />
                />

            </androidx.constraintlayout.widget.ConstraintLayout>

            <androidx.appcompat.widget.AppCompatTextView
                    android:id="@+id/doctorvideos"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/avenirltstd_black"
                    android:gravity="start"
                    android:padding="2dp"
                    android:layout_marginTop="10dp"
                    android:layout_marginStart="15dp"
                    android:text="@string/showclinicvideos"
                    android:textColor="@color/black"
                    android:textSize="15sp"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@+id/layout_showDoctorVideos"
                    />
            <androidx.constraintlayout.widget.ConstraintLayout
                    android:id="@+id/layout_showclinicVideos"
                    android:layout_width="match_parent"
                    android:layout_height="200dp"
                    android:layout_marginStart="10dp"
                    android:layout_marginTop="10dp"
                    android:padding="8dp"
                    android:background="@drawable/bg_edittext"
                    app:layout_constraintWidth_percent=".75"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintHorizontal_bias="0.5"
                    app:layout_constraintHorizontal_chainStyle="spread_inside"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@+id/doctorvideos">

                <androidx.recyclerview.widget.RecyclerView
                        android:id="@+id/view_pagerclinic"
                        android:layout_width="match_parent"
                        android:layout_height="0dp"
                        android:layout_marginStart="10dp"
                        android:layout_marginTop="20dp"
                        android:layout_marginEnd="10dp"
                        android:orientation="horizontal"
                        app:layout_constraintBottom_toBottomOf="parent"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toTopOf="parent"
                        />
                />

            </androidx.constraintlayout.widget.ConstraintLayout>

            <androidx.appcompat.widget.AppCompatTextView
                    android:id="@+id/Reviews"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/avenirltstd_black"
                    android:gravity="start"
                    android:padding="2dp"
                    android:layout_marginTop="10dp"
                    android:layout_marginStart="15dp"
                    android:text="@string/reviews"
                    android:textColor="@color/black"
                    android:textSize="15sp"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@+id/layout_showclinicVideos"
            />
            <androidx.appcompat.widget.AppCompatTextView
                    android:id="@+id/see_All"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/avenirltstd_black"
                    android:gravity="start"
                    android:padding="2dp"
                    android:layout_marginTop="10dp"
                    android:layout_marginEnd="@dimen/_15sdp"
                    android:text="@string/see_all"
                    android:textColor="@color/green"
                    android:textSize="15sp"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintTop_toBottomOf="@+id/layout_showclinicVideos"
            />

            <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/rv_Reviews"
                    android:layout_width="match_parent"
                    android:layout_height="220dp"
                    android:layout_margin="10dp"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"
                    android:paddingBottom="10dp"
                    android:orientation="horizontal"
                    app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"
                    tools:listitem="@layout/item_layout_reviews"
                    app:layout_constraintTop_toBottomOf="@+id/Reviews"
            />

            <androidx.appcompat.widget.AppCompatTextView
                    android:id="@+id/tv_DoctorsClinics"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="10dp"
                    android:fontFamily="@font/avenirltstd_roman"
                    android:gravity="start"
                    android:layout_marginTop="15dp"
                    android:padding="2dp"
                    android:text="@string/otherclinics"
                    android:textColor="@color/black"
                    android:textSize="18sp"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@+id/rv_Reviews"/>

            <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/rv_clinkDoctors"
                    android:layout_width="match_parent"
                    android:layout_height="250dp"
                    android:layout_margin="10dp"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"
                    android:paddingBottom="10dp"
                    tools:listitem="@layout/item_layout_clinks"
                    app:layout_constraintTop_toBottomOf="@+id/tv_DoctorsClinics"
                   app:layout_constraintBottom_toTopOf="@+id/btn_booking"
                    />

            <ProgressBar
                    android:id="@+id/progress_bar"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    app:layout_constraintEnd_toEndOf="@+id/rv_clinkDoctors"
                    app:layout_constraintStart_toStartOf="@+id/rv_clinkDoctors"
                    app:layout_constraintBottom_toBottomOf="@+id/rv_clinkDoctors"
                    app:layout_constraintTop_toTopOf="@+id/rv_clinkDoctors"
                    android:visibility="gone"
            />
            <androidx.appcompat.widget.AppCompatButton
                    android:id="@+id/btn_booking"
                    android:layout_width="0dp"
