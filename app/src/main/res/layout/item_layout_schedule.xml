<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
        xmlns:app="http://schemas.android.com/apk/res-auto">

    <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

        <androidx.cardview.widget.CardView
                android:id="@+id/cardview"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardCornerRadius="10dp"
                app:cardUseCompatPadding="true"
                android:background="@drawable/more_cards_background"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent">

            <androidx.constraintlayout.widget.ConstraintLayout
                    android:id="@+id/layput_services"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                android:layout_marginStart="10dp"
                android:layout_marginTop="10dp"
                    android:padding="5dp">

                <androidx.constraintlayout.widget.ConstraintLayout
                        android:id="@+id/layout_doctorsDetail"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toTopOf="parent">

                    <com.google.android.material.imageview.ShapeableImageView
                            android:id="@+id/iv_doctorProfile"
                            android:layout_width="70dp"
                            android:layout_height="70dp"
                            android:layout_marginStart="10dp"
                            android:layout_marginTop="10dp"
                        android:translationY="10dp"
                            android:src="@drawable/ic_docspecialization"
                            app:layout_constraintStart_toStartOf="parent"
                            app:layout_constraintTop_toTopOf="parent" />

                    <androidx.appcompat.widget.AppCompatTextView
                            android:id="@+id/tv_Dr"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="10dp"
                            android:fontFamily="@font/avenirltstd_roman"
                            android:gravity="start"
                            android:text="@string/dr"
                            android:textColor="@color/black"
                            android:textSize="12sp"
                            app:layout_constraintEnd_toStartOf="@+id/tv_doctorName"
                            app:layout_constraintStart_toEndOf="@+id/iv_doctorProfile"
                            app:layout_constraintTop_toTopOf="@+id/tv_doctorName"
                            app:layout_constraintBottom_toBottomOf="@+id/tv_doctorName" />

                    <androidx.appcompat.widget.AppCompatTextView
                            android:id="@+id/tv_doctorName"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="@dimen/_3sdp"
                            android:ellipsize="end"
                            android:fontFamily="@font/sf_pro_display_semibold"
                            android:gravity="start"
                            android:lines="1"
                            android:text="osama"
                            android:textColor="@color/black"
                            android:textSize="16sp"
                            app:layout_constraintEnd_toEndOf="parent"
                            app:layout_constraintStart_toEndOf="@+id/tv_Dr"
                            app:layout_constraintTop_toTopOf="@+id/iv_doctorProfile" />

                    <androidx.appcompat.widget.AppCompatTextView
                            android:id="@+id/tv_Specialization"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="10dp"
                            android:fontFamily="@font/sf_pro_display_semibold"
                            android:gravity="start"
                            android:padding="2dp"
                            android:maxLines="2"
                            android:ellipsize="end"
                            android:text="Genecology and Infertility"
                            android:textColor="@color/text_doctor_card_color"
                            android:textSize="14sp"
                            app:layout_constraintStart_toEndOf="@+id/iv_doctorProfile"
                            app:layout_constraintTop_toBottomOf="@+id/tv_doctorName" />

                    <androidx.appcompat.widget.AppCompatRatingBar
                        android:id="@+id/doc_ratingBar"
                        style="@style/Widget.AppCompat.RatingBar.Small"
                        android:theme="@style/ratingBar"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="10dp"
                        android:layout_marginTop="4dp"
                        android:isIndicator="true"
                        android:rating="4"
                        android:scaleX="1.1"
                        android:scaleY="1.1"
                        android:stepSize="0.5"
                        android:translationX="1dp"
                        app:layout_constraintStart_toEndOf="@+id/iv_doctorProfile"
                        app:layout_constraintTop_toBottomOf="@+id/tv_Specialization" />

                    <androidx.appcompat.widget.AppCompatTextView
                        android:id="@+id/Reviews"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="8dp"
                        android:background="@drawable/bg_rating_badge"
                        android:fontFamily="@font/sd_pro_display_regular"
                        android:paddingHorizontal="4dp"
                        android:paddingVertical="2dp"
                        android:text="8.0"
                        android:textColor="@color/white"
                        android:textSize="12sp"
                        app:layout_constraintBottom_toBottomOf="@+id/doc_ratingBar"
                        app:layout_constraintStart_toEndOf="@+id/doc_ratingBar"
                        app:layout_constraintTop_toTopOf="@+id/doc_ratingBar" />

                    <androidx.appcompat.widget.AppCompatTextView
                        android:id="@+id/tv_Reviews"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:fontFamily="@font/sd_pro_display_regular"
                        android:gravity="center"
                        android:text="0 Reviews"
                        android:textColor="@color/text_doctor_card_color"
                        android:textSize="11sp"
                        app:layout_constraintEnd_toEndOf="@+id/Reviews"
                        app:layout_constraintStart_toStartOf="@+id/doc_ratingBar"
                        app:layout_constraintTop_toBottomOf="@+id/doc_ratingBar" />

                    <com.google.android.material.imageview.ShapeableImageView
                            android:id="@+id/iv_offer"
                            android:layout_width="42dp"
                            android:layout_height="42dp"
                            android:src="@drawable/iv_offer"
                            android:visibility="gone"
                            app:layout_constraintEnd_toEndOf="parent"
                            app:layout_constraintTop_toTopOf="parent"
                            app:layout_constraintBottom_toBottomOf="parent" />


                </androidx.constraintlayout.widget.ConstraintLayout>


                <androidx.constraintlayout.widget.ConstraintLayout
                        android:id="@+id/layout_Subspecialization"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"

                        android:padding="5dp"
                        app:layout_constraintTop_toBottomOf="@+id/layout_doctorsDetail">

                    <androidx.constraintlayout.widget.ConstraintLayout
                            android:id="@+id/layout_Sub_specialization"
                            android:layout_width="30dp"
                            android:layout_height="30dp"
                            android:layout_marginTop="10dp"
                            android:layout_marginStart="10dp"
                            app:layout_constraintStart_toStartOf="parent"
                            app:layout_constraintTop_toTopOf="parent">

                        <com.google.android.material.imageview.ShapeableImageView
                                android:id="@+id/iv_sub_specialization"
                                android:layout_width="21dp"
                                android:layout_height="21dp"
                                android:adjustViewBounds="true"
                                android:src="@drawable/svg_clinic_visit"
                                app:layout_constraintBottom_toBottomOf="parent"
                                app:layout_constraintEnd_toEndOf="parent"
                                app:layout_constraintStart_toStartOf="parent"
                                app:layout_constraintTop_toTopOf="parent" />
                    </androidx.constraintlayout.widget.ConstraintLayout>

                    <androidx.appcompat.widget.AppCompatTextView
                            android:id="@+id/tv_sub_specialization"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="10dp"
                            android:layout_marginTop="10dp"
                            android:fontFamily="@font/avenirltstd_roman"
                            android:gravity="start"
                            android:padding="2dp"
                            android:visibility="gone"
                            android:text="@string/service"
                            android:textColor="@color/black"
                            android:textSize="15sp"
                            app:layout_constraintStart_toEndOf="@+id/layout_Sub_specialization"
                            app:layout_constraintBottom_toBottomOf="@+id/layout_Sub_specialization"
                            app:layout_constraintTop_toTopOf="parent" />

                    <androidx.appcompat.widget.AppCompatTextView
                            android:id="@+id/Service"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="15dp"
                            android:layout_marginTop="10dp"
                            android:layout_marginEnd="10dp"
                            android:ellipsize="end"
                            android:fontFamily="@font/sf_pro_display_semibold"
                            android:gravity="start"
                            android:padding="2dp"
                            android:text="Gynecology and Infertility"
                            android:textSize="14sp"
                        android:textColor="@color/blue"

                        app:layout_constraintBottom_toBottomOf="parent"
                            app:layout_constraintEnd_toEndOf="parent"
                            app:layout_constraintHorizontal_bias="0.0"
                            app:layout_constraintStart_toEndOf="@+id/tv_sub_specialization"
                            app:layout_constraintTop_toTopOf="parent"
                            app:layout_constraintVertical_bias="0.555" />
                </androidx.constraintlayout.widget.ConstraintLayout>

                <androidx.constraintlayout.widget.ConstraintLayout
                        android:id="@+id/Address"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:padding="5dp"
                        app:layout_constraintTop_toBottomOf="@+id/layout_Subspecialization">

                    <androidx.constraintlayout.widget.ConstraintLayout
                            android:id="@+id/layout_Address"
                            android:layout_width="30dp"
                            android:layout_height="30dp"
                            android:layout_marginStart="10dp"
                            app:layout_constraintStart_toStartOf="parent"
                            app:layout_constraintTop_toTopOf="parent">

                        <com.google.android.material.imageview.ShapeableImageView
                                android:id="@+id/iv_Address"
                                android:layout_width="21dp"
                                android:layout_height="21dp"
                                android:adjustViewBounds="true"
                                android:src="@drawable/stethoscope"
                                app:layout_constraintBottom_toBottomOf="parent"
                                app:layout_constraintEnd_toEndOf="parent"
                                app:layout_constraintStart_toStartOf="parent"
                                app:layout_constraintTop_toTopOf="parent" />
                    </androidx.constraintlayout.widget.ConstraintLayout>

                    <androidx.appcompat.widget.AppCompatTextView
                            android:id="@+id/tv_Address"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="10dp"
                            android:fontFamily="@font/avenirltstd_roman"
                            android:gravity="start"
                            android:padding="2dp"
                            android:text="@string/address"
                            android:textColor="@color/black"
                            android:textSize="15sp"
                            android:visibility="gone"
                            app:layout_constraintStart_toEndOf="@+id/layout_Address"
                            app:layout_constraintBottom_toBottomOf="@+id/layout_Address"
                            app:layout_constraintTop_toTopOf="parent" />

                    <androidx.appcompat.widget.AppCompatTextView
                            android:id="@+id/location"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="15dp"
                            android:fontFamily="@font/sf_pro_display_semibold"
                            android:gravity="start"
                            android:padding="3dp"
                            android:text=""
                            android:maxLines="2"
                            android:ellipsize="end"
                        android:textColor="@color/blue"
                            android:textSize="14sp"
                            app:layout_constraintEnd_toEndOf="parent"
                            app:layout_constraintStart_toEndOf="@+id/tv_Address"
                            app:layout_constraintBottom_toBottomOf="parent"
                            app:layout_constraintTop_toTopOf="parent" />
                </androidx.constraintlayout.widget.ConstraintLayout>

                <androidx.constraintlayout.widget.ConstraintLayout
                    android:id="@+id/address"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:padding="5dp"
                    app:layout_constraintTop_toBottomOf="@+id/Address">

                    <!-- ICON -->
                    <androidx.constraintlayout.widget.ConstraintLayout
                        android:id="@+id/layout_address"
                        android:layout_width="30dp"
                        android:layout_height="30dp"
                        android:layout_marginStart="10dp"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toTopOf="parent">

                        <com.google.android.material.imageview.ShapeableImageView
                            android:id="@+id/iv_address"
                            android:layout_width="21dp"
                            android:layout_height="21dp"
                            android:adjustViewBounds="true"
                            android:src="@drawable/ic_location"
                            android:tint="#8088A4"
                            app:layout_constraintBottom_toBottomOf="parent"
                            app:layout_constraintEnd_toEndOf="parent"
                            app:layout_constraintStart_toStartOf="parent"
                            app:layout_constraintTop_toTopOf="parent" />

                    </androidx.constraintlayout.widget.ConstraintLayout>

                    <!-- TITLE (optional label) -->
                    <androidx.appcompat.widget.AppCompatTextView
                        android:id="@+id/tv_address_label"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="10dp"
                        android:fontFamily="@font/avenirltstd_roman"
                        android:text="@string/address"
                        android:textColor="@color/black"
                        android:textSize="15sp"
                        android:visibility="gone"
                        app:layout_constraintStart_toEndOf="@+id/layout_address"
                        app:layout_constraintTop_toTopOf="@+id/layout_address"
                        app:layout_constraintBottom_toBottomOf="@+id/layout_address" />

                    <!-- VALUE -->
                    <!-- VALUE -->
                    <androidx.appcompat.widget.AppCompatTextView
                        android:id="@+id/tvv_address"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="15dp"
                        android:layout_marginEnd="8dp"
                        android:fontFamily="@font/sf_pro_display_semibold"
                        android:gravity="start|center_vertical"
                        android:padding="3dp"
                        android:text="Clinic Address"
                        android:textColor="@color/blue"
                        android:textSize="14sp"
                        app:layout_constraintHorizontal_bias="0.0"
                        app:layout_constraintStart_toEndOf="@+id/layout_address"
                        app:layout_constraintEnd_toStartOf="@+id/btn_track_queue"
                        app:layout_constraintTop_toTopOf="parent"
                        app:layout_constraintBottom_toBottomOf="parent" />

                    <!-- TRACK QUEUE BUTTON -->
                    <androidx.constraintlayout.widget.ConstraintLayout
                        android:id="@+id/btn_track_queue"
                        android:layout_width="wrap_content"
                        android:layout_height="32dp"
                        android:layout_marginEnd="10dp"
                        android:background="@drawable/bg_track_queue_pill"
                        android:paddingStart="10dp"
                        android:paddingEnd="12dp"
                        app:layout_constraintBottom_toBottomOf="parent"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintTop_toTopOf="parent">

                        <ImageView
                            android:id="@+id/iv_track_queue"
                            android:layout_width="16dp"
                            android:layout_height="16dp"
                            android:src="@drawable/ic_watingtime"
                            app:tint="@color/blue"
                            app:layout_constraintBottom_toBottomOf="parent"
                            app:layout_constraintStart_toStartOf="parent"
                            app:layout_constraintTop_toTopOf="parent" />

                        <TextView
                            android:id="@+id/tv_track_queue"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="6dp"
                            android:fontFamily="@font/sf_pro_display_semibold"
                            android:text="@string/track_queue"
                            android:textColor="@color/blue"
                            android:textSize="12sp"
                            app:layout_constraintBottom_toBottomOf="parent"
                            app:layout_constraintEnd_toEndOf="parent"
                            app:layout_constraintStart_toEndOf="@+id/iv_track_queue"
                            app:layout_constraintTop_toTopOf="parent" />

                    </androidx.constraintlayout.widget.ConstraintLayout>

                </androidx.constraintlayout.widget.ConstraintLayout>

                <androidx.constraintlayout.widget.ConstraintLayout
                        android:id="@+id/phone"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:padding="5dp"
                        app:layout_constraintTop_toBottomOf="@+id/address">

                    <androidx.constraintlayout.widget.ConstraintLayout
                            android:id="@+id/layout_phone"
                            android:layout_width="30dp"
                            android:layout_height="30dp"
                            android:layout_marginStart="10dp"
                            app:layout_constraintStart_toStartOf="parent"
                            app:layout_constraintTop_toTopOf="parent">

                        <com.google.android.material.imageview.ShapeableImageView
                                android:id="@+id/iv_phone"
                                android:layout_width="21dp"
                                android:layout_height="21dp"
                                android:adjustViewBounds="true"
                                android:src="@drawable/money"
                                app:layout_constraintBottom_toBottomOf="parent"
                                app:layout_constraintEnd_toEndOf="parent"
                                app:layout_constraintStart_toStartOf="parent"
                                app:layout_constraintTop_toTopOf="parent" />

                    </androidx.constraintlayout.widget.ConstraintLayout>

                    <androidx.appcompat.widget.AppCompatTextView
                            android:id="@+id/tv_phone"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="10dp"
                            android:fontFamily="@font/avenirltstd_roman"
                            android:gravity="start"
                            android:padding="2dp"
                            android:text="@string/clinicphone"
                            android:textColor="@color/black"
                            android:textSize="15sp"
                            android:visibility="gone"
                            app:layout_constraintStart_toEndOf="@+id/layout_phone"
                            app:layout_constraintBottom_toBottomOf="@+id/layout_phone"
                            app:layout_constraintTop_toTopOf="parent" />

                    <androidx.appcompat.widget.AppCompatTextView
                            android:id="@+id/phones"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="15dp"
                            android:fontFamily="@font/sf_pro_display_semibold"
                            android:gravity="start"
                            android:padding="3dp"
                            android:text="200"
                        android:textColor="@color/blue"
                            android:textSize="14sp"
                            app:layout_constraintEnd_toEndOf="parent"
                            app:layout_constraintStart_toEndOf="@+id/tv_phone"
                            app:layout_constraintBottom_toBottomOf="parent"
                            app:layout_constraintTop_toTopOf="parent" />


                </androidx.constraintlayout.widget.ConstraintLayout>


                <androidx.constraintlayout.widget.ConstraintLayout
                        android:id="@+id/Waiting_Time"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:padding="5dp"
                        android:visibility="gone"
                        app:layout_constraintTop_toBottomOf="@+id/phone">

                    <androidx.constraintlayout.widget.ConstraintLayout
                            android:id="@+id/layout_Waiting_Time"
                            android:layout_width="30dp"
                            android:layout_height="30dp"
                            android:layout_marginStart="10dp"
                            android:background="@drawable/bg_image_circle"
                            app:layout_constraintStart_toStartOf="parent"
                            app:layout_constraintTop_toTopOf="parent">

                        <com.google.android.material.imageview.ShapeableImageView
                                android:id="@+id/iv_WaitingTime"
                                android:layout_width="18dp"
                                android:layout_height="18dp"
                                android:adjustViewBounds="true"
                                android:src="@drawable/ic_watingtime"
                                app:layout_constraintBottom_toBottomOf="parent"
                                app:layout_constraintEnd_toEndOf="parent"
                                app:layout_constraintStart_toStartOf="parent"
                                app:layout_constraintTop_toTopOf="parent" />
                    </androidx.constraintlayout.widget.ConstraintLayout>

                    <androidx.appcompat.widget.AppCompatTextView
                            android:id="@+id/tv_WaitingTime"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="10dp"
                            android:fontFamily="@font/avenirltstd_roman"
                            android:gravity="start"
                            android:padding="2dp"
                            android:text="@string/date_time"
                            android:textColor="@color/black"
                            android:textSize="15sp"
                            app:layout_constraintStart_toEndOf="@+id/layout_Waiting_Time"
                            app:layout_constraintBottom_toBottomOf="@+id/layout_Waiting_Time"
                            app:layout_constraintTop_toTopOf="parent" />

                    <androidx.appcompat.widget.AppCompatTextView
                            android:id="@+id/waitingTime"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="10dp"
                            android:layout_marginEnd="10dp"
                            android:fontFamily="@font/avenirltstd_black"
                            android:gravity="end"
                            android:padding="2dp"
                            android:text=""
                            android:textColor="@color/gray"
                            android:textSize="12sp"
                            app:layout_constraintEnd_toEndOf="parent"
                            app:layout_constraintStart_toEndOf="@+id/tv_WaitingTime"
                            app:layout_constraintBottom_toBottomOf="@+id/tv_WaitingTime"
                            app:layout_constraintTop_toTopOf="parent" />
                </androidx.constraintlayout.widget.ConstraintLayout>

                <androidx.constraintlayout.widget.ConstraintLayout
                        android:id="@+id/Fees"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:padding="5dp"
                        android:visibility="gone"
                        app:layout_constraintTop_toBottomOf="@+id/Waiting_Time">

                    <androidx.constraintlayout.widget.ConstraintLayout
                            android:id="@+id/layout_Fees"
                            android:layout_width="30dp"
                            android:layout_height="30dp"
                            android:layout_marginStart="10dp"
                            android:background="@drawable/bg_image_circle"
                            app:layout_constraintStart_toStartOf="parent"
                            app:layout_constraintTop_toTopOf="parent">

                        <com.google.android.material.imageview.ShapeableImageView
                                android:id="@+id/iv_Fees"
                                android:layout_width="18dp"
                                android:layout_height="18dp"
                                android:adjustViewBounds="true"
                                android:src="@drawable/ic_fees"
                                app:layout_constraintBottom_toBottomOf="parent"
                                app:layout_constraintEnd_toEndOf="parent"
                                app:layout_constraintStart_toStartOf="parent"
                                app:layout_constraintTop_toTopOf="parent" />
                    </androidx.constraintlayout.widget.ConstraintLayout>

                    <androidx.appcompat.widget.AppCompatTextView
                            android:id="@+id/tv_Fees"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="10dp"
                            android:fontFamily="@font/avenirltstd_roman"
                            android:gravity="start"
                            android:padding="2dp"
                            android:text="@string/fees"
                            android:textColor="@color/black"
                            android:textSize="15sp"
                            app:layout_constraintStart_toEndOf="@+id/layout_Fees"
                            app:layout_constraintBottom_toBottomOf="@+id/layout_Fees"
                            app:layout_constraintTop_toTopOf="parent" />

                    <androidx.appcompat.widget.AppCompatTextView
                            android:id="@+id/Feesresult"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="10dp"
                            android:layout_marginEnd="10dp"
                            android:fontFamily="@font/avenirltstd_black"
                            android:gravity="end"
                            android:padding="2dp"
                            android:text="200"
                            android:textColor="@color/gray"
                            android:textSize="12sp"
                            app:layout_constraintEnd_toEndOf="parent"
                            app:layout_constraintStart_toEndOf="@+id/tv_Fees"
                            app:layout_constraintBottom_toBottomOf="@+id/tv_Fees"
                            app:layout_constraintTop_toTopOf="parent" />
                </androidx.constraintlayout.widget.ConstraintLayout>

                <androidx.constraintlayout.widget.ConstraintLayout
                        android:id="@+id/layout"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toBottomOf="@+id/phone"
                        app:layout_constraintBottom_toBottomOf="parent"
                        android:layout_marginBottom="5dp"
                        app:layout_constraintWidth_percent=".95"
                        android:layout_marginTop="10dp"
                        android:layout_marginStart="10dp">

                    <androidx.constraintlayout.widget.ConstraintLayout
                            android:id="@+id/layout_Location"
                            android:layout_width="0dp"
                            android:layout_height="36dp"
                            android:layout_marginEnd="10dp"
                            android:background="@drawable/bg_help"
                            android:padding="8dp"
                            app:layout_constraintBottom_toBottomOf="parent"
                            app:layout_constraintEnd_toStartOf="@+id/layout_Support"
                            app:layout_constraintHorizontal_chainStyle="spread_inside"
                            app:layout_constraintStart_toStartOf="parent"
                            app:layout_constraintTop_toTopOf="parent"
                            app:layout_constraintVertical_bias="0.0">

                        <androidx.appcompat.widget.AppCompatTextView
                                android:id="@+id/tv_help"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginEnd="5dp"
                                android:fontFamily="@font/sf_pro_display_semibold"
                                android:text="@string/location"
                                android:textColor="@color/blue"
                                android:textSize="13sp"
                                app:layout_constraintBottom_toBottomOf="parent"
                                app:layout_constraintStart_toEndOf="@+id/iv_filter"
                                app:layout_constraintEnd_toEndOf="parent"
