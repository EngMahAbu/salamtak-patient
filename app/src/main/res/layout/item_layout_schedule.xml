                            app:layout_constraintStart_toEndOf="@+id/layout_Location"
                            app:layout_constraintTop_toTopOf="parent"
                            app:layout_constraintVertical_bias="0.0">

                        <androidx.appcompat.widget.AppCompatTextView
                                android:id="@+id/tv_Support"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginEnd="5dp"
                                android:fontFamily="@font/sf_pro_display_semibold"
                                android:text="@string/support"
                                android:textColor="@color/blue"
                                android:textSize="13sp"
                                app:layout_constraintBottom_toBottomOf="parent"
                                app:layout_constraintStart_toEndOf="@+id/iv_Support"
                                app:layout_constraintEnd_toEndOf="parent"
                                app:layout_constraintTop_toTopOf="parent" />

                        <com.google.android.material.imageview.ShapeableImageView
                                android:id="@+id/iv_Support"
                                android:layout_width="16dp"
                                android:layout_height="16dp"
                                android:layout_marginEnd="5dp"
                                android:adjustViewBounds="true"
                                android:src="@drawable/svg_support"
                                android:tint="@color/blue"
                                app:layout_constraintHorizontal_chainStyle="packed"
                                app:layout_constraintBottom_toBottomOf="@+id/tv_Support"
                                app:layout_constraintEnd_toStartOf="@+id/tv_Support"
                                app:layout_constraintStart_toStartOf="parent"
                                app:layout_constraintTop_toTopOf="@+id/tv_Support" />


                    </androidx.constraintlayout.widget.ConstraintLayout>

                    <androidx.constraintlayout.widget.ConstraintLayout
                            android:id="@+id/layout_Actions"
                            android:layout_width="0dp"
                            android:layout_height="36dp"
                            android:layout_marginEnd="5dp"
                            android:background="@drawable/bg_help"
                            android:padding="8dp"
                            app:layout_constraintBottom_toBottomOf="parent"
                            app:layout_constraintEnd_toEndOf="parent"
                            app:layout_constraintHorizontal_bias="0.506"
                            app:layout_constraintStart_toEndOf="@+id/layout_Support"
                            app:layout_constraintTop_toTopOf="parent"
                            app:layout_constraintVertical_bias="0.0">

                        <androidx.appcompat.widget.AppCompatTextView
                                android:id="@+id/tv_Actions"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginEnd="5dp"
                                android:fontFamily="@font/sf_pro_display_semibold"
                                android:text="@string/more_actions"
                                android:textColor="@color/blue"
                                android:textSize="13sp"
                                android:ellipsize="end"
                                app:layout_constraintBottom_toBottomOf="parent"
                                app:layout_constraintStart_toEndOf="@+id/iv_Actions"
                                app:layout_constraintEnd_toEndOf="parent"
                                app:layout_constraintTop_toTopOf="parent" />

                        <com.google.android.material.imageview.ShapeableImageView
                                android:id="@+id/iv_Actions"
