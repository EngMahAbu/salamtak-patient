<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
        xmlns:android="http://schemas.android.com/apk/res/android"
        xmlns:tools="http://schemas.android.com/tools"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        xmlns:app="http://schemas.android.com/apk/res-auto"
        tools:context=".fragment.favoritedoctor.FavoriteDoctorFragment">

    <com.google.android.material.imageview.ShapeableImageView
            android:id="@+id/iv_arrow"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="15dp"
            android:adjustViewBounds="true"
            android:padding="10dp"
            android:src="@drawable/ic_arrowleft"
            app:layout_constraintBottom_toBottomOf="@+id/tv_name"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="@+id/tv_name"/>

    <androidx.appcompat.widget.AppCompatTextView
            android:id="@+id/tv_name"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="15dp"
            android:layout_marginTop="20dp"
            android:fontFamily="@font/avenirltstd_black"
            android:text="@string/favorite_doctor"
            android:textColor="@color/black"
            android:textSize="16sp"
            app:layout_constraintStart_toEndOf="@+id/iv_arrow"
            app:layout_constraintTop_toTopOf="parent"/>

    <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rv_favoriteDoctor"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_marginTop="@dimen/_5sdp"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            android:clipToPadding="false"
            android:paddingBottom="5dp"
            android:visibility="visible"
            android:layout_marginStart="15dp"
            tools:listitem="@layout/item_layout_favoritedoctor"
            app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"
            app:layout_constraintTop_toBottomOf="@+id/tv_name"
            app:layout_constraintBottom_toBottomOf="parent"
    />
    <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/layout_cardview"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:visibility="gone"
            app:layout_constraintStart_toStartOf="@+id/rv_favoriteDoctor"
            app:layout_constraintEnd_toEndOf="@+id/rv_favoriteDoctor"
            app:layout_constraintTop_toTopOf="@+id/rv_favoriteDoctor"
            app:layout_constraintBottom_toBottomOf="@+id/rv_favoriteDoctor">
        <ImageView
                android:id="@+id/gifImageView"
                android:layout_width="@dimen/_120sdp"
                android:layout_height="120dp"
                android:scaleType="fitCenter"
                android:visibility="visible"
                android:src="@drawable/favoriteicon"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                />

        <TextView
                android:id="@+id/crd_view"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/no_data_registed"
                android:layout_marginTop="8dp"
                android:fontFamily="@font/sf_pro_display_semibold"
                android:textColor="@color/black"
                android:visibility="visible"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/gifImageView"
                android:textSize="20sp" />

        <TextView
                android:id="@+id/textchange"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/try_searching_for_a_different_specialty_or_change_your_location_to_see_more_available_doctors"
                android:fontFamily="@font/sd_pro_display_regular"
                android:textColor="@color/text_doctor_card_color"
                android:visibility="gone"
                android:gravity="center_vertical"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/crd_view"
                android:layout_marginTop="8dp"
                android:layout_marginStart="30dp"
                android:layout_marginEnd="30dp"
                android:textSize="16sp" />
    </androidx.constraintlayout.widget.ConstraintLayout>

    <ProgressBar
            android:id="@+id/progress_bar"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:indeterminateTint="@color/blue"
            app:layout_constraintEnd_toEndOf="@+id/rv_favoriteDoctor"
            app:layout_constraintStart_toStartOf="@+id/rv_favoriteDoctor"
            app:layout_constraintBottom_toBottomOf="@+id/rv_favoriteDoctor"
            app:layout_constraintTop_toTopOf="@+id/rv_favoriteDoctor"
            android:visibility="gone" />

</androidx.constraintlayout.widget.ConstraintLayout>