<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
        xmlns:android="http://schemas.android.com/apk/res/android"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="4dp"
        xmlns:app="http://schemas.android.com/apk/res-auto">

    <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/layout_doctorsDetail"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:elevation="1dp"
            android:padding="@dimen/_2sdp"
            android:background="@drawable/bg_popular_specialties"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent">

        <com.google.android.material.imageview.ShapeableImageView
                android:id="@+id/iv_doctorProfile"
                android:layout_width="80dp"
                android:layout_height="80dp"
                android:layout_marginTop="8dp"
                android:src="@drawable/ic_docspecialization"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="parent" />

        <androidx.appcompat.widget.AppCompatTextView
                android:id="@+id/tv_doctorName"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/sf_pro_display_semibold"
                android:gravity="center_horizontal"
                android:padding="3dp"
                android:lines="1"
                android:ellipsize="end"
                android:text="Dr. Mohamed Farag Abdullatif"
                android:textColor="@color/black"
                android:textSize="14sp"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/iv_doctorProfile" />

        <androidx.appcompat.widget.AppCompatTextView
                android:id="@+id/tv_Specialization"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="1dp"
                android:lines="1"
                android:ellipsize="end"
                android:fontFamily="@font/sf_pro_display_semibold"
                android:gravity="center_horizontal"
                android:padding="1dp"
                android:text="Genecology and Infertility"
                android:textColor="#8088A4"
                android:textSize="12sp"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/tv_doctorName" />
        >

        <androidx.appcompat.widget.AppCompatTextView
                android:id="@+id/Ratecount"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="5dp"
                android:fontFamily="@font/sf_pro_display_semibold"
                android:gravity="start"
                android:layout_marginTop="@dimen/_3sdp"
                android:text="0"
                android:textColor="@color/black"
                android:textSize="10sp"
                android:layout_marginBottom="8dp"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintStart_toEndOf="@+id/ratingBar"
                app:layout_constraintEnd_toStartOf="@+id/tv_Reviews"
                app:layout_constraintTop_toBottomOf="@+id/tv_Specialization" />

        <androidx.appcompat.widget.AppCompatTextView
                android:id="@+id/tv_Reviews"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="3dp"
                android:fontFamily="@font/sf_pro_display_semibold"
                android:gravity="start"
                android:layout_marginTop="@dimen/_3sdp"
                android:text="@string/reviews"
                android:textColor="#8088A4"
                android:textSize="10sp"
                android:layout_marginBottom="8dp"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintStart_toEndOf="@+id/Ratecount"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/tv_Specialization"
                app:layout_constraintHorizontal_bias="0.5" />

<!--        <androidx.appcompat.widget.AppCompatRatingBar-->
<!--                android:id="@+id/ratingBar"-->
<!--                android:layout_width="wrap_content"-->
<!--                android:layout_height="wrap_content"-->
<!--                android:layout_marginStart="15dp"-->
<!--                android:rating="1"-->
<!--                android:theme="@style/ratingBar"-->
<!--                android:layout_marginTop="@dimen/_3sdp"-->
<!--                style="?android:attr/ratingBarStyleSmall"-->
<!--                android:transformPivotX="0dp"-->
<!--                android:transformPivotY="0dp"-->
<!--                android:isIndicator="true"-->
<!--                android:minHeight="@dimen/_8sdp"-->
<!--                android:minWidth="@dimen/_4sdp"-->
<!--                app:layout_constraintTop_toBottomOf="@+id/tv_Specialization"-->
<!--                app:layout_constraintStart_toStartOf="parent"-->
<!--                android:layout_marginBottom="8dp"-->
<!--                app:layout_constraintBottom_toBottomOf="parent"-->
<!--                app:layout_constraintHorizontal_bias="0.5"-->
<!--                app:layout_constraintEnd_toStartOf="@+id/Ratecount"-->
<!--                app:layout_constraintHorizontal_chainStyle="packed" />-->

        <com.google.android.material.imageview.ShapeableImageView
                android:id="@+id/ratingBar"
                android:layout_width="11dp"
                android:layout_height="11dp"
                android:src="@drawable/star"
                app:layout_constraintTop_toBottomOf="@+id/tv_Specialization"
                app:layout_constraintStart_toStartOf="parent"
                android:layout_marginBottom="8dp"
                android:layout_marginTop="@dimen/_3sdp"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintHorizontal_bias="0.5"
                app:layout_constraintEnd_toStartOf="@+id/Ratecount"
                app:layout_constraintHorizontal_chainStyle="packed"  />

    </androidx.constraintlayout.widget.ConstraintLayout>

</androidx.constraintlayout.widget.ConstraintLayout>