<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout
        xmlns:android="http://schemas.android.com/apk/res/android"
        xmlns:tools="http://schemas.android.com/tools"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/bg_color_gray"
        xmlns:app="http://schemas.android.com/apk/res-auto"
        tools:context=".fragment.home.SpecialistDoctorsFragment">
    <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent">

    <com.google.android.material.imageview.ShapeableImageView
            android:id="@+id/iv_arrow"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="15dp"
            android:adjustViewBounds="true"
            android:padding="10dp"
            android:src="@drawable/ic_arrowleft"
            app:layout_constraintBottom_toBottomOf="@+id/tv_search"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="@+id/tv_search" />
    <androidx.appcompat.widget.AppCompatTextView
            android:id="@+id/tv_search"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="15dp"
            android:layout_marginTop="30dp"
            android:fontFamily="@font/avenirltstd_black"
            android:text="@string/home"
            android:textColor="@color/black"
            android:textSize="16sp"
            app:layout_constraintStart_toEndOf="@+id/iv_arrow"
            app:layout_constraintTop_toTopOf="parent" />

        <androidx.constraintlayout.widget.ConstraintLayout
                android:id="@+id/layout_Choose_analysis"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="15dp"
                android:layout_marginEnd="15dp"
                android:layout_marginTop="15dp"
                android:visibility="gone"
                android:background="@drawable/bg_edittext"
                android:elevation="1dp"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/tv_search">

            <androidx.appcompat.widget.AppCompatImageView
                    android:id="@+id/iv_arrowdownChoose_Clinic"
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:layout_gravity="center_horizontal"
                    android:layout_marginEnd="12dp"
                    android:layout_marginBottom="12dp"
                    android:padding="2dp"
                    android:gravity="start"
                    android:src="@drawable/ic_arrowdwon"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintEnd_toEndOf="parent" />

            <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/textinput_Choose_analysis"
                    style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                    android:layout_width="match_parent"
                    android:layout_height="50dp"
                    android:layout_marginEnd="25dp"
                    android:layout_marginBottom="5dp"
                    android:hint="@string/selectanalysis"
                    android:paddingTop="2dp"
                    android:gravity="center"
                    app:boxBackgroundColor="@color/white"
                    app:boxBackgroundMode="none"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent">

                <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/et_Choose_Clinic"
                        android:layout_width="match_parent"
                        android:layout_height="55dp"
                        android:layout_gravity="center_horizontal"
                        android:enabled="false"
                        android:inputType="text"
                        android:text=""
                        android:textColor="@color/black"
                        android:textSize="12sp" />

            </com.google.android.material.textfield.TextInputLayout>

        </androidx.constraintlayout.widget.ConstraintLayout>


    <EditText
            android:id="@+id/et_search"
            android:layout_width="0dp"
            android:layout_height="50dp"
            android:layout_marginTop="20dp"
            android:padding="5dp"
            android:layout_marginStart="15dp"
            android:layout_marginEnd="15dp"
            android:drawableStart="@drawable/icon_search"
            android:drawableTint="@color/gray"
            android:drawablePadding="@dimen/_10sdp"
            android:imeOptions="actionDone"
            android:hint="@string/search_by_doctor_name"
            android:inputType="text"
            android:textSize="@dimen/_12sdp"
            android:background="@drawable/more_cards_background"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/layout_Choose_analysis"
            app:layout_constraintEnd_toEndOf="parent"
            />

        <androidx.constraintlayout.widget.ConstraintLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:layout_constraintTop_toBottomOf="@+id/et_search"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                android:layout_marginTop="10dp"
                android:layout_marginBottom="10dp"
                >

            <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/rv_analysis"
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/_400sdp"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"
                    android:layout_margin="15dp"
                    android:paddingBottom="30dp"
                    tools:listitem="@layout/item_layout_analysis"
                    app:layout_constraintTop_toTopOf="parent"
                    app:layout_constraintBottom_toBottomOf="parent"

                    />

            <ProgressBar
                    android:id="@+id/analysisprogress_bar"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    app:layout_constraintEnd_toEndOf="@+id/rv_analysis"
                    app:layout_constraintStart_toStartOf="@+id/rv_analysis"
                    app:layout_constraintBottom_toBottomOf="@+id/rv_analysis"
                    app:layout_constraintTop_toTopOf="@+id/rv_analysis"
                    android:visibility="gone" />

        </androidx.constraintlayout.widget.ConstraintLayout>
    <androidx.appcompat.widget.AppCompatTextView
            android:id="@+id/tv_Or"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="15dp"
            android:layout_marginTop="20dp"
            android:fontFamily="@font/avenirltstd_black"
            android:text="@string/or"
            android:visibility="visible"
            android:textColor="@color/blue"
            android:textSize="20sp"
            android:padding="@dimen/_5sdp"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/et_search" />

    <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/layout_Location_Details"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:visibility="visible"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/layout_Choose_Specialization">

        <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/btn_layout_Choose_City"
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:background="@android:color/transparent"
                app:layout_constraintEnd_toEndOf="@+id/layout_Choose_City"
                app:layout_constraintStart_toStartOf="@+id/layout_Choose_City"
                app:layout_constraintTop_toTopOf="@+id/layout_Choose_City"
                app:layout_constraintBottom_toBottomOf="@+id/layout_Choose_City" />

        <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/btn_layout_Choose_Area"
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:background="@android:color/transparent"
                app:layout_constraintEnd_toEndOf="@+id/layout_Choose_Area"
                app:layout_constraintStart_toStartOf="@+id/layout_Choose_Area"
                app:layout_constraintTop_toTopOf="@+id/layout_Choose_Area"
                app:layout_constraintBottom_toBottomOf="@+id/layout_Choose_Area" />

        <androidx.constraintlayout.widget.ConstraintLayout
                android:id="@+id/layout_Choose_City"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="15dp"
                android:layout_marginTop="12dp"
                android:layout_marginEnd="15dp"
                android:background="@drawable/bg_edittext"
                android:elevation="1dp"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent">

            <androidx.appcompat.widget.AppCompatImageView
                    android:id="@+id/iv_arrowdownChoose_City"
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:layout_gravity="center_horizontal"
                    android:layout_marginEnd="12dp"
                    android:layout_marginBottom="12dp"
                    android:gravity="start"
                    android:src="@drawable/ic_arrowdwon"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintEnd_toEndOf="parent" />

            <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/textinput_Choose_City"
                    style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                    android:layout_width="match_parent"
                    android:layout_height="55dp"
                    android:layout_marginEnd="25dp"
                    android:layout_marginBottom="5dp"
                    android:hint="@string/choose_city"
                    android:paddingTop="4dp"
                    app:boxBackgroundColor="@color/white"
                    app:boxBackgroundMode="none"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent">

                <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/et_Choose_City"
                        android:layout_width="match_parent"
                        android:layout_height="55dp"
                        android:layout_gravity="center_horizontal"
                        android:fontFamily="@font/avenirltstd_roman"
                        android:inputType="text"
                        android:enabled="false"
                        android:textColor="@color/black"
                        android:textSize="13sp" />

            </com.google.android.material.textfield.TextInputLayout>

        </androidx.constraintlayout.widget.ConstraintLayout>
        <androidx.appcompat.widget.AppCompatTextView
                android:id="@+id/tv_cityError"
                android:layout_width="wrap_content"
                android:layout_height="20dp"
                android:layout_marginTop="5dp"
                android:layout_marginBottom="5dp"
                android:layout_marginStart="15dp"
                android:fontFamily="@font/avenirltstd_roman"
                android:gravity="center"
                android:padding="1dp"
                android:text="55555"
                android:textColor="@color/red"
                android:textSize="12sp"
                android:visibility="gone"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintBottom_toTopOf="@+id/layout_Choose_Area"
                app:layout_constraintTop_toBottomOf="@+id/layout_Choose_City" />

        <androidx.constraintlayout.widget.ConstraintLayout
                android:id="@+id/layout_Choose_Area"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="15dp"
                android:layout_marginTop="12dp"
                android:layout_marginEnd="15dp"
                android:layout_marginBottom="10dp"
                android:background="@drawable/bg_edittext"
                android:elevation="1dp"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/layout_Choose_City">

            <androidx.appcompat.widget.AppCompatImageView
                    android:id="@+id/iv_arrowdownArea"
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:layout_gravity="center_horizontal"
                    android:layout_marginEnd="12dp"
                    android:layout_marginBottom="12dp"
                    android:gravity="start"
                    android:src="@drawable/ic_arrowdwon"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintEnd_toEndOf="parent" />

            <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/textinput_Choose_Area"
                    style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                    android:layout_width="match_parent"
                    android:layout_height="55dp"
                    android:layout_marginEnd="25dp"
                    android:layout_marginBottom="5dp"
                    android:hint="@string/choose_area"
                    android:paddingTop="4dp"
                    app:boxBackgroundColor="@color/white"
                    app:boxBackgroundMode="none"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent">

                <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/et_Choose_Area"
                        android:layout_width="match_parent"
                        android:layout_height="55dp"
                        android:layout_gravity="center_horizontal"
                        android:fontFamily="@font/avenirltstd_roman"
                        android:inputType="text"
                        android:enabled="false"
                        android:textColor="@color/black"
                        android:textSize="13sp" />

            </com.google.android.material.textfield.TextInputLayout>

        </androidx.constraintlayout.widget.ConstraintLayout>
        <androidx.appcompat.widget.AppCompatTextView
                android:id="@+id/tv_areaError"
                android:layout_width="wrap_content"
                android:layout_height="20dp"
                android:layout_marginTop="5dp"
                android:layout_marginBottom="5dp"
                android:layout_marginStart="15dp"
                android:fontFamily="@font/avenirltstd_roman"
                android:gravity="center"
                android:padding="1dp"
                android:text="55555"
                android:textColor="@color/red"
                android:textSize="12sp"
                android:visibility="gone"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/layout_Choose_Area" />


    </androidx.constraintlayout.widget.ConstraintLayout>

    <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/btn_layout_ChooseClinic"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:background="@android:color/transparent"
            app:layout_constraintEnd_toEndOf="@+id/layout_Choose_analysis"
            app:layout_constraintStart_toStartOf="@+id/layout_Choose_analysis"
            app:layout_constraintTop_toTopOf="@+id/layout_Choose_analysis"
            app:layout_constraintBottom_toBottomOf="@+id/layout_Choose_analysis"
            />


    <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/btn_layout_Choose_Specialization"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:background="@android:color/transparent"
            app:layout_constraintEnd_toEndOf="@+id/layout_Choose_Specialization"
            app:layout_constraintStart_toStartOf="@+id/layout_Choose_Specialization"
            app:layout_constraintTop_toTopOf="@+id/layout_Choose_Specialization"
            app:layout_constraintBottom_toBottomOf="@+id/layout_Choose_Specialization"
            />

    <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/layout_Choose_Specialization"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="15dp"
            android:layout_marginTop="12dp"
            android:layout_marginEnd="15dp"
            android:background="@drawable/bg_edittext"
            android:elevation="1dp"
            android:visibility="gone"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/tv_Or"

            >

        <androidx.appcompat.widget.AppCompatImageView
                android:id="@+id/iv_arrowdown"
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:layout_gravity="center_horizontal"
                android:layout_marginEnd="12dp"
                android:layout_marginBottom="12dp"
                android:gravity="start"
                android:src="@drawable/ic_arrowdwon"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"/>

        <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/textinput_Specialization"
                style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                android:layout_width="match_parent"
                android:layout_height="55dp"
                android:layout_marginEnd="25dp"
                android:layout_marginBottom="5dp"
                android:hint="@string/choose_specialization"
                android:paddingTop="2dp"
                app:boxBackgroundColor="@color/white"
                app:boxBackgroundMode="none"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent">

            <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/et_Specialization"
                    android:layout_width="match_parent"
                    android:layout_height="55dp"
                    android:layout_gravity="center_horizontal"
                    android:fontFamily="@font/avenirltstd_roman"
                    android:inputType="text"
                    android:enabled="false"
                    android:textColor="@color/black"
                    android:textSize="12sp"/>

        </com.google.android.material.textfield.TextInputLayout>


    </androidx.constraintlayout.widget.ConstraintLayout>
    <androidx.appcompat.widget.AppCompatTextView
            android:id="@+id/tv_SpecializationError"
            android:layout_width="wrap_content"
            android:layout_height="20dp"
            android:layout_marginTop="5dp"
            android:layout_marginBottom="5dp"
            android:layout_marginStart="15dp"
            android:fontFamily="@font/avenirltstd_roman"
            android:gravity="center"
            android:padding="1dp"
            android:text="55555"
            android:textColor="@color/red"
            android:textSize="12sp"
            android:visibility="gone"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/layout_Choose_Specialization" />

    <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/layout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="30dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintWidth_percent=".9"
            android:padding="8dp"
            >
        <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/btn_send"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_chooselang_button"
                android:fontFamily="@font/avenirltstd_black"
                android:padding="5dp"
                android:text="@string/chooses"
                android:textAllCaps="false"
                android:textColor="@color/white"
                android:textSize="14sp"
                android:layout_marginStart="15dp"
                android:layout_marginEnd="15dp"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"

                />
    </androidx.constraintlayout.widget.ConstraintLayout>
        <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rv_Labs_Specilaist"
                android:layout_width="0dp"
                android:layout_height="@dimen/_110sdp"
                app:layout_constraintStart_toStartOf="parent"
                android:layout_margin="5dp"
                android:padding="2dp"
                android:visibility="gone"
                android:orientation="horizontal"
                app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"
                tools:listitem="@layout/item_layout_top_speciality"
                app:layout_constraintTop_toBottomOf="@+id/tv_adds"
                app:layout_constraintEnd_toEndOf="parent"
                />

    <androidx.appcompat.widget.AppCompatTextView
            android:id="@+id/tv_adds"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:fontFamily="@font/avenirltstd_black"
            android:gravity="start"
            android:padding="2dp"
            android:visibility="gone"
            android:layout_marginTop="20dp"
            android:layout_marginStart="15dp"
            android:text="@string/adds"
            android:textColor="@color/black"
            android:textSize="15sp"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/layout"
            />
        <androidx.appcompat.widget.AppCompatTextView
                android:id="@+id/see_All"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:fontFamily="@font/avenirltstd_black"
                android:gravity="start"
                android:padding="2dp"
                android:layout_marginTop="20dp"
                android:layout_marginEnd="@dimen/_15sdp"
                android:text="@string/see_all"
                android:textColor="@color/green"
                android:textSize="15sp"
                android:visibility="gone"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/layout"
                />

        <View
            android:id="@+id/view"
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginTop="3dp"
            android:layout_marginStart="@dimen/_15sdp"
            android:layout_marginEnd="@dimen/_15sdp"
            android:background="@color/gray"
                android:visibility="gone"
           app:layout_constraintTop_toBottomOf="@+id/tv_adds"
        />

    <ImageView
            android:id="@+id/imageAdds"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:src="@drawable/add"
            android:adjustViewBounds="true"
            android:layout_marginTop="@dimen/_8sdp"
            android:layout_marginStart="18dp"
            android:layout_marginEnd="18dp"
            android:elevation="@dimen/_5sdp"
            android:visibility="gone"
            app:layout_constraintEnd_toEndOf="parent"
           app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/view"
            />



    <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rv_specialist"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_marginTop="10dp"
            android:layout_marginBottom="10dp"
            android:padding="3dp"
            android:scrollbars="vertical"
            android:visibility="gone"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/tv_search"
            tools:listitem="@layout/item_layout_new_specialicty" />

    <ProgressBar
            android:id="@+id/progress_bar"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:progressTint="@color/blue"
            android:visibility="gone"
            android:indeterminateTint="@color/blue"
            app:layout_constraintBottom_toBottomOf="@+id/rv_specialist"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="@+id/rv_specialist" />
    </androidx.constraintlayout.widget.ConstraintLayout>
    <include
            android:id="@+id/layoutBottomsheetpersistant"
            layout="@layout/layout_bottomsheet_analysis"
            android:visibility="gone"
            />

</androidx.coordinatorlayout.widget.CoordinatorLayout>