<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
        xmlns:app="http://schemas.android.com/apk/res-auto">

    <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

        <androidx.cardview.widget.CardView
                android:id="@+id/cardview"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardCornerRadius="10dp"
                app:cardUseCompatPadding="true"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent">

            <androidx.constraintlayout.widget.ConstraintLayout
                    android:id="@+id/layput_services"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:padding="3dp">

                <androidx.constraintlayout.widget.ConstraintLayout
                        android:id="@+id/layout_doctorsDetail"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        android:layout_marginEnd="10dp"
                        android:layout_marginStart="10dp"
                        android:padding="@dimen/_5sdp"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toTopOf="parent">

                    <com.google.android.material.imageview.ShapeableImageView
                            android:id="@+id/iv_doctorProfile"
                            android:layout_width="25dp"
                            android:layout_height="25dp"
                            android:visibility="gone"
                            android:src="@drawable/care"
                            android:layout_marginTop="10dp"
                            android:layout_marginEnd="5dp"
                            app:layout_constraintStart_toStartOf="parent"
                            app:layout_constraintTop_toBottomOf="@+id/tv_doctorName" />

                    <androidx.appcompat.widget.AppCompatTextView
                            android:id="@+id/tv_patientname"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="10dp"
                            android:fontFamily="@font/sf_pro_display_semibold"
                            android:gravity="start"
                            android:text="osama"
                            android:textColor="@color/black"
                            android:textSize="15sp"
                            app:layout_constraintStart_toStartOf="parent"
                            app:layout_constraintTop_toTopOf="parent"

                            />

                    <androidx.appcompat.widget.AppCompatTextView
                            android:id="@+id/tv_doctorName"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="5dp"
                            android:fontFamily="@font/avenirltstd_roman"
                            android:gravity="start"
                            android:text=""
                            android:visibility="gone"
                            android:textColor="@color/black"
                            android:textSize="15sp"
                            android:layout_marginTop="10dp"
                            app:layout_constraintStart_toStartOf="parent"
                            app:layout_constraintTop_toBottomOf="@+id/tv_patientname" />

                    <androidx.appcompat.widget.AppCompatTextView
                            android:id="@+id/tv_specialistName"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="10dp"
                            android:fontFamily="@font/sf_pro_display_semibold"
                            android:gravity="start"
                            android:text=""
                            android:visibility="visible"
                            android:textColor="@color/black"
                            android:textSize="16sp"
                            android:layout_marginTop="10dp"
                            app:layout_constraintStart_toEndOf="@+id/iv_doctorProfile"
                            app:layout_constraintTop_toBottomOf="@+id/tv_doctorName" />

                    <View
                            android:id="@+id/view"
                            android:layout_width="match_parent"
                            android:layout_height="1dp"
                            android:layout_marginStart="@dimen/_7sdp"
                            android:layout_marginEnd="@dimen/_7sdp"
                            android:layout_marginTop="@dimen/_6sdp"
                            android:background="@color/gray_color"
                            app:layout_constraintTop_toBottomOf="@+id/tv_specialistName" />


                    <androidx.appcompat.widget.AppCompatTextView
                            android:id="@+id/tv_questions"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="5dp"
                            android:layout_marginTop="10dp"
                            android:visibility="visible"
                            android:fontFamily="@font/sf_pro_display_semibold"
                            android:gravity="start"
                            android:padding="1dp"
                            android:text=""
                            android:textColor="@color/dark_gray"
                            android:textSize="18sp"
                            app:layout_constraintStart_toStartOf="parent"
                            app:layout_constraintEnd_toEndOf="parent"
                            android:layout_marginEnd="@dimen/_10sdp"
                            app:layout_constraintTop_toBottomOf="@+id/view" />

                    <androidx.appcompat.widget.AppCompatTextView
                            android:id="@+id/tv_Age"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="10dp"
                            android:layout_marginTop="5dp"
                            android:fontFamily="@font/avenirltstd_roman"
                            android:gravity="start"
                            android:padding="1dp"
                            android:visibility="gone"
                            android:textColor="@color/black"
                            android:textSize="15sp"
                            app:layout_constraintStart_toStartOf="parent"
                            android:layout_marginEnd="@dimen/_10sdp"
                            app:layout_constraintTop_toBottomOf="@+id/tv_questions" />

                    <androidx.appcompat.widget.AppCompatTextView
                            android:id="@+id/tv_Chronic_disease"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="5dp"
                            android:layout_marginTop="5dp"
                            android:fontFamily="@font/sf_pro_display_semibold"
                            android:gravity="start"
                            android:padding="1dp"
                            android:visibility="gone"
                            android:textColor="@color/black"
                            android:textSize="15sp"
                            app:layout_constraintStart_toStartOf="parent"
                            android:layout_marginEnd="@dimen/_10sdp"
                            app:layout_constraintTop_toBottomOf="@+id/tv_Age" />

                    <androidx.appcompat.widget.AppCompatTextView
                            android:id="@+id/tv_PrevSurgery"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="5dp"
                            android:layout_marginTop="5dp"
                            android:fontFamily="@font/sf_pro_display_semibold"
                            android:gravity="start"
                            android:padding="1dp"
                            android:visibility="gone"
                            android:textColor="@color/black"
                            android:textSize="15sp"
                            app:layout_constraintStart_toStartOf="parent"
                            android:layout_marginEnd="@dimen/_10sdp"
                            app:layout_constraintTop_toBottomOf="@+id/tv_Chronic_disease" />

                    <androidx.appcompat.widget.AppCompatTextView
                            android:id="@+id/tv_date"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="5dp"
                            android:layout_marginTop="10dp"
                            android:fontFamily="@font/sf_pro_display_semibold"
                            android:gravity="start"
                            android:padding="1dp"
                            android:textColor="@color/text_doctor_card_color"
                            android:textSize="12sp"
                            app:layout_constraintEnd_toEndOf="parent"
                            android:layout_marginEnd="@dimen/_5sdp"
                            app:layout_constraintTop_toTopOf="parent" />

                </androidx.constraintlayout.widget.ConstraintLayout>

                <TextView
                        android:id="@+id/tv_Book"
                        android:layout_width="0dp"
                        android:layout_height="45dp"
                        android:gravity="center"
                        android:padding="3dp"
                        android:layout_marginEnd="@dimen/_5sdp"
                        android:layout_marginStart="10dp"
                        android:layout_marginBottom="@dimen/_5sdp"
                        android:background="@drawable/bg_button_sellector"
                        android:textSize="12sp"
                        android:layout_marginTop="@dimen/_5sdp"
                        android:text="@string/showanswers"
                        android:textColor="@color/white"
                        app:layout_constraintBottom_toBottomOf="parent"
                        app:layout_constraintTop_toBottomOf="@+id/layout_doctorsDetail"
                        app:layout_constraintEnd_toStartOf="@+id/btn_more"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintHorizontal_chainStyle="spread_inside" />

                <androidx.appcompat.widget.AppCompatButton
                        android:id="@+id/btn_more"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:background="@drawable/bg_button_aboutdoctor"
                        android:fontFamily="@font/sf_pro_display_semibold"
                        android:text="@string/about_doctor"
                        android:layout_marginStart="@dimen/_3sdp"
                        android:textColor="@color/blue"
                        android:textSize="14sp"
                        android:padding="3dp"
                        android:layout_marginEnd="10dp"
                        android:textAllCaps="false"
                        app:layout_constraintBottom_toBottomOf="parent"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintStart_toEndOf="@+id/tv_Book"
                        app:layout_constraintTop_toBottomOf="@+id/layout_doctorsDetail" />

            </androidx.constraintlayout.widget.ConstraintLayout>
        </androidx.cardview.widget.CardView>


    </androidx.constraintlayout.widget.ConstraintLayout>

</layout>